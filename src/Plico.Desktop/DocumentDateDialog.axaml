<Window xmlns="https://github.com/avaloniaui"
        xmlns:translation="using:Plico.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Plico.Desktop.DocumentDateDialog" Title="{translation:Tr DocumentDate}" Width="460" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner" Classes="dialog">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button x:Name="ClearDocumentDatesButton" Classes="secondary" Content="{translation:Tr ClearDates}"
                        IsVisible="False" Click="Clear_Click" />
                <StackPanel Grid.Column="2" Classes="dialog-actions">
                    <Button x:Name="CancelDocumentDateButton" Classes="secondary" Content="{translation:Tr Cancel}" IsCancel="True" Click="Cancel_Click" />
                    <Button x:Name="ConfirmDocumentDateButton" Classes="primary" Content="{translation:Tr SaveDate}" IsDefault="True" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Classes="dialog-body">
            <TextBlock x:Name="DocumentDatePrompt" Classes="heading" Text="{translation:Tr DocumentDate}" TextWrapping="Wrap" />
            <StackPanel Classes="field">
                <TextBox x:Name="DocumentDateBox" PlaceholderText="YYYY-MM-DD" AutomationProperties.Name="{translation:Tr DocumentDate}" />
                <TextBlock x:Name="DocumentDateHint" Classes="hint" Text="{translation:Tr UseYYYYMMDDLeaveBlankToClearTheDate}" />
            </StackPanel>
            <TextBlock x:Name="DateValidation" Classes="validation" IsVisible="False" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </DockPanel>
</Window>
