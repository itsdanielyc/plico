<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Plico.Desktop" x:Class="Plico.Desktop.OcrCopyResultsDialog"
        Title="OCR results" Width="640" Height="402" MinWidth="420" MinHeight="290"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource InterFont}" Background="#F4F5EF">
    <Grid Margin="23" RowDefinitions="*,Auto" RowSpacing="14">
        <ListBox x:Name="OcrResultsList" Background="#FCFDF8" BorderBrush="#DDE2D7" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="OCR results for selected PDFs">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="12" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:OcrCopyBatchItem">
                    <Grid ColumnDefinitions="2*,3*" ColumnSpacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding SourceTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SourcePath}" Foreground="#5C685D" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{Binding OutcomeLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Foreground="#5C685D" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Row="1" Content="Close" IsCancel="True" Click="Close_Click" Padding="13,7" HorizontalAlignment="Right" />
    </Grid>
</Window>
