<Window xmlns="https://github.com/avaloniaui"
        xmlns:translation="using:Plico.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Plico.Core" x:Class="Plico.Desktop.TrashDialog"
        Title="{translation:Tr Trash}" Width="520" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner"
        Classes="dialog">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button x:Name="PurgeTrashButton" Classes="danger" Content="{translation:Tr DeletePermanently}" IsEnabled="False" Click="Purge_Click" />
                <StackPanel Grid.Column="2" Classes="dialog-actions">
                    <Button x:Name="RestoreTrashButton" Classes="secondary" Content="{translation:Tr Restore}" IsEnabled="False" Click="Restore_Click" />
                    <Button x:Name="CloseTrashButton" Classes="primary" Content="{translation:Tr Close}" IsCancel="True" IsDefault="True" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Classes="dialog-body">
            <StackPanel Spacing="4">
                <TextBlock Classes="heading" Text="{translation:Tr Trash}" />
                <TextBlock x:Name="TrashMessage" Classes="description" />
            </StackPanel>
            <ListBox x:Name="TrashedFiles" Classes="plain framed" AutomationProperties.Name="{translation:Tr PDFsInTrash}" MaxHeight="280"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Selection_Changed">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="core:TrashedDocument">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                            <TextBlock Classes="caption" Text="{Binding OriginalPath}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </DockPanel>
</Window>
