<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Plico.Desktop"
        xmlns:core="using:Plico.Core"
        x:Class="Plico.Desktop.MainWindow" x:DataType="local:InboxViewModel"
        Title="Plico" Width="1180" Height="760" MinWidth="900" MinHeight="590"
        FontFamily="{StaticResource InterFont}" Foreground="#1F3027" Background="#F4F5EF"
        DragDrop.AllowDrop="True" DragDrop.DragEnter="Files_DragOver" DragDrop.DragOver="Files_DragOver"
        DragDrop.DragLeave="Files_DragLeave" DragDrop.Drop="Files_Dropped"
        WindowStartupLocation="CenterScreen">
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#254C37" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#346449" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#EFF2E9" />
            <Setter Property="Foreground" Value="#284838" />
            <Setter Property="BorderBrush" Value="#D4DED2" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E2ECD6" />
            <Setter Property="Foreground" Value="#223E30" />
        </Style>
        <Style Selector="Button.rail">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D1DFD3" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.rail:pointerover /template/ ContentPresenter, Button.rail.current /template/ ContentPresenter">
            <Setter Property="Background" Value="#344E42" />
            <Setter Property="Foreground" Value="#F9FBF5" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#5C685D" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="AutoCompleteBox.tag-entry">
            <Setter Property="FilterMode" Value="None" />
            <Setter Property="MaxLength" Value="48" />
            <Setter Property="MaxDropDownHeight" Value="196" />
        </Style>
        <Style Selector="AutoCompleteBox.tag-entry /template/ Popup#PART_Popup">
            <Setter Property="ShouldUseOverlayLayer" Value="True" />
            <Setter Property="OverlayDismissEventPassThrough" Value="True" />
        </Style>
        <Style Selector="Button.document-location">
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.document-location:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#EAF0E5" />
        </Style>
        <Style Selector="ScrollViewer.pdf-preview">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="ScrollViewer.pdf-preview.fitWidth">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="204,*">
        <Border Background="#1B302B" Padding="17,21,17,16">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="25">
                <StackPanel Orientation="Horizontal" Spacing="11" Margin="5,0">
                    <Border Width="34" Height="34" Background="#CBDFA9" CornerRadius="9">
                        <PathIcon Width="20" Height="20" Foreground="#254333"
                                  Data="M4,3 L13,3 L19,9 L19,21 L4,21 Z M13,3 L13,9 L19,9 M7,13 L16,13 M7,17 L16,17" />
                    </Border>
                    <TextBlock Text="Plico" FontSize="23" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="3">
                    <Button x:Name="InboxButton" Classes="rail" Classes.current="{Binding InboxSelected}"
                            Command="{Binding ShowInboxCommand}" HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="{Binding InboxAutomationName}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="Inbox" />
                            <TextBlock Grid.Column="1" x:Name="InboxReviewCount" Text="{Binding InboxCount}" IsVisible="{Binding HasInboxCount}"
                                       Foreground="#B9CCBE" />
                        </Grid>
                    </Button>
                    <Button x:Name="AllDocumentsButton" Classes="rail" Classes.current="{Binding AllSelected}"
                            Command="{Binding ShowAllCommand}" Content="All documents" />
                    <Button x:Name="WithoutTextButton" Classes="rail" Classes.current="{Binding WithoutTextSelected}"
                            Command="{Binding ShowWithoutTextCommand}" Content="Without text"
                            ToolTip.Tip="Find PDFs without searchable text" />
                </StackPanel>
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6" IsVisible="{Binding HasSavedSearches}">
                            <TextBlock Text="Saved searches" Foreground="#ACC2B4" FontSize="12" FontWeight="SemiBold" Margin="12,0,0,0" />
                            <ItemsControl x:Name="SavedSearchList" ItemsSource="{Binding SavedSearches}" IsEnabled="{Binding CanWork}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:SavedSearch">
                                        <Button Classes="rail" Click="OpenSavedSearch_Click" ToolTip.Tip="{Binding Query}"
                                                AutomationProperties.Name="{Binding Name}">
                                            <TextBlock Text="{Binding Name}" MaxWidth="138" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Spacing="6" IsVisible="{Binding HasTags}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Tags" Foreground="#ACC2B4" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                <Button Grid.Column="1" x:Name="RenameActiveTagButton" Classes="rail" Content="Rename…"
                                        Padding="7,3" IsVisible="{Binding HasActiveTag}" IsEnabled="{Binding CanWork}"
                                        Command="{Binding RenameActiveTagCommand}" AutomationProperties.Name="Rename selected tag" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button Classes="rail" Click="FilterTag_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="9">
                                                <Ellipse Width="6" Height="6" Fill="#C5DDA6" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding}" MaxWidth="130" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="3" Spacing="3">
                    <TextBlock Text="Library" Foreground="#ACC2B4" FontSize="12" FontWeight="SemiBold" Margin="12,0,0,3" />
                    <Button Classes="rail" Command="{Binding ChooseLibraryCommand}" IsEnabled="{Binding IsIdle}"
                            ToolTip.Tip="{Binding LibraryPath}" AutomationProperties.Name="Choose library folder">
                        <TextBlock Text="{Binding LibraryName}" MaxWidth="142" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                    </Button>
                    <Button Classes="rail" Content="Show PDF folder" Command="{Binding OpenPdfFolderCommand}" IsEnabled="{Binding HasLibrary}" />
                    <Button Classes="rail" Content="Refresh index" Command="{Binding RefreshIndexCommand}" IsEnabled="{Binding CanWork}" />
                    <Button x:Name="BackUpLibraryButton" Classes="rail" Content="Back up library…"
                            Command="{Binding BackUpLibraryCommand}" IsEnabled="{Binding CanWork}" />
                    <Button x:Name="StartFolderWatchButton" Classes="rail" Content="Watch a folder…"
                            Command="{Binding StartFolderWatchCommand}" IsVisible="{Binding !IsWatchingFolder}"
                            IsEnabled="{Binding CanStartFolderWatch}" />
                    <Button x:Name="ResumeFolderWatchButton" Classes="rail" Content="Resume folder watch"
                            Command="{Binding ResumeFolderWatchCommand}" IsVisible="{Binding CanOfferResumeFolderWatch}"
                            IsEnabled="{Binding CanWork}" ToolTip.Tip="{Binding RememberedWatchFolder}" />
                    <TextBlock IsVisible="{Binding IsWatchingFolder}" Text="{Binding WatchedFolderName, StringFormat='Watching {0}'}"
                               ToolTip.Tip="{Binding WatchedFolderPath}" TextTrimming="CharacterEllipsis"
                               Foreground="#CADDCA" FontSize="12" Margin="12,7,0,0" />
                    <Button x:Name="ImportWatchFolderFilesButton" Classes="rail" Content="Import existing files"
                            Command="{Binding ImportWatchFolderFilesCommand}" IsVisible="{Binding IsWatchingFolder}"
                            IsEnabled="{Binding CanWork}" />
                    <Button x:Name="StopFolderWatchButton" Classes="rail" Content="Stop watching"
                            Command="{Binding StopFolderWatchCommand}" IsVisible="{Binding IsWatchingFolder}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
            <Border Background="#FCFDF8" BorderBrush="#DDE2D7" BorderThickness="0,0,0,1" Padding="25,16">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                    <TextBox x:Name="SearchBox" Text="{Binding Query, Mode=TwoWay}" MaxLength="256"
                             PlaceholderText="Search text, status:…, tag:…, dated:…" AutomationProperties.Name="Search documents"
                             ToolTip.Tip="Use status:inbox for the review queue or status:reviewed for reviewed PDFs.&#10;Use text:missing or text:present to filter by searchable text.&#10;dated:2024-02 matches the document date. added:2026-11 matches the date added.&#10;Use tag:tax, folder:&quot;Filed/Property&quot;, and quoted phrases in the same query."
                             VerticalContentAlignment="Center" CornerRadius="8" MinHeight="38">
                        <TextBox.InnerLeftContent>
                            <PathIcon Width="15" Height="15" Margin="11,0,1,0" Foreground="#536459"
                                      Data="M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 M10,4 A6,6 0 1 1 10,16 A6,6 0 1 1 10,4 M15,16 L21,22 L23,20 L17,14 Z" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="OCR" Classes="muted" VerticalAlignment="Center" />
                        <ComboBox x:Name="OcrLanguageBox" ItemsSource="{Binding RecognitionLanguages}"
                                  SelectedItem="{Binding RecognitionLanguage, Mode=TwoWay}" MinWidth="96" MinHeight="38"
                                  IsEnabled="{Binding IsIdle}" AutomationProperties.Name="OCR language" />
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="ScanButton" Classes="secondary" Command="{Binding ScanCommand}"
                            Content="Scan" IsEnabled="{Binding CanWork}" MinHeight="38" />
                    <Button Grid.Column="3" x:Name="AddFilesButton" Classes="primary"
                            IsEnabled="{Binding CanWork}" Command="{Binding AddFilesCommand}" Content="Add files" MinHeight="38" />
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="25,21,25,20" RowDefinitions="Auto,*" RowSpacing="16">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                    <TextBlock x:Name="InboxHeading" Text="{Binding Heading}" FontSize="31" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="1" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SaveSearchButton" Classes="secondary" Content="Save search…" Command="{Binding SaveSearchCommand}"
                                IsVisible="{Binding ShowSaveSearch}" IsEnabled="{Binding CanWork}" />
                        <Button x:Name="EditSavedSearchButton" Classes="secondary" Content="Edit search…" Command="{Binding EditActiveSavedSearchCommand}"
                                IsVisible="{Binding HasActiveSavedSearch}" IsEnabled="{Binding CanWork}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Classes="muted" Text="{Binding ResultCount}" VerticalAlignment="Center"
                               MaxWidth="154" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ResultCount}" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Sort" Classes="muted" VerticalAlignment="Center" />
                        <ComboBox x:Name="DocumentSortBox" ItemsSource="{Binding SortChoices}"
                                  SelectedItem="{Binding SortOption, Mode=TwoWay}" MinWidth="140"
                                  IsEnabled="{Binding HasLibrary}" AutomationProperties.Name="Sort documents" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="2*,3*" ColumnSpacing="15">
                    <Border CornerRadius="11" Background="#FCFDF8" BorderBrush="#DDE2D7" BorderThickness="1" ClipToBounds="True">
                        <Grid RowDefinitions="*,Auto">
                            <TextBlock x:Name="EmptyResultsMessage" Text="{Binding EmptyMessage}" IsVisible="{Binding !HasDocuments}"
                                       Foreground="#556358" MaxWidth="220" TextAlignment="Center" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"
                                       AutomationProperties.LiveSetting="Polite" />
                            <ListBox x:Name="DocumentList" ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                                     IsVisible="{Binding HasDocuments}" Background="Transparent" Padding="4"
                                     SelectionMode="Multiple" SelectionChanged="Documents_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Documents">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="13,11" />
                                        <Setter Property="Margin" Value="1,2" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#E4EEDD" />
                                        <Setter Property="Foreground" Value="#1F3027" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="core:DocumentSummary">
                                        <Grid ColumnDefinitions="34,*" ColumnSpacing="11">
                                            <Border Background="#EDF2E8" Height="39" CornerRadius="6" VerticalAlignment="Top">
                                                <TextBlock Text="PDF" Foreground="#30543E" FontWeight="Bold" FontSize="9"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <WrapPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DocumentDate, StringFormat='Dated {0:dd MMM yyyy}'}" Classes="muted"
                                                               IsVisible="{Binding HasDocumentDate}" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding AddedAt.LocalDateTime, StringFormat='Added {0:dd MMM yyyy}'}" Classes="muted" />
                                                </WrapPanel>
                                                <TextBlock Text="{Binding Match}" Classes="muted" TextWrapping="Wrap"
                                                           MaxLines="2" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="1" Margin="8" Spacing="6" IsVisible="{Binding HasResultActions}">
                                <Button x:Name="RefreshWatchedResultsButton" Classes="secondary" Content="Refresh results"
                                        Command="{Binding RefreshWatchedResultsCommand}" IsVisible="{Binding HasDeferredWatchResults}"
                                        IsEnabled="{Binding CanWork}" ToolTip.Tip="Refresh after watched imports" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasBatchCandidates}">
                                    <Button x:Name="SelectShownButton" Classes="secondary" Content="{Binding SelectShownAction}"
                                            Click="SelectShown_Click" AutomationProperties.Name="{Binding SelectShownAction}" />
                                    <Button Grid.Column="1" Content="Load more" IsVisible="{Binding HasMore}" Command="{Binding LoadMoreCommand}" />
                                </Grid>
                                <Border IsVisible="{Binding HasBatchSelection}" Background="#EAF0E5" CornerRadius="8" Padding="8">
                                    <StackPanel Spacing="7">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <TextBlock Text="{Binding BatchCountLabel}" Classes="muted" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" x:Name="BatchReviewButton" Classes="secondary"
                                                    Content="{Binding BatchReviewAction}" Command="{Binding ReviewSelectedCommand}"
                                                    IsEnabled="{Binding CanWork}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsEnabled="{Binding CanWork}">
                                            <AutoCompleteBox x:Name="BatchTagBox" Classes="tag-entry" Text="{Binding BatchTagInput, Mode=TwoWay}"
                                                             PlaceholderText="Tag" AutomationProperties.Name="Tag for the selected documents"
                                                             Populating="TagBox_Populating" KeyDown="BatchTag_KeyDown" />
                                            <Button Grid.Column="1" x:Name="ApplyBatchTagButton" Classes="secondary"
                                                    Content="Tag selected" Click="ApplyBatchTag_Click" />
                                        </Grid>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="CreateSelectedOcrCopiesButton" Classes="secondary" Content="Create OCR copies"
                                                    Command="{Binding CreateSelectedOcrCopiesCommand}" IsEnabled="{Binding CanWork}"
                                                    AutomationProperties.Name="Create OCR copies of the selected PDFs" Margin="6,0,0,4" Padding="10,7" />
                                            <Button x:Name="MoveSelectedPdfsButton" Classes="secondary" Content="Move PDFs…"
                                                    Command="{Binding MoveSelectedPdfsCommand}" IsEnabled="{Binding CanWork}"
                                                    AutomationProperties.Name="Move selected PDFs to a folder" Margin="6,0,0,4" Padding="10,7" />
                                            <Button x:Name="CombinePdfsButton" Classes="secondary" Content="Combine PDFs…"
                                                    Command="{Binding CombinePdfsCommand}" IsEnabled="{Binding CanWork}"
                                                    Margin="6,0,0,4" Padding="10,7" />
                                            <Button x:Name="ExportSelectedPdfsButton" Classes="secondary"
                                                    Content="Export PDFs…" Command="{Binding ExportSelectedPdfsCommand}"
                                                    IsEnabled="{Binding CanWork}" AutomationProperties.Name="Export selected PDFs"
                                                    Margin="6,0,0,4" Padding="10,7" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" CornerRadius="11" Background="#FCFDF8" BorderBrush="#DDE2D7" BorderThickness="1" ClipToBounds="True">
                        <Panel>
                            <TextBlock Text="Select a document to preview it" IsVisible="{Binding !HasSelection}"
                                       Foreground="#556358" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Grid IsVisible="{Binding HasSelection}" RowDefinitions="Auto,*,Auto" RowSpacing="11" Margin="15">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding SelectedDocument.Title}" TextTrimming="CharacterEllipsis" FontSize="17" FontWeight="SemiBold" />
                                        <Button x:Name="PdfLocationButton" Classes="document-location" Command="{Binding OpenDocumentFolderCommand}"
                                                ToolTip.Tip="Open containing folder" AutomationProperties.Name="Open PDF's containing folder">
                                            <TextBlock Text="{Binding SelectedDocument.RelativePath}" Foreground="#386447" FontSize="12"
                                                       TextDecorations="Underline" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                        <Button x:Name="EditDocumentDateButton" Classes="document-location" Command="{Binding EditDocumentDateCommand}"
                                                IsEnabled="{Binding CanWork}" ToolTip.Tip="Edit document date" AutomationProperties.Name="Edit document date">
                                            <TextBlock Text="{Binding DocumentDateAction}" Foreground="#386447" FontSize="12"
                                                       TextDecorations="Underline" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Button x:Name="EditTitleButton" Classes="secondary" Content="Edit title" Command="{Binding EditDocumentTitleCommand}"
                                                    IsEnabled="{Binding CanWork}" />
                                            <Button Classes="secondary" Content="Open PDF" Command="{Binding OpenPdfCommand}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5"
                                                    IsVisible="{Binding HasPageMatchAction}">
                                            <Button x:Name="PreviousMatchButton" Classes="secondary" Content="Previous match"
                                                    Padding="8,3" Command="{Binding PreviousMatchCommand}"
                                                    IsVisible="{Binding PageMatchNavigationActive}" IsEnabled="{Binding CanWork}"
                                                    ToolTip.Tip="Go to the previous page that matches the text terms" />
                                            <Button x:Name="GoToMatchButton" Classes="secondary" Content="{Binding PageMatchActionLabel}"
                                                    Padding="8,3" Command="{Binding GoToMatchCommand}"
                                                    IsVisible="{Binding HasPageMatchAction}" IsEnabled="{Binding CanWork}"
                                                    ToolTip.Tip="{Binding PageMatchActionHelp}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Background="#EAEFE6" CornerRadius="8" Padding="12" ClipToBounds="True">
                                    <Grid RowDefinitions="*,Auto" RowSpacing="7">
                                        <ScrollViewer x:Name="PreviewScroll" Classes="pdf-preview" Classes.fitWidth="{Binding FitPreviewWidth}"
                                                      Focusable="{Binding FitPreviewWidth}" IsVisible="{Binding !IsPageTextView}"
                                                      AutomationProperties.Name="PDF page preview">
                                            <Image x:Name="PreviewPage" Source="{Binding Preview}" Stretch="Uniform" />
                                        </ScrollViewer>
                                        <ScrollViewer x:Name="PageTextScroll" IsVisible="{Binding HasPageText}"
                                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                            <SelectableTextBlock x:Name="PageTextContent" Text="{Binding PageText}" TextWrapping="Wrap"
                                                                 Padding="12,8" FontSize="15" LineHeight="22" Focusable="True" />
                                        </ScrollViewer>
                                        <TextBlock Text="{Binding PreviewMessage}" IsVisible="{Binding HasPreviewMessage}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Polite" />
                                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                                            <Button x:Name="CopyDocumentTextButton" Classes="secondary" HorizontalAlignment="Left"
                                                    Content="Copy text" Command="{Binding CopyDocumentTextCommand}"
                                                    IsVisible="{Binding !HasNoSearchableText}" IsEnabled="{Binding CanWork}" Padding="8,3"
                                                    AutomationProperties.Name="Copy document text" ToolTip.Tip="Copy the searchable text from all pages" />
                                            <Grid Grid.Column="1" x:Name="PreviewPageNavigation" ColumnDefinitions="Auto,*,Auto"
                                                  HorizontalAlignment="Center" ColumnSpacing="4">
                                                <Button Content="‹" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoBack}"
                                                        AutomationProperties.Name="Previous page" Padding="9,3" />
                                                <TextBlock Grid.Column="1" Text="{Binding PageLabel}" Classes="muted" VerticalAlignment="Center"
                                                           TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PageLabel}" />
                                                <Button Grid.Column="2" Content="›" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoForward}"
                                                        AutomationProperties.Name="Next page" Padding="9,3" />
                                            </Grid>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                                <Button x:Name="ReadPageTextButton" Classes="secondary" Content="{Binding PageTextAction}"
                                                        Command="{Binding TogglePageTextCommand}" IsVisible="{Binding !HasNoSearchableText}" Padding="8,3" />
                                                <Button x:Name="PreviewFitButton" Classes="secondary"
                                                        Content="{Binding PreviewFitAction}" Command="{Binding TogglePreviewFitCommand}"
                                                        IsEnabled="{Binding HasPreview}" IsVisible="{Binding !IsPageTextView}" Padding="8,3" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="2" Spacing="8">
                                    <TextBlock Text="No searchable text found" Foreground="#795327" FontSize="12"
                                               TextWrapping="Wrap" IsVisible="{Binding HasNoSearchableText}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <WrapPanel Orientation="Horizontal">
                                            <Button x:Name="MovePdfButton" Classes="secondary" Content="Move to folder…"
                                                    Command="{Binding MovePdfCommand}" IsEnabled="{Binding CanWork}" Margin="0,0,6,4" />
                                            <Button x:Name="ExtractPdfPagesButton" Classes="secondary" Content="Extract pages…"
                                                    Command="{Binding ExtractPdfPagesCommand}" IsEnabled="{Binding CanWork}"
                                                    IsVisible="{Binding HasMultiplePages}" Margin="0,0,6,4" />
                                            <Button x:Name="RotatePdfPagesButton" Classes="secondary" Content="Rotate pages…"
                                                    Command="{Binding RotatePdfPagesCommand}" IsEnabled="{Binding CanWork}" />
                                        </WrapPanel>
                                        <Button Grid.Column="1" x:Name="CreateSearchableCopyButton" Classes="secondary"
                                                Content="{Binding SearchableCopyAction}" Command="{Binding CreateSearchableCopyCommand}"
                                                ToolTip.Tip="Create a separate PDF using the selected OCR language"
                                                IsEnabled="{Binding CanWork}" VerticalAlignment="Top" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding SelectedDocument.Tags}" MaxHeight="67">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Button Click="RemoveTag_Click" Margin="0,0,5,3" Padding="8,4"
                                                        Background="#EAF0E5" MaxWidth="144"
                                                        AutomationProperties.Name="{Binding StringFormat='Remove tag {0}'}">
                                                    <TextBlock Text="{Binding StringFormat='{}{0}  ×'}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" IsEnabled="{Binding CanWork}">
                                        <AutoCompleteBox x:Name="TagBox" Classes="tag-entry" Text="{Binding TagInput, Mode=TwoWay}"
                                                         PlaceholderText="Tag" AutomationProperties.Name="Tag for this document" FontSize="12"
                                                         Populating="TagBox_Populating" KeyDown="TagBox_KeyDown" />
                                        <Button Grid.Column="1" x:Name="AddTagButton" Classes="secondary" Content="Add" Command="{Binding AddTagCommand}"
                                                AutomationProperties.Name="Add tag" />
                                        <Button Grid.Column="2" x:Name="ReviewButton" Classes="secondary" Content="{Binding ReviewAction}" Command="{Binding ToggleReviewCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Panel>
                    </Border>
                </Grid>
            </Grid>
            <Border Grid.Row="2" Padding="25,7" Background="#FCFDF8" BorderBrush="#DDE2D7" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" MinHeight="24">
                    <TextBlock Text="{Binding Status}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
                    <Button Grid.Column="1" x:Name="ImportErrorsButton" Classes="secondary" Content="Import errors"
                            Command="{Binding InspectImportErrorsCommand}" IsVisible="{Binding HasImportFailures}"
                            IsEnabled="{Binding CanWork}" Padding="8,3" />
                    <Button Grid.Column="2" x:Name="OpenBackupFolderButton" Classes="secondary" Content="Open backup"
                            Command="{Binding OpenBackupFolderCommand}" IsVisible="{Binding HasLatestBackup}"
                            IsEnabled="{Binding CanWork}" Padding="8,3" />
                    <Button Grid.Column="3" x:Name="OpenExportFolderButton" Classes="secondary" Content="Open export"
                            Command="{Binding OpenExportFolderCommand}" IsVisible="{Binding HasLatestExport}"
                            IsEnabled="{Binding CanWork}" Padding="8,3" />
                    <Button Grid.Column="4" x:Name="OcrCopyBatchResultsButton" Classes="secondary" Content="OCR results"
                            Command="{Binding InspectOcrCopyBatchResultsCommand}" IsVisible="{Binding HasOcrCopyBatchResults}"
                            IsEnabled="{Binding CanWork}" Padding="8,3" />
                    <Button Grid.Column="5" x:Name="IndexReportButton" Classes="secondary" Content="Index report"
                            Command="{Binding ShowIndexReportCommand}" IsVisible="{Binding ShowIndexReport}" Padding="8,3" />
                    <ProgressBar Grid.Column="6" Width="74" IsIndeterminate="True" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
                    <Button Grid.Column="7" Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" Padding="8,3" />
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Column="1" x:Name="DropTarget" IsVisible="False" IsHitTestVisible="False" Margin="19"
                Background="#E6F0E2" BorderBrush="#5F8A62" BorderThickness="2" CornerRadius="13">
            <TextBlock Text="Drop PDFs or images to add them" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontWeight="SemiBold" FontSize="23" Foreground="#294735" />
        </Border>
    </Grid>
</Window>
