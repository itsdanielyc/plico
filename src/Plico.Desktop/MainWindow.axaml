<Window xmlns="https://github.com/avaloniaui"
        xmlns:translation="using:Plico.Desktop"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Plico.Desktop"
        xmlns:core="using:Plico.Core"
        x:Class="Plico.Desktop.MainWindow" x:DataType="local:InboxViewModel"
        Title="Plico" Width="1280" Height="800" MinWidth="900" MinHeight="590"
        Foreground="{DynamicResource Fg}" Background="{DynamicResource Base}"
        DragDrop.AllowDrop="True" DragDrop.DragEnter="Files_DragOver" DragDrop.DragOver="Files_DragOver"
        DragDrop.DragLeave="Files_DragLeave" DragDrop.Drop="Files_Dropped"
        WindowStartupLocation="CenterScreen">
    <!--
        A grey desk, a white sheet, black ink. The window and the sidebar are the desk (Base). The toolbar, queue, page
        canvas and filing card are one sheet laid on it: inset 6 px from the top, a 12 px top-left corner and a hairline
        edge. Paper is the brightest thing and the only in-flow surface with a shadow.
    -->
    <Window.Styles>
        <!-- Narrow windows: places tighten to 36 px rows. The class rides on the shell grid with "compact". -->
        <Style Selector="Grid.compact Button.nav, Grid.compact Button.rail">
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <!-- Tag rows keep the "rail" class that verification uses to find them, drawn with the nav row's geometry. -->
        <Style Selector="Button.rail">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
        </Style>
        <Style Selector="Button.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Hover}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="Button.rail:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Pressed}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <!-- The library switcher: the graphite app tile, the library's name and a chevrons glyph, in a 44 px row. -->
        <Style Selector="Button.switcher">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="6,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="Button.switcher:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Hover}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="Button.switcher:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Pressed}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="Button.switcher:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- A quiet text action beside a section label, such as Rename for the selected tag. -->
        <Style Selector="Button.subaction">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
        </Style>
        <Style Selector="Button.subaction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Hover}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>

        <!-- Buttons whose plain-text label stays readable while the template adds a 16 px icon. -->
        <Style Selector="Button.with-icon">
            <Setter Property="ContentTemplate">
                <DataTemplate x:DataType="x:String">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <local:Icon Data="{Binding $parent[Button].(local:Ui.Icon)}" StrokeWidth="1.7" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </Setter>
        </Style>
        <!-- Narrow windows give search the room: Scan keeps its glyph and tooltip, the palette stays on Ctrl+K and in ⋯. -->
        <Style Selector="Grid.compact Button#ScanButton">
            <Setter Property="Width" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="ContentTemplate">
                <DataTemplate x:DataType="x:String">
                    <local:Icon Data="{Binding $parent[Button].(local:Ui.Icon)}" StrokeWidth="1.7" VerticalAlignment="Center" />
                </DataTemplate>
            </Setter>
        </Style>
        <Style Selector="Grid.compact Button#CommandPaletteButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- The toolbar's spacing tightens in narrow windows too, so "Chercher dans vos papiers" stays whole beside "/". -->
        <Style Selector="Border#Toolbar">
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style Selector="Grid#ToolbarLayout">
            <Setter Property="ColumnSpacing" Value="12" />
        </Style>
        <Style Selector="StackPanel#ToolbarActions">
            <Setter Property="Spacing" Value="8" />
        </Style>
        <Style Selector="Grid#SearchRow">
            <Setter Property="ColumnSpacing" Value="4" />
        </Style>
        <Style Selector="Grid.compact Grid#SearchRow">
            <Setter Property="ColumnSpacing" Value="2" />
        </Style>
        <Style Selector="Grid.compact Border#Toolbar">
            <Setter Property="Padding" Value="12,12" />
        </Style>
        <Style Selector="Grid.compact Grid#ToolbarLayout">
            <Setter Property="ColumnSpacing" Value="8" />
        </Style>
        <Style Selector="Grid.compact StackPanel#ToolbarActions">
            <Setter Property="Spacing" Value="6" />
        </Style>
        <!-- Card actions: quiet 34 px rows with a 16 px Fg2 glyph and a 14 Medium label in ink. -->
        <Style Selector="Button.action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="ContentTemplate">
                <DataTemplate x:DataType="x:String">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <local:Icon Data="{Binding $parent[Button].(local:Ui.Icon)}" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Hover}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="Button.action:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Pressed}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="Button.action:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FgDisabled}" />
        </Style>

        <!--
            The card's heading is its title's field. At rest it is the 20 px heading with the E keycap and a quiet hover;
            open, it is a text field in the same type at the same place, so the words do not move.
        -->
        <Style Selector="Button.title-edit">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="-8,-4,0,-4" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="Button.title-edit:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Hover}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="Button.title-edit:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Pressed}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <!-- Without a library the title cannot be edited, but it stays ink: it is the document's name, not a control. -->
        <Style Selector="Button.title-edit:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <!--
            Open, the field is 32 px for one line and its words sit exactly where the heading's did: 8 px of it reaches
            left of the card's column for the frame and its padding. It ends at the column's right edge, as the date field
            does, so every field in the card shares one right edge.
        -->
        <Style Selector="TextBox.title-edit">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="7,3,7,2" />
            <Setter Property="Margin" Value="-8,-4,0,-4" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>

        <!--
            The date field reads as a value at rest: no frame, the calendar glyph and the date in tabular figures, its glyph
            and its words in the same columns as the other values' glyphs and words (the field reaches 8 px left of the
            value column for its frame). It is a 32 px control. Hovered it takes the hover fill; focused, the ink border
            and ring every field has.
        -->
        <Style Selector="TextBox.date-field">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="3,0,4,0" />
            <Setter Property="Margin" Value="-8,0,0,0" />
        </Style>
        <Style Selector="TextBox.date-field:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource Hover}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.date-field:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource Panel}" />
        </Style>
        <Style Selector="TextBox.date-field.invalid /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource Err}" />
        </Style>
        <Style Selector="TextBox.date-field:disabled /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <!-- Small glyph buttons inside a field: the calendar, and the clear button of a saved date. -->
        <Style Selector="Button.field-glyph">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.field-glyph:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Pressed}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="Button.field-glyph:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Pressed}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <!--
            The date field's calendar: days in 14 px ink on the popover itself. The chosen day is the family's selected
            state, an ink fill; today, when it is not the chosen day, is only ringed in ink, so an undated document never
            looks dated. The month chevrons are quiet 16 px glyphs in Fg2, like the other glyphs on the card.
        -->
        <Style Selector="Calendar#DocumentDateCalendar CalendarDayButton, Calendar#DocumentDateCalendar CalendarButton">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Calendar#DocumentDateCalendar CalendarDayButton /template/ Border, Calendar#DocumentDateCalendar CalendarButton /template/ Border">
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <Style Selector="Calendar#DocumentDateCalendar CalendarDayButton:today /template/ Border#Root">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Calendar#DocumentDateCalendar CalendarDayButton:today /template/ Border#Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Fg}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Calendar#DocumentDateCalendar CalendarDayButton:today">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="Calendar#DocumentDateCalendar CalendarDayButton:selected /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="Calendar#DocumentDateCalendar CalendarDayButton:selected /template/ Border#Border">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Calendar#DocumentDateCalendar CalendarDayButton:selected">
            <Setter Property="Foreground" Value="{DynamicResource OnFg}" />
        </Style>
        <Style Selector="Calendar#DocumentDateCalendar /template/ CalendarItem /template/ Button#PART_PreviousButton, Calendar#DocumentDateCalendar /template/ CalendarItem /template/ Button#PART_NextButton">
            <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
        </Style>
        <Style Selector="Calendar#DocumentDateCalendar /template/ CalendarItem /template/ Button#PART_PreviousButton Path, Calendar#DocumentDateCalendar /template/ CalendarItem /template/ Button#PART_NextButton Path">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="5" />
        </Style>
        <!-- A field's shortcut keycap shows while the field waits for it, and steps aside once the field has the keyboard. -->
        <Style Selector="Border.key.field-key">
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style Selector="TextBox:focus-within Border.key.field-key, AutoCompleteBox:focus-within Border.key.field-key">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <!-- Filing card fields: an 84 px label column in Fg3, values that show the value and open its editor. -->
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Fg3}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,8,8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Button.field">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="-8,0,0,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="Button.field.empty">
            <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
        </Style>
        <Style Selector="Button.field:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Hover}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="Button.field:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Pressed}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="Button.field:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FgDisabled}" />
        </Style>
        <Style Selector="TextBlock.fact">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <!-- A fact is never cut: a long one ("Dans la boîte de réception") takes a second line. -->
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.fact-label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Fg3}" />
        </Style>
        <!-- The document's path: one 13 px mono line in Fg3, trimmed at the end. -->
        <Style Selector="Button.path">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource Fg3}" />
        </Style>
        <Style Selector="Button.path:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.path:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>

        <Style Selector="AutoCompleteBox.tag-entry">
            <Setter Property="FilterMode" Value="None" />
            <Setter Property="MaxLength" Value="48" />
            <Setter Property="MaxDropDownHeight" Value="196" />
        </Style>
        <Style Selector="AutoCompleteBox#TagBox">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="AutoCompleteBox.tag-entry /template/ Popup#PART_Popup">
            <Setter Property="ShouldUseOverlayLayer" Value="True" />
            <Setter Property="OverlayDismissEventPassThrough" Value="True" />
        </Style>

        <!-- The sort choice: a ghost control beside the view title. -->
        <Style Selector="ComboBox.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,0,0,0" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
        </Style>
        <Style Selector="ComboBox.ghost /template/ Border#Background">
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style Selector="ComboBox.ghost:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource Hover}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ComboBox.ghost:pressed /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource Pressed}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- The page preview keeps its fit and zoom scrolling rules. -->
        <Style Selector="ScrollViewer.pdf-preview">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="ScrollViewer.pdf-preview.fitWidth">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style Selector="ScrollViewer.pdf-preview.zoomed">
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <!-- The page bar floats over the desk: raised, 12 px corners, the pop shadow, 32 px buttons between hairlines. -->
        <Style Selector="Border.pagebar">
            <Setter Property="Background" Value="{DynamicResource Raised}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusPopover}" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="BoxShadow" Value="{DynamicResource ShadowPop}" />
        </Style>
        <Style Selector="Border.pagebar-rule">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="4,7" />
            <Setter Property="Background" Value="{DynamicResource Line}" />
        </Style>
        <Style Selector="Border.pagebar Button, Grid.viewer-bar Button, Grid.viewer-bar ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="Grid.viewer-bar Button, Grid.viewer-bar ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        </Style>
        <Style Selector="Button.page-icon, ToggleButton.page-icon">
            <Setter Property="Width" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.pagebar Button.page-icon">
            <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
        </Style>
        <Style Selector="Border.pagebar Button:pointerover /template/ ContentPresenter#PART_ContentPresenter, Grid.viewer-bar Button:pointerover /template/ ContentPresenter#PART_ContentPresenter, Grid.viewer-bar ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Hover}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="Border.pagebar Button:pressed /template/ ContentPresenter#PART_ContentPresenter, Grid.viewer-bar Button:pressed /template/ ContentPresenter#PART_ContentPresenter, Grid.viewer-bar ToggleButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Pressed}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="Grid.viewer-bar ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Selected}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="Border.pagebar Button:disabled /template/ ContentPresenter#PART_ContentPresenter, Grid.viewer-bar Button:disabled /template/ ContentPresenter#PART_ContentPresenter, Grid.viewer-bar ToggleButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FgDisabled}" />
        </Style>
        <!--
            Fit width or Fit page is a word on a wide canvas and a glyph on a narrow one, so the viewer bar keeps one row.
            The label stays the button's content: it is the tooltip and what a screen reader says.
        -->
        <Style Selector="Button#PreviewFitButton">
            <Setter Property="local:Ui.Icon" Value="{StaticResource Icon.FitWidth}" />
        </Style>
        <Style Selector="Button#PreviewFitButton.fit-page">
            <Setter Property="local:Ui.Icon" Value="{StaticResource Icon.Fit}" />
        </Style>
        <Style Selector="Grid.compact Button#PreviewFitButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="ContentTemplate">
                <DataTemplate x:DataType="x:String">
                    <local:Icon Data="{Binding $parent[Button].(local:Ui.Icon)}" VerticalAlignment="Center" />
                </DataTemplate>
            </Setter>
        </Style>
        <!--
            Match buttons are a pair of chevrons on the viewer bar's own row, up for the previous match and down for the next,
            after a small amber dot; amber stays on the hits. Both hold their places whenever there are matches (Previous
            waits, unable to act, until the first jump), and they are quiet Fg2 glyphs like the bar's others. Their words stay
            the content: the tooltip and what a screen reader says.
        -->
        <Style Selector="Grid.viewer-bar Button.match">
            <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
            <Setter Property="ContentTemplate">
                <DataTemplate x:DataType="x:String">
                    <local:Icon Data="{Binding $parent[Button].(local:Ui.Icon)}" Width="18" Height="18" VerticalAlignment="Center" />
                </DataTemplate>
            </Setter>
        </Style>
        <Style Selector="Grid.viewer-bar Button.match:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FgDisabled}" />
        </Style>

        <!-- Queue rows: 10 px inside, 12 px corners; the selected row sits in the sunken well with a hairline. -->
        <Style Selector="ListBox#DocumentList ListBoxItem" x:DataType="core:DocumentSummary">
            <Setter Property="Margin" Value="10,1" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        </Style>
        <Style Selector="ListBox#PaletteList ListBoxItem" x:DataType="local:PaletteCommand">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding Group}" />
        </Style>
        <Style Selector="Grid.compact ListBox#DocumentList ListBoxItem">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="5,1" />
        </Style>
        <Style Selector="Grid.compact StackPanel.row-text">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- The queue's own actions are small buttons, so Save search and Select shown share one row when they fit. -->
        <Style Selector="WrapPanel.queue-actions > Button">
            <Setter Property="Padding" Value="9,0" />
        </Style>
        <Style Selector="Grid.compact Border.queue-header">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="TextBlock.row-title-text">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Welcome: the graphite hero, then a row group. The mark leaves the hero below 1040 px. -->
        <Style Selector="Grid.narrow Panel.hero-art">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.group-row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="Button.group-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Hover}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="Button.group-row:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Pressed}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="Button.group-row:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Grid.welcome-row">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Margin" Value="20,10" />
            <Setter Property="ColumnSpacing" Value="16" />
        </Style>

        <!-- The toast sits 16 px above the page bar (14 below it, 40 tall), or 16 px from the bottom when no page is open. -->
        <Style Selector="Border#Toast">
            <Setter Property="Margin" Value="16,0,16,70" />
        </Style>
        <Style Selector="Border#Toast.low">
            <Setter Property="Margin" Value="16,0,16,16" />
        </Style>

        <Style Selector="Border.overlay-scrim">
            <Setter Property="Background" Value="{DynamicResource Scrim}" />
        </Style>
    </Window.Styles>

    <Panel>
        <Grid x:Name="ShellGrid" ColumnDefinitions="252,*">
            <!-- ─────────── Sidebar, on the desk: the library, places, then the status card, Trash and Settings ─────────── -->
            <Grid x:Name="Sidebar" RowDefinitions="Auto,*,Auto">
                <Button x:Name="LibrarySwitcherButton" Classes="switcher" Margin="12,8,12,10" IsEnabled="{Binding IsIdle}"
                        ToolTip.Tip="{Binding LibraryPath}" AutomationProperties.Name="{translation:Tr ChooseLibraryFolder}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border Classes="tile" VerticalAlignment="Center">
                            <Path Data="{StaticResource Mark.Full}" Fill="{DynamicResource TileFg}" Stretch="Uniform" Height="14"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding LibraryName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <local:Icon Grid.Column="2" Data="{StaticResource Icon.ChevronsUpDown}" Width="16" Height="16" StrokeWidth="1.7"
                                    Foreground="{DynamicResource Fg3}" VerticalAlignment="Center" />
                    </Grid>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="{translation:Tr ChooseLibraryFolder}" Command="{Binding ChooseLibraryCommand}" />
                            <MenuItem Header="{translation:Tr ShowPDFFolder}" Command="{Binding OpenPdfFolderCommand}" IsEnabled="{Binding HasLibrary}" />
                            <MenuItem Header="{translation:Tr BackUpLibrary}" Command="{Binding BackUpLibraryCommand}" IsEnabled="{Binding CanWork}" />
                            <Separator />
                            <MenuItem Header="{translation:Tr SettingsTip}" Click="OpenSettings_Click" InputGesture="{x:Static local:PaletteCommands.SettingsGesture}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!--
                    The scroller leaves 12 px at the left for the current place's ink bar at the window's edge. Its bar shows
                    only under the pointer, and the places fade into the desk above the status card instead of being cut.
                -->
                <Border Grid.Row="1" Height="20" VerticalAlignment="Bottom" Background="{DynamicResource SidebarFade}" IsHitTestVisible="False" ZIndex="1" />
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Padding="12,0">
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel Spacing="2">
                            <Button x:Name="InboxButton" Classes="nav" Classes.current="{Binding InboxSelected}"
                                    Command="{Binding ShowInboxCommand}" AutomationProperties.Name="{Binding InboxAutomationName}"
                                    ToolTip.Tip="{translation:Tr Inbox}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <local:Icon Data="{StaticResource Icon.Inbox}" Width="18" Height="18" StrokeWidth="1.7" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{translation:Tr InboxPlace}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" x:Name="InboxReviewCount" Classes="count" Text="{Binding InboxCount}" IsVisible="{Binding HasInboxCount}" />
                                </Grid>
                            </Button>
                            <Button x:Name="AllDocumentsButton" Classes="nav" Classes.current="{Binding AllSelected}" Command="{Binding ShowAllCommand}"
                                    ToolTip.Tip="{translation:Tr AllDocuments}" AutomationProperties.Name="{translation:Tr AllDocuments}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <local:Icon Data="{StaticResource Icon.AllDocuments}" Width="18" Height="18" StrokeWidth="1.7" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{translation:Tr AllDocumentsPlace}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="UpcomingButton" Classes="nav" Command="{Binding RemindersCommand}" IsEnabled="{Binding CanWork}"
                                    ToolTip.Tip="{translation:Tr UpcomingHelp}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <local:Icon Data="{StaticResource Icon.Upcoming}" Width="18" Height="18" StrokeWidth="1.7" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{translation:Tr Upcoming}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Classes="count" Text="{Binding DueReminderLabel}" Foreground="{DynamicResource Warn}"
                                               IsVisible="{Binding HasDueReminders}" />
                                </Grid>
                            </Button>
                            <Button x:Name="WithoutTextButton" Classes="nav" Classes.current="{Binding WithoutTextSelected}"
                                    Command="{Binding ShowWithoutTextCommand}" ToolTip.Tip="{translation:Tr FindPDFsWithoutSearchableText}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <local:Icon Data="{StaticResource Icon.ScanFrame}" Width="18" Height="18" StrokeWidth="1.7" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{translation:Tr WithoutText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <StackPanel x:Name="SavedSearchesSection">
                            <StackPanel.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="HasSavedSearches" />
                                    <Binding Path="LibraryHasDocuments" />
                                </MultiBinding>
                            </StackPanel.IsVisible>
                            <TextBlock Classes="section" Text="{translation:Tr SavedSearches}" />
                            <ItemsControl x:Name="SavedSearchList" ItemsSource="{Binding SavedSearches}" IsEnabled="{Binding CanWork}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:SavedSearch">
                                        <Button Classes="nav" Click="OpenSavedSearch_Click" ToolTip.Tip="{Binding Query}"
                                                AutomationProperties.Name="{Binding Name}">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                <local:Icon Data="{StaticResource Icon.Search}" Width="18" Height="18" StrokeWidth="1.7" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel x:Name="TagsSection">
                            <StackPanel.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="HasTags" />
                                    <Binding Path="LibraryHasDocuments" />
                                </MultiBinding>
                            </StackPanel.IsVisible>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="section" Text="{translation:Tr Tags}" />
                                <Button Grid.Column="1" x:Name="RenameActiveTagButton" Classes="subaction" Content="{translation:Tr Rename}"
                                        VerticalAlignment="Bottom" Margin="0,0,4,2"
                                        IsVisible="{Binding HasActiveTag}" IsEnabled="{Binding CanWork}"
                                        Command="{Binding RenameActiveTagCommand}" AutomationProperties.Name="{translation:Tr RenameSelectedTag}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding TagNavigation}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:TagNavigationItem">
                                        <Button Classes="rail" Click="FilterTag_Click" AutomationProperties.Name="{Binding Label}">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="{Binding Indent}">
                                                <Panel Width="18" Height="18" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource RailTagMarker}" />
                                                    <Ellipse Width="8" Height="8" Fill="{Binding Color}" />
                                                </Panel>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!--
                    The foot: the status card, then Trash and Settings. The card is Plico's live state and one button:
                    it opens Settings at Intake, or the import errors or the index report when they need the person.
                    Intake, the watches, the phone inbox and the recognition language live in Settings.
                -->
                <StackPanel Grid.Row="2" x:Name="SidebarFoot" Spacing="2" Margin="12,8,12,12">
                    <Panel x:Name="StatusCard" Margin="0,0,0,8">
                        <Border Classes="status">
                            <StackPanel Spacing="3">
                                <!-- The state is never cut: the title takes a second line in a narrow sidebar, the detail wraps. -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                    <Border Classes="status-halo" Classes.live="{Binding StatusCardIsLive}" Classes.warning="{Binding StatusCardIsWarning}"
                                            Classes.failed="{Binding StatusCardIsFailed}" VerticalAlignment="Top" Margin="0,2,0,0">
                                        <Ellipse />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding StatusCardTitle}" FontSize="15" FontWeight="SemiBold" LineHeight="19"
                                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding StatusCardDetail}" FontSize="13" LineHeight="18" Foreground="{DynamicResource Fg2}"
                                           TextWrapping="Wrap" />
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,10,0,0">
                                    <Panel MinHeight="18">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding !IsBusy}">
                                            <local:Icon Data="{StaticResource Icon.Folder}" Width="14" Height="14" Foreground="{DynamicResource Fg2}"
                                                        VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding IntakeDestinationLabel}" FontSize="13" LineHeight="18" Foreground="{DynamicResource Fg2}"
                                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                        <ProgressBar Classes="slim" Margin="0,0,32,0" IsVisible="{Binding IsBusy}" IsIndeterminate="{Binding !HasWorkProgress}"
                                                     Minimum="0" Maximum="100" Value="{Binding WorkPercent}" />
                                    </Panel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Button x:Name="StatusCardButton" Classes="status-hit" IsVisible="{Binding ShowStatusCardButton}" Click="StatusCard_Click"
                                AutomationProperties.Name="{Binding StatusCardTitle}" AutomationProperties.HelpText="{Binding StatusCardDetail}"
                                ToolTip.Tip="{translation:Tr OpenIntakeSettings}" />
                        <Button x:Name="ImportErrorsButton" Classes="status-hit" IsVisible="{Binding HasImportFailures}" IsEnabled="{Binding CanWork}"
                                Command="{Binding InspectImportErrorsCommand}" AutomationProperties.Name="{Binding StatusCardTitle}"
                                AutomationProperties.HelpText="{Binding StatusCardDetail}" ToolTip.Tip="{translation:Tr ImportErrors}" />
                        <Button x:Name="IndexReportButton" Classes="status-hit" IsVisible="{Binding ShowIndexReportCard}"
                                Command="{Binding ShowIndexReportCommand}" AutomationProperties.Name="{Binding StatusCardTitle}"
                                AutomationProperties.HelpText="{Binding StatusCardDetail}" ToolTip.Tip="{translation:Tr IndexReport}" />
                        <Button x:Name="CancelWorkButton" Classes="icon small" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,9,9"
                                IsVisible="{Binding IsBusy}" Command="{Binding CancelCommand}"
                                AutomationProperties.Name="{translation:Tr Cancel}" ToolTip.Tip="{translation:Tr Cancel}">
                            <local:Icon Data="{StaticResource Icon.Close}" Width="14" Height="14" />
                        </Button>
                    </Panel>
                    <Button x:Name="OpenTrashButton" Classes="nav" Command="{Binding OpenTrashCommand}" IsEnabled="{Binding CanWork}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <local:Icon Data="{StaticResource Icon.Trash}" Width="18" Height="18" StrokeWidth="1.7" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{translation:Tr Trash}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="SettingsButton" Classes="nav" Click="OpenSettings_Click" ToolTip.Tip="{translation:Tr SettingsTip}"
                            AutomationProperties.Name="{translation:Tr SettingsTip}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <local:Icon Data="{StaticResource Icon.Settings}" Width="18" Height="18" StrokeWidth="1.7" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{translation:Tr SettingsTip}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ─────────── The sheet: toolbar and workspace, inset 6 px with a 12 px corner and a hairline edge ─────────── -->
            <Border Grid.Column="1" x:Name="Sheet" Margin="0,6,0,0" CornerRadius="12,0,0,0" BorderThickness="1,1,0,0"
                    BorderBrush="{DynamicResource Line}" Background="{DynamicResource Panel}" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <!--
                        Toolbar: search with the folder filter and its tips at the left, the two ways in and the tools at the
                        right. A search that cannot run says how to repair it in one line under the field, never in the queue.
                        The line floats over the sheet, so the toolbar is drawn above the workspace and nothing below it moves.
                    -->
                    <Border x:Name="Toolbar" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" MinHeight="64" ZIndex="1">
                        <Grid x:Name="ToolbarLayout" ColumnDefinitions="*,Auto">
                            <Grid x:Name="SearchRow" RowDefinitions="Auto,Auto">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100*" MaxWidth="560" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SearchBox" Classes="search" Classes.invalid="{Binding HasSearchQueryHint}" Text="{Binding Query, Mode=TwoWay}" MaxLength="256"
                                         KeyDown="SearchBox_KeyDown"
                                         PlaceholderText="{translation:Tr SearchYourPaperwork}" AutomationProperties.Name="{translation:Tr SearchDocuments}">
                                    <TextBox.InnerLeftContent>
                                        <local:Icon Data="{StaticResource Icon.Search}" Width="17" Height="17" StrokeWidth="1.7" Margin="12,0,6,0" Foreground="{DynamicResource Fg3}" />
                                    </TextBox.InnerLeftContent>
                                    <TextBox.InnerRightContent>
                                        <Border Classes="key" Margin="0,0,9,0" IsHitTestVisible="False"
                                                IsVisible="{Binding $parent[TextBox].Text, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                            <TextBlock Text="/" />
                                        </Border>
                                    </TextBox.InnerRightContent>
                                </TextBox>
                                <!-- Until the library has its first document there is nothing to search, so the field stands alone. -->
                                <Button Grid.Column="1" x:Name="ChooseSearchFolderButton" Classes="icon" Command="{Binding ChooseSearchFolderCommand}"
                                        IsEnabled="{Binding CanWork}" IsVisible="{Binding LibraryHasDocuments}" AutomationProperties.Name="{translation:Tr ChooseALibraryFolderToSearch}"
                                        ToolTip.Tip="{translation:Tr ChooseALibraryFolderToSearch}">
                                    <local:Icon Data="{StaticResource Icon.Folder}" Width="17" Height="17" StrokeWidth="1.7" />
                                </Button>
                                <!-- The search syntax, in the interface's language, behind a small help button instead of a tooltip. -->
                                <Button Grid.Column="2" x:Name="SearchTipsButton" Classes="icon" IsVisible="{Binding LibraryHasDocuments}" AutomationProperties.Name="{translation:Tr SearchTips}"
                                        ToolTip.Tip="{translation:Tr SearchTips}">
                                    <local:Icon Data="{StaticResource Icon.Help}" Width="17" Height="17" StrokeWidth="1.7" />
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedLeft">
                                            <StackPanel Width="380" Spacing="12">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{translation:Tr SearchTips}" FontSize="15" FontWeight="SemiBold" />
                                                    <TextBlock Classes="caption" Text="{translation:Tr SearchTipsLede}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Grid Classes="search-tips" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                                    <TextBlock Classes="mono" Text="receipt OR invoice" />
                                                    <TextBlock Grid.Column="1" Text="{translation:Tr SearchTipEither}" />
                                                    <TextBlock Grid.Row="1" Classes="mono" Text="&quot;oil change&quot;" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{translation:Tr SearchTipPhrase}" />
                                                    <TextBlock Grid.Row="2" Classes="mono" Text="-tag:archive" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{translation:Tr SearchTipLeaveOut}" />
                                                    <TextBlock Grid.Row="3" Classes="mono" Text="tag:tax" />
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{translation:Tr SearchTipTag}" />
                                                    <TextBlock Grid.Row="4" Classes="mono" Text="status:inbox" />
                                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{translation:Tr SearchTipStatus}" />
                                                    <TextBlock Grid.Row="5" Classes="mono" Text="text:missing" />
                                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{translation:Tr SearchTipText}" />
                                                    <TextBlock Grid.Row="6" Classes="mono" Text="dated:2024-02" />
                                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{translation:Tr SearchTipDated}" />
                                                    <TextBlock Grid.Row="7" Classes="mono" Text="added:2026-11" />
                                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{translation:Tr SearchTipAdded}" />
                                                    <TextBlock Grid.Row="8" Classes="mono" Text="folder:&quot;Filed/Property&quot;" />
                                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{translation:Tr SearchTipFolder}" />
                                                </Grid>
                                                <TextBlock Classes="caption" Text="{translation:Tr SearchTipCapitals}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <!--
                                    The correction hangs under the field without taking room: a zero-height canvas lets it float over the
                                    sheet, its glyph under the search glyph and its words where the typed query starts. It is as wide as
                                    the search row, so a long correction keeps to one line where there is room, and clicks pass through it.
                                -->
                                <Canvas Grid.Row="1" Grid.ColumnSpan="4" x:Name="SearchQueryHintLayer" Height="0" IsHitTestVisible="False"
                                        IsVisible="{Binding HasSearchQueryHint}">
                                    <Border Classes="search-hint" Canvas.Top="3" MaxWidth="{Binding #SearchQueryHintLayer.Bounds.Width}">
                                        <Border Classes="search-hint-tint">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                <local:Icon Data="{StaticResource Icon.AlertCircle}" Width="14" Height="14" StrokeWidth="1.8" Foreground="{DynamicResource Err}"
                                                            VerticalAlignment="Top" Margin="0,2,0,0" />
                                                <TextBlock Grid.Column="1" x:Name="SearchQueryHint" Classes="validation" Text="{Binding SearchQueryHint}" LineHeight="18"
                                                           AutomationProperties.LiveSetting="Polite" />
                                            </Grid>
                                        </Border>
                                    </Border>
                                </Canvas>
                            </Grid>
                            <!-- Until the library has its first document the welcome hero carries Scan and Add files. -->
                            <StackPanel Grid.Column="1" x:Name="ToolbarActions" Orientation="Horizontal" Height="40" VerticalAlignment="Top">
                                <Button x:Name="ScanButton" Classes="secondary large with-icon" local:Ui.Icon="{StaticResource Icon.ScanFrame}" IsVisible="{Binding !ShowWelcome}"
                                        Command="{Binding ScanCommand}" Content="{translation:Tr Scan}" IsEnabled="{Binding CanWork}" ToolTip.Tip="{translation:Tr ScanTip}" />
                                <StackPanel Orientation="Horizontal" IsVisible="{Binding !ShowWelcome}">
                                    <Button x:Name="AddFilesButton" Classes="primary large with-icon" local:Ui.Icon="{StaticResource Icon.Plus}" CornerRadius="10,0,0,10"
                                            IsEnabled="{Binding CanWork}" Command="{Binding AddFilesCommand}" Content="{translation:Tr AddFiles}"
                                            ToolTip.Tip="{translation:Tr AddFilesTip}" />
                                    <Border Width="1" Margin="0,9" Background="{DynamicResource PrimaryDivider}" IsHitTestVisible="False" />
                                    <Button x:Name="AddFromMenuButton" Classes="primary large" CornerRadius="0,10,10,0" Padding="9,0" IsEnabled="{Binding CanWork}"
                                            AutomationProperties.Name="{translation:Tr MoreWaysToAdd}" ToolTip.Tip="{translation:Tr MoreWaysToAdd}">
                                        <local:Icon Data="{StaticResource Icon.ChevronDown}" Width="20" Height="20" StrokeWidth="1.7" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuItem Header="{translation:Tr AddFiles}" Command="{Binding AddFilesCommand}" InputGesture="{x:Static local:PaletteCommands.AddFilesGesture}" />
                                                <MenuItem Header="{translation:Tr ImportPasswordProtectedPDF2}" Command="{Binding ImportProtectedPdfCommand}" />
                                                <Separator />
                                                <MenuItem Header="{translation:Tr MigratePaperlessFolder}" Command="{Binding MigratePaperlessFolderCommand}" />
                                                <MenuItem Header="{translation:Tr MigratePaperlessZip}" Command="{Binding MigratePaperlessZipCommand}" />
                                                <MenuItem Header="{translation:Tr MigrateEvernote}" Command="{Binding MigrateEvernoteCommand}" />
                                                <MenuItem Header="{translation:Tr MigrateMariner}" Command="{Binding MigrateMarinerCommand}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="2" Margin="2,0,0,0">
                                    <Button x:Name="CommandPaletteButton" Classes="icon" Click="OpenPalette_Click" VerticalAlignment="Center"
                                            AutomationProperties.Name="{translation:Tr Commands}" ToolTip.Tip="{translation:Tr CommandsTip}">
                                        <local:Icon Data="{StaticResource Icon.Keyboard}" Width="17" Height="17" />
                                    </Button>
                                    <Button x:Name="LibraryToolsButton" Classes="icon" IsEnabled="{Binding CanWork}" VerticalAlignment="Center"
                                            AutomationProperties.Name="{translation:Tr LibraryTools}" ToolTip.Tip="{translation:Tr LibraryTools}">
                                        <local:Icon Data="{StaticResource Icon.More}" StrokeWidth="2.2" Width="17" Height="17" />
                                        <Button.Flyout>
                                            <!-- Verification reads items 2–4 by position: integrity, JSON and CSV. -->
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuItem Header="{translation:Tr TagRules2}" Command="{Binding ManageFilingRulesCommand}" />
                                                <MenuItem Header="{translation:Tr CheckLibraryIntegrity}" Command="{Binding CheckIntegrityCommand}" />
                                                <MenuItem Header="{translation:Tr ExportLibraryMetadataJSON}" Command="{Binding ExportMetadataCommand}" />
                                                <MenuItem Header="{translation:Tr ExportSearchResultsCSV}" Command="{Binding ExportSearchCsvCommand}" />
                                                <MenuItem Header="{translation:Tr ArchiveSerialMenu}">
                                                    <MenuItem Header="{translation:Tr ArchiveSerialSet}" Command="{Binding EditArchiveSerialCommand}"
                                                              IsEnabled="{Binding HasSelection}" />
                                                    <MenuItem Header="{translation:Tr ArchiveSerialFind}" Command="{Binding FindArchiveSerialCommand}" />
                                                    <MenuItem Header="{translation:Tr ArchiveLabelSheets}" Command="{Binding PrintArchiveLabelsCommand}" />
                                                    <MenuItem Header="{translation:Tr ArchiveSeparator}" Command="{Binding PrintSeparatorSheetCommand}" />
                                                </MenuItem>
                                                <MenuItem Header="{translation:Tr MigrationMenu}">
                                                    <MenuItem Header="{translation:Tr MigratePaperlessFolder}" Command="{Binding MigratePaperlessFolderCommand}" />
                                                    <MenuItem Header="{translation:Tr MigratePaperlessZip}" Command="{Binding MigratePaperlessZipCommand}" />
                                                    <MenuItem Header="{translation:Tr MigrateEvernote}" Command="{Binding MigrateEvernoteCommand}" />
                                                    <MenuItem Header="{translation:Tr MigrateMariner}" Command="{Binding MigrateMarinerCommand}" />
                                                </MenuItem>
                                                <Separator />
                                                <MenuItem Header="{translation:Tr RefreshIndex}" Command="{Binding RefreshIndexCommand}" />
                                                <MenuItem Header="{translation:Tr MetadataDefinitions}" Command="{Binding ManageMetadataCommand}" />
                                                <MenuItem Header="{Binding ReminderMenuTitle}" Command="{Binding RemindersCommand}" />
                                                <MenuItem Header="{translation:Tr LocalModels}" Command="{Binding ConfigureLocalModelsCommand}" />
                                                <MenuItem Header="{translation:Tr SemanticSearchAction}" Command="{Binding SearchSemanticallyCommand}" IsEnabled="{Binding HasSemanticSearch}" />
                                                <MenuItem Header="{translation:Tr ClearSemanticIndex}" Command="{Binding RebuildSemanticIndexCommand}" IsEnabled="{Binding HasSemanticSearch}" />
                                                <MenuItem Header="{translation:Tr AskLocalModelAction}" Command="{Binding AskLocalModelCommand}" IsEnabled="{Binding HasLocalChat}" />
                                                <MenuItem Header="{translation:Tr UndoLocalFiling}" Command="{Binding UndoLocalFilingCommand}" IsEnabled="{Binding HasSelection}" />
                                                <MenuItem Header="{translation:Tr ImportPasswordProtectedPDF2}" Command="{Binding ImportProtectedPdfCommand}" />
                                                <MenuItem Header="{translation:Tr Appearance2}" Command="{Binding ShowAppearanceCommand}" />
                                                <Separator />
                                                <MenuItem Header="{translation:Tr Commands}" Click="OpenPalette_Click" InputGesture="{x:Static local:PaletteCommands.PaletteGesture}" />
                                                <MenuItem Header="{translation:Tr KeyboardShortcuts}" Click="OpenShortcuts_Click" />
                                                <MenuItem Header="{translation:Tr SettingsTip}" Click="OpenSettings_Click" InputGesture="{x:Static local:PaletteCommands.SettingsGesture}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ─────────── Workspace: queue, page and filing card ─────────── -->
                    <Grid Grid.Row="1" x:Name="WorkspaceGrid" ColumnDefinitions="272,*,296" RowDefinitions="Auto,*">
                        <!--
                            Queue header: the place in 24 Bold, then the count as a sentence with the sort choice at its right
                            (the count wraps rather than being cut), then the queue's own actions as small buttons. There is
                            no footer: these are the only copies, at every width. In compact windows the header spans the
                            thumbnail strip and the page, so it stays readable.
                        -->
                        <Border x:Name="QueueHeader" Classes="queue-header" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                                Padding="20,18,10,10">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="InboxHeading" Classes="title" Text="{Binding Heading}" TextTrimming="CharacterEllipsis"
                                           AutomationProperties.HeadingLevel="1" Margin="0,0,10,0" />
                                <local:CountLinePanel>
                                    <TextBlock Classes="label" Text="{Binding QueueCountLabel}" TextWrapping="Wrap" LineHeight="20" VerticalAlignment="Center"
                                               Margin="0,6" ToolTip.Tip="{Binding ResultCount}" FontFeatures="+tnum" />
                                    <!-- The sort choice gives way before the count does: it trims its label, the count never trims. -->
                                    <ComboBox x:Name="DocumentSortBox" Classes="ghost" ItemsSource="{Binding SortChoices}" VerticalAlignment="Top"
                                              SelectedItem="{Binding SortOption, Mode=TwoWay}"
                                              IsEnabled="{Binding HasLibrary}" AutomationProperties.Name="{translation:Tr SortDocuments}" ToolTip.Tip="{translation:Tr Sort}">
                                        <ComboBox.SelectionBoxItemTemplate>
                                            <DataTemplate x:DataType="local:InboxViewModel+SortChoice">
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ComboBox.SelectionBoxItemTemplate>
                                    </ComboBox>
                                </local:CountLinePanel>
                                <WrapPanel Classes="queue-actions" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" Margin="0,2,0,0">
                                    <Button x:Name="SaveSearchButton" Classes="secondary small" Content="{translation:Tr SaveSearch2}" Command="{Binding SaveSearchCommand}"
                                            IsVisible="{Binding ShowSaveSearch}" IsEnabled="{Binding CanWork}" />
                                    <Button x:Name="EditSavedSearchButton" Classes="secondary small" Content="{translation:Tr EditSearch}" Command="{Binding EditActiveSavedSearchCommand}"
                                            IsVisible="{Binding HasActiveSavedSearch}" IsEnabled="{Binding CanWork}" />
                                    <Button x:Name="RefreshWatchedResultsButton" Classes="secondary small" Content="{translation:Tr RefreshResults}"
                                            Command="{Binding RefreshWatchedResultsCommand}" IsVisible="{Binding HasDeferredWatchResults}"
                                            IsEnabled="{Binding CanWork}" ToolTip.Tip="{translation:Tr RefreshAfterWatchedImports}" />
                                    <Button x:Name="SelectShownButton" Classes="secondary small" Content="{Binding SelectShownAction}" Click="SelectShown_Click"
                                            IsVisible="{Binding HasBatchCandidates}" AutomationProperties.Name="{Binding SelectShownAction}" />
                                    <Button Classes="secondary small" Content="{translation:Tr LoadMore}" Command="{Binding LoadMoreCommand}" IsVisible="{Binding HasMore}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!--
                            An empty queue is the family empty state: a dashed outline, the graphite tile, a title that says
                            what is true, one sentence and Clear search when a search caused it. In compact windows it spans
                            the thumbnail strip and the page, which has nothing to show, so its words are never squeezed.
                        -->
                        <Panel Grid.Row="1" x:Name="QueueEmptyState" Background="{DynamicResource Panel}" IsVisible="{Binding !HasDocuments}" ZIndex="1">
                            <Panel HorizontalAlignment="Stretch" VerticalAlignment="Center" MaxWidth="400" Margin="16">
                                <Rectangle Classes="dashed-frame" />
                                <StackPanel Classes="empty" Margin="20,28">
                                    <Border Classes="tile empty-tile">
                                        <local:Icon Data="{StaticResource Icon.Search}" Width="20" Height="20" StrokeWidth="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Classes="empty-title" Text="{Binding EmptyTitle}" />
                                    <TextBlock x:Name="EmptyResultsMessage" Classes="empty-text" Text="{Binding EmptyMessage}" IsVisible="{Binding !HasDocuments}"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <Button Classes="secondary" HorizontalAlignment="Center" Margin="0,10,0,0" Content="{translation:Tr ClearSearch}"
                                            Command="{Binding ClearSearchCommand}" IsVisible="{Binding HasQuery}" />
                                </StackPanel>
                            </Panel>
                        </Panel>
                        <Grid Grid.Row="1" Background="{DynamicResource Panel}">
                            <ListBox x:Name="DocumentList" Classes="plain" ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                                     IsVisible="{Binding HasDocuments}" Padding="0,2,0,8"
                                     SelectionMode="Multiple" SelectionChanged="Documents_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{translation:Tr Documents}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="core:DocumentSummary">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <!-- The thumbnail wears the open page's veil, so paper reads as the Paper colour in both themes. -->
                                            <Border Classes="paper" Width="40" Height="52" VerticalAlignment="Top">
                                                <Panel>
                                                    <local:DocumentThumbnail Document="{Binding}" CornerRadius="1.5" ToolTip.Tip="{Binding Title}" />
                                                    <Border Classes="page-dim" CornerRadius="1.5" />
                                                </Panel>
                                            </Border>
                                            <StackPanel Grid.Column="1" Classes="row-text" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Classes="row-title-text" Text="{Binding Title}" />
                                                <TextBlock Classes="caption" Text="{Binding, Converter={x:Static local:QueueMetaConverter.Instance}}"
                                                           TextTrimming="CharacterEllipsis" FontFeatures="+tnum" />
                                                <local:SearchExcerpt Document="{Binding}" FontFamily="{DynamicResource VoiceFont}" FontSize="14" LineHeight="20"
                                                                     Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                                     Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- Page: paper on the desk -->
                        <Border Grid.Column="1" Grid.RowSpan="2" x:Name="PageColumn" Background="{DynamicResource Desk}" ClipToBounds="True">
                            <Panel>
                                <!-- Only a queue with documents asks for a choice; an empty queue explains itself once, in the queue. -->
                                <Panel IsVisible="{Binding HasDocuments}">
                                    <StackPanel Classes="empty" IsVisible="{Binding !HasSelection}">
                                        <TextBlock Classes="empty-text" Text="{translation:Tr SelectADocumentToPreviewIt}" />
                                    </StackPanel>
                                </Panel>
                                <Grid IsVisible="{Binding HasSelection}" RowDefinitions="Auto,*">
                                    <!-- One row: the match chevrons at the left, fit, thumbnails, zoom and open at the right. -->
                                    <Grid Classes="viewer-bar" Margin="12,10,12,0">
                                        <local:ViewerBarPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding HasPageMatchAction}" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="{DynamicResource HighlightMark}" Margin="6,0,5,0" VerticalAlignment="Center"
                                                         IsHitTestVisible="False" />
                                                <Button x:Name="PreviousMatchButton" Classes="page-icon match" local:Ui.Icon="{StaticResource Icon.ChevronUp}"
                                                        Content="{translation:Tr PreviousMatch}" Command="{Binding PreviousMatchCommand}"
                                                        IsVisible="{Binding HasPageMatchAction}" IsEnabled="{Binding CanGoToPreviousMatch}"
                                                        ToolTip.Tip="{translation:Tr PreviousMatch}" AutomationProperties.Name="{translation:Tr PreviousMatch}"
                                                        AutomationProperties.HelpText="{translation:Tr GoToThePreviousPageThatMatchesTheTextTerms}" />
                                                <Button x:Name="GoToMatchButton" Classes="page-icon match" local:Ui.Icon="{StaticResource Icon.ChevronDown}"
                                                        Content="{Binding PageMatchActionLabel}" Command="{Binding GoToMatchCommand}"
                                                        IsVisible="{Binding HasPageMatchAction}" IsEnabled="{Binding CanWork}"
                                                        ToolTip.Tip="{Binding PageMatchActionLabel}" AutomationProperties.Name="{Binding PageMatchActionLabel}"
                                                        AutomationProperties.HelpText="{Binding PageMatchActionHelp}" />
                                            </StackPanel>
                                            <WrapPanel HorizontalAlignment="Right" ItemSpacing="2" VerticalAlignment="Center">
                                                <Button x:Name="PreviewFitButton" Content="{Binding PreviewFitAction}" Command="{Binding TogglePreviewFitCommand}"
                                                        Classes.fit-page="{Binding FitPreviewWidth}" ToolTip.Tip="{Binding PreviewFitAction}"
                                                        IsEnabled="{Binding HasPreview}" IsVisible="{Binding !IsPageTextView}" />
                                                <ToggleButton x:Name="PageThumbnailsButton" Classes="page-icon" IsChecked="{Binding ShowPageThumbnails, Mode=OneWay}"
                                                              Command="{Binding TogglePageThumbnailsCommand}" IsEnabled="{Binding HasMultiplePages}"
                                                              IsVisible="{Binding !IsPageTextView}" ToolTip.Tip="{translation:Tr Thumbnails}"
                                                              AutomationProperties.Name="{translation:Tr Thumbnails}">
                                                    <local:Icon Data="{StaticResource Icon.Pages}" />
                                                </ToggleButton>
                                                <Button x:Name="ZoomOutButton" Classes="page-icon" Command="{Binding ZoomOutCommand}" IsVisible="{Binding !IsPageTextView}"
                                                        IsEnabled="{Binding CanZoomOut}" AutomationProperties.Name="{translation:Tr ZoomOut}" ToolTip.Tip="{translation:Tr ZoomOut}">
                                                    <local:Icon Data="{StaticResource Icon.Minus}" />
                                                </Button>
                                                <TextBlock Text="{Binding PreviewZoomLabel}" IsVisible="{Binding !IsPageTextView}" VerticalAlignment="Center" FontSize="13"
                                                           FontWeight="Medium" MinWidth="40" TextAlignment="Center" FontFeatures="+tnum" Foreground="{DynamicResource Fg2}" />
                                                <Button x:Name="ZoomInButton" Classes="page-icon" Command="{Binding ZoomInCommand}" IsVisible="{Binding !IsPageTextView}"
                                                        IsEnabled="{Binding CanZoomIn}" AutomationProperties.Name="{translation:Tr ZoomIn}" ToolTip.Tip="{translation:Tr ZoomIn}">
                                                    <local:Icon Data="{StaticResource Icon.Plus}" />
                                                </Button>
                                                <Button x:Name="OpenPdfButton" Classes="page-icon" Command="{Binding OpenPdfCommand}" ToolTip.Tip="{translation:Tr OpenInPdfViewer}"
                                                        AutomationProperties.Name="{translation:Tr OpenPDF}">
                                                    <local:Icon Data="{StaticResource Icon.Open}" />
                                                </Button>
                                            </WrapPanel>
                                        </local:ViewerBarPanel>
                                    </Grid>

                                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                                      Width="76" Margin="10,10,0,64" IsVisible="{Binding HasVisiblePageThumbnails}">
                                            <ItemsControl x:Name="PageThumbnailList" ItemsSource="{Binding PageThumbnails}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="local:PdfPageThumbnail">
                                                        <Button Classes="ghost" Click="PageThumbnail_Click" Padding="4" HorizontalAlignment="Center"
                                                                AutomationProperties.Name="{Binding PageNumber, StringFormat={translation:Tr PageNumberAutomationFormat}}">
                                                            <StackPanel Spacing="3">
                                                                <Border Classes="paper">
                                                                    <Panel>
                                                                        <Image Source="{Binding Image}" Width="48" Height="62" Stretch="Uniform" />
                                                                        <Border Classes="page-dim" />
                                                                    </Panel>
                                                                </Border>
                                                                <TextBlock Text="{Binding PageNumber}" HorizontalAlignment="Center" Classes="caption" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <Panel Grid.Column="1" x:Name="DeskPanel" Margin="12,10,12,66">
                                            <Border x:Name="PreviewPaper" Classes="paper" IsVisible="{Binding !IsPageTextView}" ClipToBounds="True"
                                                    HorizontalAlignment="Center" VerticalAlignment="Stretch">
                                                <ScrollViewer x:Name="PreviewScroll" Classes="pdf-preview" Classes.fitWidth="{Binding FitPreviewWidth}"
                                                              Classes.zoomed="{Binding IsPreviewZoomed}"
                                                              Focusable="{Binding IsPreviewScrollable}" IsVisible="{Binding !IsPageTextView}"
                                                              AutomationProperties.Name="{translation:Tr PDFPagePreview}">
                                                    <Grid Width="{Binding PreviewDisplayWidth}" Height="{Binding PreviewDisplayHeight}">
                                                        <Image x:Name="PreviewPage" Source="{Binding Preview}" Stretch="Uniform" />
                                                        <local:PdfPageHighlightLayer Source="{Binding Preview}" Highlights="{Binding PreviewHighlights}"
                                                                                      Fill="{DynamicResource PageHighlight}" IsHitTestVisible="False" />
                                                        <Border Classes="page-dim" />
                                                    </Grid>
                                                </ScrollViewer>
                                            </Border>
                                            <Border Classes="paper" IsVisible="{Binding IsPageTextView}" MaxWidth="660" HorizontalAlignment="Center">
                                                <ScrollViewer x:Name="PageTextScroll" IsVisible="{Binding HasPageText}"
                                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                    <SelectableTextBlock x:Name="PageTextContent" Text="{Binding PageText}" TextWrapping="Wrap"
                                                                         Padding="28,22" FontSize="15" LineHeight="23" Focusable="True"
                                                                         Foreground="{DynamicResource PaperInk}" />
                                                </ScrollViewer>
                                            </Border>
                                            <Border Classes="callout" IsVisible="{Binding HasPreviewMessage}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
                                                <TextBlock Text="{Binding PreviewMessage}" TextWrapping="Wrap" TextAlignment="Center"
                                                           AutomationProperties.LiveSetting="Polite" />
                                            </Border>
                                            <Border Classes="popover" IsVisible="{Binding HasNoSearchableText}" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                    Margin="0,8,0,0" Padding="12,6,6,6">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <local:Icon Data="{StaticResource Icon.ScanFrame}" Foreground="{DynamicResource Warn}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{translation:Tr NoSearchableTextFound}" VerticalAlignment="Center" />
                                                    <Button Classes="secondary small" Content="{Binding SearchableCopyAction}" Command="{Binding CreateSearchableCopyCommand}"
                                                            IsEnabled="{Binding CanWork}" />
                                                </StackPanel>
                                            </Border>
                                        </Panel>
                                    </Grid>

                                    <!-- The floating page bar: copy text, page turning, read text. -->
                                    <Border Grid.Row="1" Classes="pagebar" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="CopyDocumentTextButton" Classes="page-icon" Command="{Binding CopyDocumentTextCommand}"
                                                    IsVisible="{Binding !HasNoSearchableText}" IsEnabled="{Binding CanWork}"
                                                    AutomationProperties.Name="{translation:Tr CopyDocumentText}" ToolTip.Tip="{translation:Tr CopyTheSearchableTextFromAllPages}">
                                                <local:Icon Data="{StaticResource Icon.Copy}" />
                                            </Button>
                                            <Border Classes="pagebar-rule" IsVisible="{Binding !HasNoSearchableText}" />
                                            <Grid x:Name="PreviewPageNavigation" ColumnDefinitions="Auto,Auto,Auto">
                                                <Button Classes="page-icon" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoBack}"
                                                        AutomationProperties.Name="{translation:Tr PreviousPage}" ToolTip.Tip="{translation:Tr PreviousPage}">
                                                    <local:Icon Data="{StaticResource Icon.ChevronLeft}" />
                                                </Button>
                                                <TextBlock Grid.Column="1" Text="{Binding PageLabel}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                                           MinWidth="48" Margin="2,0" TextAlignment="Center" TextWrapping="NoWrap" ToolTip.Tip="{Binding PageLabel}"
                                                           FontFeatures="+tnum" />
                                                <Button Grid.Column="2" Classes="page-icon" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoForward}"
                                                        AutomationProperties.Name="{translation:Tr NextPage}" ToolTip.Tip="{translation:Tr NextPage}">
                                                    <local:Icon Data="{StaticResource Icon.ChevronRight}" />
                                                </Button>
                                            </Grid>
                                            <Border Classes="pagebar-rule" IsVisible="{Binding !HasNoSearchableText}" />
                                            <Button x:Name="ReadPageTextButton" Content="{Binding PageTextAction}"
                                                    Command="{Binding TogglePageTextCommand}" IsVisible="{Binding !HasNoSearchableText}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Panel>
                        </Border>

                        <!-- Filing card and batch card -->
                        <Border Grid.Column="2" Grid.RowSpan="2" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Background="{DynamicResource Panel}">
                            <Panel>
                                <!-- Batch card -->
                                <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding HasBatchSelection}">
                                    <StackPanel Margin="20,18,16,10" Spacing="4">
                                        <TextBlock Classes="heading" Text="{Binding BatchCountLabel}" />
                                        <TextBlock Classes="description" Text="{translation:Tr BatchHelp}" />
                                    </StackPanel>
                                    <!-- No scroll viewer: hidden scroll viewers skip their template, which would detach these actions. -->
                                    <Panel Grid.Row="1" Margin="20,0">
                                        <StackPanel Spacing="16" Margin="0,4,0,12">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="field-label" Text="{translation:Tr Tags}" Margin="0" />
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsEnabled="{Binding CanWork}">
                                                    <AutoCompleteBox x:Name="BatchTagBox" Classes="tag-entry" Text="{Binding BatchTagInput, Mode=TwoWay}"
                                                                     PlaceholderText="{translation:Tr AddATag}" AutomationProperties.Name="{translation:Tr TagForTheSelectedDocuments}"
                                                                     Populating="TagBox_Populating" KeyDown="BatchTag_KeyDown" />
                                                    <Button Grid.Column="1" x:Name="ApplyBatchTagButton" Classes="secondary"
                                                            Content="{translation:Tr TagSelected}" Click="ApplyBatchTag_Click" />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Spacing="1" Margin="-8,0">
                                                <Button x:Name="RemoveBatchTagButton" Classes="action" local:Ui.Icon="{StaticResource Icon.Tag}" Content="{translation:Tr RemoveTag2}"
                                                        Click="RemoveBatchTag_Click" IsVisible="{Binding HasTaggedBatchSelection}"
                                                        IsEnabled="{Binding CanWork}" AutomationProperties.Name="{translation:Tr RemoveATagFromTheSelectedPDFs}" />
                                                <Button x:Name="EditBatchDocumentDateButton" Classes="action" local:Ui.Icon="{StaticResource Icon.Calendar}" Content="{translation:Tr DocumentDate2}"
                                                        Click="EditBatchDocumentDate_Click" IsEnabled="{Binding CanWork}"
                                                        AutomationProperties.Name="{translation:Tr EditTheDocumentDateOfTheSelectedPDFs}" />
                                                <Button x:Name="SuggestSelectedFilingButton" Classes="action" local:Ui.Icon="{StaticResource Icon.Sparkles}" Content="{translation:Tr FilingSuggestions2}"
                                                        Click="SuggestSelectedFiling_Click" IsEnabled="{Binding CanWork}"
                                                        AutomationProperties.Name="{translation:Tr FilingSuggestionsForSelectedPDFs}" />
                                                <Button x:Name="MoveSelectedPdfsButton" Classes="action" local:Ui.Icon="{StaticResource Icon.Move}" Content="{translation:Tr MovePDFs}"
                                                        Command="{Binding MoveSelectedPdfsCommand}" IsEnabled="{Binding CanWork}"
                                                        AutomationProperties.Name="{translation:Tr MoveSelectedPDFsToAFolder}" />
                                                <Button x:Name="CombinePdfsButton" Classes="action" local:Ui.Icon="{StaticResource Icon.Combine}" Content="{translation:Tr CombinePDFs2}"
                                                        Command="{Binding CombinePdfsCommand}" IsEnabled="{Binding CanWork}" />
                                                <Button x:Name="CreateSelectedOcrCopiesButton" Classes="action" local:Ui.Icon="{StaticResource Icon.Recognize}" Content="{translation:Tr CreateOCRCopies}"
                                                        Command="{Binding CreateSelectedOcrCopiesCommand}" IsEnabled="{Binding CanWork}"
                                                        AutomationProperties.Name="{translation:Tr CreateOCRCopiesOfTheSelectedPDFs}" />
                                                <Button x:Name="ExportSelectedPdfsButton" Classes="action" local:Ui.Icon="{StaticResource Icon.Share}"
                                                        Content="{translation:Tr ExportPDFs}" Command="{Binding ExportSelectedPdfsCommand}"
                                                        IsEnabled="{Binding CanWork}" AutomationProperties.Name="{translation:Tr ExportSelectedPDFs}" />
                                                <Button x:Name="ExportHouseholdBinderButton" Classes="action" local:Ui.Icon="{StaticResource Icon.Binder}" Content="{translation:Tr ExportBinder}"
                                                        Command="{Binding ExportHouseholdBinderCommand}" IsEnabled="{Binding CanWork}"
                                                        AutomationProperties.Name="{translation:Tr ExportTheSelectedPDFsAsAHouseholdBinder}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Panel>
                                    <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16">
                                        <Button x:Name="BatchReviewButton" Classes="primary" MinHeight="40" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Content="{Binding BatchReviewAction}" Command="{Binding ReviewSelectedCommand}" IsEnabled="{Binding CanWork}" />
                                    </Border>
                                </Grid>

                                <!-- Filing card -->
                                <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding ShowFilingCard}">
                                    <StackPanel Margin="20,16,16,10" Spacing="6">
                                        <!-- The heading is the title's own field: E or a click edits it here, Enter or leaving saves, Escape restores. -->
                                        <Panel>
                                            <Button x:Name="EditTitleButton" Classes="title-edit" Click="EditTitle_Click" IsEnabled="{Binding HasLibrary}"
                                                    IsVisible="{Binding !IsEditingTitle}" ToolTip.Tip="{translation:Tr ShortcutRename}"
                                                    AutomationProperties.Name="{translation:Tr ShortcutRename}">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBlock Classes="heading" Text="{Binding SelectedDocument.Title}" TextWrapping="Wrap" MaxLines="3"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Classes="key" VerticalAlignment="Top" Margin="0,3,0,0"><TextBlock Text="E" /></Border>
                                                </Grid>
                                            </Button>
                                            <TextBox x:Name="TitleEditBox" Classes="title-edit" Text="{Binding TitleDraft}" IsVisible="{Binding IsEditingTitle}"
                                                     TextWrapping="Wrap" AcceptsReturn="False" MaxLength="{x:Static core:InboxLibrary.MaximumTitleLength}"
                                                     AutomationProperties.Name="{translation:Tr DocumentTitle}" />
                                        </Panel>
                                        <Button x:Name="PdfLocationButton" Classes="path" Command="{Binding OpenDocumentFolderCommand}" Margin="0,0,8,0"
                                                ToolTip.Tip="{translation:Tr OpenContainingFolder}" AutomationProperties.Name="{translation:Tr OpenPDFSContainingFolder}">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                <local:Icon Data="{StaticResource Icon.Folder}" Width="14" Height="14" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Classes="mono" FontWeight="Normal" Text="{Binding SelectedDocument.RelativePath}" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>

                                    <ScrollViewer Grid.Row="1" x:Name="DocumentActionsScroll" HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto" Focusable="True" Padding="20,0,16,0"
                                                  AutomationProperties.Name="{translation:Tr DocumentActions}">
                                        <StackPanel Spacing="18" Margin="0,4,0,16">
                                            <!-- Suggestions: a callout with the graphite tile; the chips below stay dashed until accepted. -->
                                            <Border Classes="callout" IsVisible="{Binding HasSuggestions}">
                                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                                    <Border Classes="tile callout-tile" VerticalAlignment="Top">
                                                        <local:Icon Data="{StaticResource Icon.Sparkles}" Width="18" Height="18" StrokeWidth="1.7"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SuggestionSummary}" FontSize="15" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding SuggestionReason}" FontSize="13" LineHeight="18" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Button Grid.Row="1" Grid.Column="1" x:Name="AcceptSuggestionsButton" Classes="secondary small" HorizontalAlignment="Left"
                                                            Margin="0,10,0,0" Command="{Binding AcceptSuggestionsCommand}" IsEnabled="{Binding CanWork}"
                                                            AutomationProperties.Name="{translation:Tr AcceptAll}" ToolTip.Tip="{translation:Tr AcceptAllTip}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{translation:Tr AcceptAll}" VerticalAlignment="Center" />
                                                            <Border Classes="key"><TextBlock Text="A" /></Border>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <Grid ColumnDefinitions="84,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                                                <TextBlock Classes="field-label" Text="{translation:Tr MetaDateKind}" />
                                                <!--
                                                    The date is typed where it is shown, as the interface writes it, with its calendar at the left.
                                                    While it is empty the dashed suggestion sits inside it (or the D keycap when there is none),
                                                    and a saved date has a clear button. Enter or leaving saves; Escape restores.
                                                -->
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBox x:Name="DocumentDateField" Classes="date-field" Classes.invalid="{Binding HasDocumentDateError}"
                                                             Text="{Binding DocumentDateText}" PlaceholderText="{Binding DocumentDatePlaceholder}"
                                                             IsEnabled="{Binding HasLibrary}" MaxLength="40" ToolTip.Tip="{translation:Tr DocumentDateFieldTip}"
                                                             AutomationProperties.Name="{translation:Tr EditDocumentDate}">
                                                        <TextBox.InnerLeftContent>
                                                            <Button x:Name="DocumentDateCalendarButton" Classes="field-glyph" Click="OpenDocumentDateCalendar_Click" Margin="2,0,0,0"
                                                                    IsTabStop="False" ToolTip.Tip="{translation:Tr ChooseADate}"
                                                                    AutomationProperties.Name="{translation:Tr ChooseADate}">
                                                                <local:Icon Data="{StaticResource Icon.Calendar}" Width="16" Height="16" />
                                                            </Button>
                                                        </TextBox.InnerLeftContent>
                                                        <TextBox.InnerRightContent>
                                                            <Panel VerticalAlignment="Center" Margin="0,0,3,0">
                                                                <Button x:Name="SuggestedDateButton" Classes="suggested" IsVisible="{Binding ShowSuggestedDateInField}"
                                                                        IsTabStop="False" Command="{Binding AcceptSuggestedDateCommand}"
                                                                        ToolTip.Tip="{translation:Tr SuggestedDateTip}" AutomationProperties.Name="{Binding SuggestedDateLabel}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                                        <local:Icon Data="{StaticResource Icon.Plus}" Width="13" Height="13" StrokeWidth="1.8" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding SuggestedDateLabel}" VerticalAlignment="Center" FontFeatures="+tnum" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button x:Name="ClearDocumentDateButton" Classes="field-glyph" IsVisible="{Binding HasSelectedDocumentDate}"
                                                                        IsTabStop="False" Command="{Binding ClearDocumentDateCommand}"
                                                                        ToolTip.Tip="{translation:Tr ClearTheDate}" AutomationProperties.Name="{translation:Tr ClearTheDate}">
                                                                    <local:Icon Data="{StaticResource Icon.Close}" Width="14" Height="14" StrokeWidth="1.8" />
                                                                </Button>
                                                                <Border Classes="key field-key" IsVisible="{Binding ShowDateKeycap}"><TextBlock Text="D" /></Border>
                                                            </Panel>
                                                        </TextBox.InnerRightContent>
                                                    </TextBox>
                                                    <TextBlock x:Name="DocumentDateError" Classes="validation" Text="{Binding DocumentDateError}"
                                                               IsVisible="{Binding HasDocumentDateError}" AutomationProperties.LiveSetting="Polite" />
                                                    <!--
                                                        The calendar is a popover drawn in the window, 4 px under the field and flush with its right
                                                        edge, which the card keeps near the window's. A popup clips to its own bounds, so the popover
                                                        keeps a transparent margin for its shadow to fall in: 56 px below, where the shadow reaches
                                                        furthest, 32 to the left, and 12 to the right and 4 above for its hairline and near shadow. The
                                                        popup places the popover itself, margin aside, against the field. Its week starts on Monday.
                                                    -->
                                                    <Popup x:Name="DocumentDatePicker" Placement="BottomEdgeAlignedRight" IsLightDismissEnabled="True"
                                                           ShouldUseOverlayLayer="True" VerticalOffset="4">
                                                        <Border Classes="popover" Padding="6" Margin="32,4,12,56">
                                                            <Calendar x:Name="DocumentDateCalendar" Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                                                      FirstDayOfWeek="Monday" />
                                                        </Border>
                                                    </Popup>
                                                </StackPanel>

                                                <TextBlock Grid.Row="1" Classes="field-label" Text="{translation:Tr Tags}" Margin="0,6,8,0" />
                                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8">
                                                    <ItemsControl ItemsSource="{Binding SelectedTagChips}" IsVisible="{Binding HasSelectedTagChips}">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="local:TagChip">
                                                                <Button Classes="chip" Click="RemoveTag_Click" Padding="10,0,8,0"
                                                                        AutomationProperties.Name="{Binding Label, StringFormat={translation:Tr RemoveTagAutomationFormat}}" ToolTip.Tip="{Binding Label}">
                                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                                                        <Ellipse Width="7" Height="7" Fill="{Binding Dot}" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                        <local:Icon Grid.Column="2" Data="{StaticResource Icon.Close}" Width="13" Height="13" StrokeWidth="1.8"
                                                                                    Foreground="{DynamicResource Fg3}" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ItemsControl ItemsSource="{Binding SuggestedTags}" IsVisible="{Binding HasSuggestedTags}">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="local:SuggestedTag">
                                                                <Button Classes="suggested" Command="{Binding $parent[Window].((local:InboxViewModel)DataContext).AcceptSuggestedTagCommand}"
                                                                        CommandParameter="{Binding}" ToolTip.Tip="{Binding Reason}"
                                                                        AutomationProperties.Name="{Binding Label, StringFormat={translation:Tr SuggestedTagAutomationFormat}}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <local:Icon Data="{StaticResource Icon.Plus}" Width="13" Height="13" StrokeWidth="1.8" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <!--
                                                        One Enter adds the typed tag, or the suggestion chosen with the arrow keys; T comes here. The T
                                                        keycap stands in the card's keycap column, under D and E; once something is typed the small Add
                                                        button takes its place for the mouse, without taking the keyboard. The title, the date and the tag
                                                        field stay open while Plico works in the background.
                                                    -->
                                                    <AutoCompleteBox x:Name="TagBox" Classes="tag-entry" Text="{Binding TagInput, Mode=TwoWay}" IsEnabled="{Binding HasLibrary}"
                                                                     PlaceholderText="{translation:Tr AddATag}" AutomationProperties.Name="{translation:Tr TagForThisDocument}"
                                                                     Populating="TagBox_Populating">
                                                        <AutoCompleteBox.InnerRightContent>
                                                            <Panel VerticalAlignment="Center" Margin="0,0,3,0">
                                                                <Border Classes="key field-key" IsVisible="{Binding TagInput, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                                    <TextBlock Text="T" />
                                                                </Border>
                                                                <Button x:Name="AddTagButton" Classes="field-glyph" Command="{Binding AddTagCommand}" Focusable="False" Margin="0"
                                                                        IsVisible="{Binding TagInput, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                        AutomationProperties.Name="{translation:Tr AddTag}" ToolTip.Tip="{translation:Tr AddTag}">
                                                                    <local:Icon Data="{StaticResource Icon.Plus}" Width="15" Height="15" StrokeWidth="1.8" />
                                                                </Button>
                                                            </Panel>
                                                        </AutoCompleteBox.InnerRightContent>
                                                    </AutoCompleteBox>
                                                </StackPanel>

                                                <TextBlock Grid.Row="2" Classes="field-label" Text="{translation:Tr ReminderField}" />
                                                <Button Grid.Row="2" Grid.Column="1" x:Name="EditDeadlinesButton" Classes="field empty" Command="{Binding EditDeadlinesCommand}"
                                                        IsEnabled="{Binding CanWork}" AutomationProperties.Name="{translation:Tr ReminderField}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <local:Icon Data="{StaticResource Icon.Bell}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{translation:Tr RemindMe}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>

                                                <TextBlock Grid.Row="3" Classes="field-label" Text="{translation:Tr FieldsField}" />
                                                <Button Grid.Row="3" Grid.Column="1" x:Name="EditMetadataButton" Classes="field empty" Command="{Binding EditMetadataCommand}"
                                                        IsEnabled="{Binding CanWork}" AutomationProperties.Name="{translation:Tr FieldsField}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <local:Icon Data="{StaticResource Icon.Plus}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{translation:Tr AddDetails}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                                                <Grid ColumnDefinitions="84,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="5">
                                                    <TextBlock Classes="fact-label" Text="{translation:Tr StatusField}" />
                                                    <TextBlock Grid.Column="1" Classes="fact" Text="{Binding SelectedReviewState}" />
                                                    <TextBlock Grid.Row="1" Classes="fact-label" Text="{translation:Tr Pages}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="fact" Text="{Binding SelectedPagesLabel}" FontFeatures="+tnum" />
                                                    <TextBlock Grid.Row="2" Classes="fact-label" Text="{translation:Tr AddedField}" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="fact" Text="{Binding SelectedAddedLabel}" FontFeatures="+tnum" />
                                                    <TextBlock Grid.Row="3" Classes="fact-label" Text="{translation:Tr MetaTextKind}" />
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="fact" Text="{Binding SelectedTextState}" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Spacing="1" Margin="-8,0,0,0">
                                                <TextBlock Classes="section" Text="{translation:Tr ActionsSection}" Margin="8,0,0,6" />
                                                <Button x:Name="PdfToolsButton" Classes="action" local:Ui.Icon="{StaticResource Icon.Pages}" Content="{translation:Tr PdfToolsMenu}"
                                                        IsEnabled="{Binding CanWork}">
                                                    <Button.Flyout>
                                                        <MenuFlyout Placement="LeftEdgeAlignedTop">
                                                            <MenuItem x:Name="EditPdfPagesItem" Header="{translation:Tr EditPages}" Command="{Binding EditPdfPagesCommand}" />
                                                            <MenuItem x:Name="PdfVersionsItem" Header="{translation:Tr VersionHistoryHeading}" Command="{Binding ShowPdfVersionsCommand}" />
                                                            <Separator />
                                                            <MenuItem Header="{translation:Tr ExportBinder}" Command="{Binding ExportHouseholdBinderCommand}" />
                                                            <MenuItem Header="{translation:Tr ExportRedactedPDF}" Command="{Binding ExportRedactedPdfCommand}" />
                                                            <MenuItem Header="{translation:Tr ExportStampedPDF}" Command="{Binding ExportStampedPdfCommand}" />
                                                            <MenuItem Header="{translation:Tr ExportCompressedPDF}" Command="{Binding ExportCompressedPdfCommand}" />
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                                <Button x:Name="RotatePdfPagesButton" Classes="action" local:Ui.Icon="{StaticResource Icon.RotateRight}" Content="{translation:Tr RotatePages2}"
                                                        Command="{Binding RotatePdfPagesCommand}" IsEnabled="{Binding CanWork}" />
                                                <Button x:Name="ExtractPdfPagesButton" Classes="action" local:Ui.Icon="{StaticResource Icon.Split}" Content="{translation:Tr ExtractPages}"
                                                        Command="{Binding ExtractPdfPagesCommand}" IsEnabled="{Binding CanWork}" IsVisible="{Binding HasMultiplePages}" />
                                                <Button x:Name="MovePdfButton" Classes="action" local:Ui.Icon="{StaticResource Icon.Move}" Content="{translation:Tr MoveToFolder}"
                                                        Command="{Binding MovePdfCommand}" IsEnabled="{Binding CanWork}" />
                                                <Button x:Name="ExportPdfButton" Classes="action" local:Ui.Icon="{StaticResource Icon.Share}" Content="{translation:Tr ExportPDF2}"
                                                        Command="{Binding ExportPdfCommand}" IsEnabled="{Binding CanWork}" />
                                                <Button x:Name="CreateSearchableCopyButton" Classes="action" local:Ui.Icon="{StaticResource Icon.Recognize}" Content="{Binding SearchableCopyAction}"
                                                        Command="{Binding CreateSearchableCopyCommand}" IsEnabled="{Binding CanWork}"
                                                        ToolTip.Tip="{translation:Tr CreateASeparatePDFUsingTheSelectedOCRLanguage}" />
                                                <Button x:Name="SuggestFilingButton" Classes="action" local:Ui.Icon="{StaticResource Icon.Sparkles}" Content="{translation:Tr FilingSuggestions2}"
                                                        Command="{Binding SuggestFilingCommand}" IsEnabled="{Binding CanWork}" />
                                                <Button x:Name="FindRelatedButton" Classes="action" local:Ui.Icon="{StaticResource Icon.Link}" Content="{translation:Tr RelatedWindow}"
                                                        Command="{Binding FindRelatedCommand}" IsEnabled="{Binding CanWork}"
                                                        AutomationProperties.Name="{translation:Tr FindRelatedDocuments}" />
                                                <Button x:Name="SuggestLocalFilingButton" Classes="action" local:Ui.Icon="{StaticResource Icon.Chat}" Content="{translation:Tr LocalFilingAction}"
                                                        Command="{Binding SuggestLocalFilingCommand}" IsVisible="{Binding HasLocalChat}" IsEnabled="{Binding CanWork}"
                                                        AutomationProperties.Name="{translation:Tr AskLocalModelForFilingSuggestions}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- Pinned outside the scroll: Mark reviewed fills the width, Trash beside it. -->
                                    <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Button x:Name="ReviewButton" Classes="primary" MinHeight="40" Padding="10,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                    Command="{Binding ToggleReviewCommand}" Click="ReviewButton_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding ReviewAction}" VerticalAlignment="Center" />
                                                    <Border Classes="key"><TextBlock Text="R" /></Border>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" x:Name="TrashDocumentButton" Classes="secondary" Width="40" Height="40" Padding="0"
                                                    HorizontalContentAlignment="Center" Command="{Binding TrashDocumentCommand}" IsEnabled="{Binding CanWork}"
                                                    ToolTip.Tip="{translation:Tr MoveTheOpenPDFToTrashXInTheResultsList}" AutomationProperties.Name="{translation:Tr TrashNext}">
                                                <local:Icon Data="{StaticResource Icon.Trash}" Width="18" Height="18" StrokeWidth="1.7" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Panel>
                        </Border>

                        <!-- Inbox clear and the welcome page -->
                        <Border Grid.ColumnSpan="3" Grid.RowSpan="2" Background="{DynamicResource Panel}" IsVisible="{Binding ShowInboxZero}" ZIndex="2">
                            <Panel>
                                <Panel IsVisible="{Binding ShowInboxClear}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" Margin="24">
                                    <Rectangle Classes="dashed-frame" />
                                    <StackPanel Classes="empty" Margin="28,36">
                                        <Border Classes="tile empty-tile">
                                            <local:Icon Data="{StaticResource Icon.Inbox}" Width="20" Height="20" StrokeWidth="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Classes="empty-title" Text="{translation:Tr InboxClear}" />
                                        <TextBlock Classes="empty-text" Text="{Binding ZeroStateDetail}" />
                                        <Panel HorizontalAlignment="Center" Margin="0,12,0,0">
                                            <Button Classes="secondary" Content="{translation:Tr AllDocuments}" Command="{Binding ShowAllCommand}" IsVisible="{Binding !HasDueReminders}" />
                                            <Button Classes="secondary" Content="{translation:Tr Upcoming}" Command="{Binding RemindersCommand}" IsVisible="{Binding HasDueReminders}" />
                                        </Panel>
                                    </StackPanel>
                                </Panel>

                                <ScrollViewer IsVisible="{Binding ShowWelcome}" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="WelcomePage" Margin="44,34,44,20" MaxWidth="832" HorizontalAlignment="Left" Spacing="16">
                                        <!-- The hero: the graphite tile, a soft light at 78 % 40 %, the welcome and the two ways in. -->
                                        <Border CornerRadius="{DynamicResource RadiusHero}" Background="{DynamicResource Tile}" BoxShadow="inset 0 1 0 0 #24FFFFFF" ClipToBounds="True">
                                            <Panel>
                                                <Border IsHitTestVisible="False">
                                                    <Border.Background>
                                                        <RadialGradientBrush Center="78%,40%" GradientOrigin="78%,40%" RadiusX="42%" RadiusY="110%">
                                                            <GradientStop Offset="0" Color="#2EFFFFFF" />
                                                            <GradientStop Offset="0.55" Color="#0AFFFFFF" />
                                                            <GradientStop Offset="1" Color="#00FFFFFF" />
                                                        </RadialGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Grid ColumnDefinitions="*,Auto" Margin="32,30">
                                                    <StackPanel Spacing="10" VerticalAlignment="Center">
                                                        <TextBlock Text="{translation:Tr WelcomeTitle}" FontSize="30" FontWeight="Bold" LetterSpacing="-0.54"
                                                                   Foreground="{DynamicResource TileFg}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="1" />
                                                        <TextBlock Text="{x:Static local:PlatformText.WelcomeLede}" FontSize="16" LineHeight="24"
                                                                   Foreground="{DynamicResource TileFg2}" TextWrapping="Wrap" />
                                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
                                                            <Button x:Name="WelcomeAddFilesButton" Classes="inverse large with-icon" local:Ui.Icon="{StaticResource Icon.Plus}" Content="{translation:Tr AddFiles}"
                                                                    Command="{Binding AddFilesCommand}" IsEnabled="{Binding CanWork}" />
                                                            <Button x:Name="WelcomeScanButton" Classes="inverse-ghost large with-icon" local:Ui.Icon="{StaticResource Icon.ScanFrame}" Content="{translation:Tr ScanPaper}"
                                                                    Command="{Binding ScanCommand}" IsEnabled="{Binding CanWork}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Panel Grid.Column="1" Classes="hero-art" Width="150" Margin="28,0,10,0" VerticalAlignment="Center">
                                                        <Ellipse Width="150" Height="150" IsHitTestVisible="False">
                                                            <Ellipse.Fill>
                                                                <RadialGradientBrush>
                                                                    <GradientStop Offset="0" Color="#33FFFFFF" />
                                                                    <GradientStop Offset="1" Color="#00FFFFFF" />
                                                                </RadialGradientBrush>
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                        <Path Data="{StaticResource Mark.Full}" Fill="{DynamicResource TileFg}" Stretch="Uniform" Width="96"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Panel>
                                                </Grid>
                                            </Panel>
                                        </Border>

                                        <!-- Your library, then two more ways in, as an Onda row group. -->
                                        <Border Classes="group">
                                            <StackPanel>
                                                <Grid Classes="welcome-row" ColumnDefinitions="Auto,*,Auto">
                                                    <Border Classes="row-tile"><local:Icon Data="{StaticResource Icon.Folder}" /></Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Classes="row-title" Text="{translation:Tr YourLibrary}" />
                                                        <TextBlock Classes="row-help" Text="{Binding FriendlyLibraryPath}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding LibraryPath}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Classes="secondary" Content="{translation:Tr ChangeEllipsis}" Command="{Binding ChooseLibraryCommand}"
                                                            IsEnabled="{Binding IsIdle}" VerticalAlignment="Center" />
                                                </Grid>
                                                <Separator />
                                                <Button Classes="group-row" Command="{Binding StartFolderWatchCommand}" IsEnabled="{Binding CanStartFolderWatch}"
                                                        AutomationProperties.Name="{translation:Tr WatchAFolderTitle}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                                        <Border Classes="row-tile"><local:Icon Data="{StaticResource Icon.Watch}" /></Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Classes="row-title" Text="{translation:Tr WatchAFolderTitle}" />
                                                            <TextBlock Classes="row-help" Text="{translation:Tr WayWatch}" />
                                                        </StackPanel>
                                                        <local:Icon Grid.Column="2" Data="{StaticResource Icon.ChevronRight}" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                                <Separator />
                                                <Button Classes="group-row" IsEnabled="{Binding CanWork}" AutomationProperties.Name="{translation:Tr WayMoveTitle}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                                        <Border Classes="row-tile"><local:Icon Data="{StaticResource Icon.Upload}" /></Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Classes="row-title" Text="{translation:Tr WayMoveTitle}" />
                                                            <TextBlock Classes="row-help" Text="{translation:Tr WayMove}" />
                                                        </StackPanel>
                                                        <local:Icon Grid.Column="2" Data="{StaticResource Icon.ChevronRight}" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <Button.Flyout>
                                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                            <MenuItem Header="{translation:Tr MigratePaperlessFolder}" Command="{Binding MigratePaperlessFolderCommand}" />
                                                            <MenuItem Header="{translation:Tr MigratePaperlessZip}" Command="{Binding MigratePaperlessZipCommand}" />
                                                            <MenuItem Header="{translation:Tr MigrateEvernote}" Command="{Binding MigrateEvernoteCommand}" />
                                                            <MenuItem Header="{translation:Tr MigrateMariner}" Command="{Binding MigrateMarinerCommand}" />
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- Privacy, stated once, as a fact. -->
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="2,0,0,0">
                                            <local:Icon Data="{StaticResource Icon.Lock}" Foreground="{DynamicResource Fg2}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <TextBlock Grid.Column="1" FontSize="14" LineHeight="20" TextWrapping="Wrap">
                                                <Run Text="{translation:Tr PrivateByDefault}" FontWeight="SemiBold" />
                                                <Run Text=" " />
                                                <Run Text="{x:Static local:PlatformText.PrivacyLine}" Foreground="{DynamicResource Fg2}" />
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Panel>
                        </Border>

                        <!--
                            The ink toast rises from the bottom of the page canvas, centred over the desk and 16 px above the
                            page bar, so it never covers the filing card where Mark reviewed lives. It carries the latest
                            message and at most one action; progress and attention live on the sidebar's status card.
                        -->
                        <Border Grid.Column="1" Grid.RowSpan="2" x:Name="Toast" Classes="toast" Classes.low="{Binding !HasSelection}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                IsVisible="False" ZIndex="10">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                <Panel Width="18" Height="18" VerticalAlignment="Top" Margin="0,3,0,0">
                                    <local:Icon Data="{StaticResource Icon.Check}" Width="18" Height="18" StrokeWidth="1.8" Foreground="{DynamicResource OnFg}"
                                                IsVisible="{Binding !StatusIsProblem}" />
                                    <local:Icon Data="{StaticResource Icon.AlertCircle}" Width="18" Height="18" StrokeWidth="1.8" Foreground="{DynamicResource ToastAlert}"
                                                IsVisible="{Binding StatusIsProblem}" />
                                </Panel>
                                <!-- The title and body are never cut; the live region speaks the whole message of record. -->
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,3">
                                    <TextBlock Classes="toast-title" Text="{Binding ToastTitle}"
                                               AutomationProperties.Name="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock Classes="toast-body" Text="{Binding ToastBody}" IsVisible="{Binding HasToastBody}" />
                                </StackPanel>
                                <Panel Grid.Column="2" VerticalAlignment="Center">
                                    <!--
                                        A click on Undo leaves the keyboard where it is. Taking it would save a field being typed in first, and that
                                        edit would become the offer the click then reverses; Ctrl+Z is Undo from the keyboard.
                                    -->
                                    <Button x:Name="UndoButton" Classes="toast-action" Content="{translation:Tr UndoAction}" Command="{Binding UndoCommand}" Focusable="False"
                                            IsVisible="{Binding ToastOffersUndo}" IsEnabled="{Binding CanWork}" ToolTip.Tip="{Binding UndoLabel}" />
                                    <Button x:Name="OpenBackupFolderButton" Classes="toast-action" Content="{translation:Tr OpenBackup}"
                                            Command="{Binding OpenBackupFolderCommand}" IsVisible="{Binding ToastOffersBackup}" IsEnabled="{Binding CanWork}" />
                                    <Button x:Name="OpenExportFolderButton" Classes="toast-action" Content="{translation:Tr OpenExport}"
                                            Command="{Binding OpenExportFolderCommand}" IsVisible="{Binding ToastOffersExport}" IsEnabled="{Binding CanWork}" />
                                    <Button x:Name="OcrCopyBatchResultsButton" Classes="toast-action" Content="{translation:Tr OCRResults}"
                                            Command="{Binding InspectOcrCopyBatchResultsCommand}" IsVisible="{Binding ToastOffersOcrResults}" IsEnabled="{Binding CanWork}" />
                                </Panel>
                                <Button Grid.Column="3" x:Name="CloseToastButton" Classes="toast-close" Click="CloseToast_Click"
                                        AutomationProperties.Name="{translation:Tr Close}" ToolTip.Tip="{translation:Tr Close}">
                                    <local:Icon Data="{StaticResource Icon.Close}" Width="16" Height="16" StrokeWidth="1.8" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Motion layer for the review animation. Never takes input. -->
        <Canvas x:Name="MotionLayer" IsHitTestVisible="False" />

        <!-- Drop target: an 88 px graphite tile with the white mark, one title and where new documents go. -->
        <Border x:Name="DropTarget" IsVisible="False" IsHitTestVisible="False" Classes="overlay-scrim">
            <Border Classes="popover" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="44,36" MinWidth="380">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <Border Classes="tile hero-tile" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Path Data="{StaticResource Mark.Full}" Fill="{DynamicResource TileFg}" Stretch="Uniform" Width="46"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Classes="heading" Text="{translation:Tr DropToAddToInbox}" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Classes="description" HorizontalAlignment="Center" TextAlignment="Center"
                               Text="{Binding IntakeFolderLabel, StringFormat={translation:Tr DropDestinationFormat}}" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Command palette: a raised sheet 12 % from the top, with the query, the matching commands and keycap hints. -->
        <Border x:Name="PaletteOverlay" IsVisible="False" Classes="overlay-scrim" KeyboardNavigation.TabNavigation="Cycle" PointerPressed="Overlay_PointerPressed">
            <Grid RowDefinitions="12*,88*">
                <Border Grid.Row="1" Classes="palette" HorizontalAlignment="Center" VerticalAlignment="Top" Width="560" MaxHeight="480"
                        PointerPressed="OverlayContent_PointerPressed">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBox x:Name="PaletteQuery" Classes="palette-query" PlaceholderText="{translation:Tr PalettePlaceholder}" KeyDown="PaletteQuery_KeyDown"
                                 AutomationProperties.Name="{translation:Tr Commands}">
                            <TextBox.InnerLeftContent>
                                <local:Icon Data="{StaticResource Icon.Search}" Width="18" Height="18" Margin="16,0,6,0" Foreground="{DynamicResource Fg3}" />
                            </TextBox.InnerLeftContent>
                        </TextBox>
                        <ListBox Grid.Row="1" x:Name="PaletteList" Classes="plain palette-list" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                                 Padding="6" DoubleTapped="PaletteList_DoubleTapped" KeyDown="PaletteList_KeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:PaletteCommand">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <local:Icon Data="{Binding Icon}" Foreground="{DynamicResource Fg2}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Group}" Classes="meta" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Keys}" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String"><Border Classes="key"><TextBlock Text="{Binding}" /></Border></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="1" x:Name="PaletteEmpty" Text="{translation:Tr PaletteEmpty}" Foreground="{DynamicResource Fg2}" IsVisible="False"
                                   HorizontalAlignment="Center" Margin="0,24" />
                        <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,10">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="6"><Border Classes="key"><TextBlock Text="↑↓" /></Border><TextBlock Classes="caption" Text="{translation:Tr PaletteMove}" VerticalAlignment="Center" /></StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6"><Border Classes="key"><TextBlock Text="Enter" /></Border><TextBlock Classes="caption" Text="{translation:Tr PaletteRun}" VerticalAlignment="Center" /></StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6"><Border Classes="key"><TextBlock Text="Esc" /></Border><TextBlock Classes="caption" Text="{translation:Tr Close}" VerticalAlignment="Center" /></StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Keyboard shortcuts sheet: the palette's surface, every shortcut drawn as keycaps. -->
        <Border x:Name="ShortcutsOverlay" IsVisible="False" Classes="overlay-scrim" KeyboardNavigation.TabNavigation="Cycle" PointerPressed="Overlay_PointerPressed">
            <Border Classes="palette" HorizontalAlignment="Center" VerticalAlignment="Center" Width="660" MaxHeight="580"
                    PointerPressed="OverlayContent_PointerPressed">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" Margin="24,18,14,8">
                        <TextBlock Classes="heading" Text="{translation:Tr KeyboardShortcuts}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" x:Name="CloseShortcutsButton" Classes="icon" Click="CloseOverlays_Click" AutomationProperties.Name="{translation:Tr Close}">
                            <local:Icon Data="{StaticResource Icon.Close}" Width="18" Height="18" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="ShortcutsGrid" ColumnDefinitions="*,*" ColumnSpacing="32" Margin="24,4,24,24" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>
    </Panel>
</Window>
