<Window xmlns="https://github.com/avaloniaui"
        xmlns:translation="using:Plico.Desktop"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Plico.Desktop"
        xmlns:core="using:Plico.Core"
        x:Class="Plico.Desktop.MainWindow" x:DataType="local:InboxViewModel"
        Title="Plico" Width="1180" Height="760" MinWidth="900" MinHeight="590"
        FontFamily="{StaticResource InterFont}" Foreground="{DynamicResource WorkspaceInk}" Background="{DynamicResource WorkspaceSurface}"
        DragDrop.AllowDrop="True" DragDrop.DragEnter="Files_DragOver" DragDrop.DragOver="Files_DragOver"
        DragDrop.DragLeave="Files_DragLeave" DragDrop.Drop="Files_Dropped"
        WindowStartupLocation="CenterScreen">
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource PrimarySurface}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryHoverSurface}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{DynamicResource ControlSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource ControlInk}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlOutline}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource ControlHoverInk}" />
        </Style>
        <Style Selector="Button.rail">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource RailInk}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.rail:pointerover /template/ ContentPresenter, Button.rail.current /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RailActiveSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource RailActiveInk}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource MutedInk}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="AutoCompleteBox.tag-entry">
            <Setter Property="FilterMode" Value="None" />
            <Setter Property="MaxLength" Value="48" />
            <Setter Property="MaxDropDownHeight" Value="196" />
        </Style>
        <Style Selector="AutoCompleteBox.tag-entry /template/ Popup#PART_Popup">
            <Setter Property="ShouldUseOverlayLayer" Value="True" />
            <Setter Property="OverlayDismissEventPassThrough" Value="True" />
        </Style>
        <Style Selector="Button.document-location">
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.document-location:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TagSurface}" />
        </Style>
        <Style Selector="ScrollViewer.pdf-preview">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="ScrollViewer.pdf-preview.fitWidth">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style Selector="ScrollViewer.pdf-preview.zoomed">
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style Selector="ToggleButton.preview-thumbnails">
            <Setter Property="Background" Value="{DynamicResource ControlSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource ControlInk}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlOutline}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ToggleButton.preview-thumbnails:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectionSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource WorkspaceInk}" />
        </Style>
        <Style Selector="WrapPanel.document-actions > Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Margin" Value="0,0,5,3" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="204,*">
        <Border Background="{DynamicResource RailSurface}" Padding="17,21,17,16">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                <StackPanel Orientation="Horizontal" Spacing="11" Margin="5,0">
                    <Border Width="34" Height="34" Background="{DynamicResource BadgeSurface}" CornerRadius="9">
                        <PathIcon Width="20" Height="20" Foreground="{DynamicResource BadgeInk}"
                                  Data="M4,3 L13,3 L19,9 L19,21 L4,21 Z M13,3 L13,9 L19,9 M7,13 L16,13 M7,17 L16,17" />
                    </Border>
                    <TextBlock Text="Plico" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource BrandInk}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="3">
                    <Button x:Name="InboxButton" Classes="rail" Classes.current="{Binding InboxSelected}"
                            Command="{Binding ShowInboxCommand}" HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="{Binding InboxAutomationName}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{translation:Tr Inbox}" />
                            <TextBlock Grid.Column="1" x:Name="InboxReviewCount" Text="{Binding InboxCount}" IsVisible="{Binding HasInboxCount}"
                                       Foreground="{DynamicResource RailCountInk}" />
                        </Grid>
                    </Button>
                    <Button x:Name="AllDocumentsButton" Classes="rail" Classes.current="{Binding AllSelected}"
                            Command="{Binding ShowAllCommand}" Content="{translation:Tr AllDocuments}" />
                    <Button x:Name="WithoutTextButton" Classes="rail" Classes.current="{Binding WithoutTextSelected}"
                            Command="{Binding ShowWithoutTextCommand}" Content="{translation:Tr WithoutText}"
                            ToolTip.Tip="{translation:Tr FindPDFsWithoutSearchableText}" />
                </StackPanel>
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6" IsVisible="{Binding HasSavedSearches}">
                            <TextBlock Text="{translation:Tr SavedSearches}" Foreground="{DynamicResource RailSectionInk}" FontSize="12" FontWeight="SemiBold" Margin="12,0,0,0" />
                            <ItemsControl x:Name="SavedSearchList" ItemsSource="{Binding SavedSearches}" IsEnabled="{Binding CanWork}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:SavedSearch">
                                        <Button Classes="rail" Click="OpenSavedSearch_Click" ToolTip.Tip="{Binding Query}"
                                                AutomationProperties.Name="{Binding Name}">
                                            <TextBlock Text="{Binding Name}" MaxWidth="138" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Spacing="6" IsVisible="{Binding HasTags}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{translation:Tr Tags}" Foreground="{DynamicResource RailSectionInk}" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                <Button Grid.Column="1" x:Name="RenameActiveTagButton" Classes="rail" Content="{translation:Tr Rename}"
                                        Padding="7,3" IsVisible="{Binding HasActiveTag}" IsEnabled="{Binding CanWork}"
                                        Command="{Binding RenameActiveTagCommand}" AutomationProperties.Name="{translation:Tr RenameSelectedTag}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button Classes="rail" Click="FilterTag_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="9">
                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource RailTagMarker}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding}" MaxWidth="130" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="3" Spacing="3">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,3">
                        <TextBlock Text="{translation:Tr Library}" Foreground="{DynamicResource RailSectionInk}" FontSize="12" FontWeight="SemiBold"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" x:Name="OpenTrashButton" Classes="rail" Content="{translation:Tr Trash2}" Command="{Binding OpenTrashCommand}"
                                IsEnabled="{Binding CanWork}" Padding="6,0" FontSize="12" MinHeight="0" />
                    </Grid>
                    <Button Classes="rail" Command="{Binding ChooseLibraryCommand}" IsEnabled="{Binding IsIdle}"
                            ToolTip.Tip="{Binding LibraryPath}" AutomationProperties.Name="{translation:Tr ChooseLibraryFolder}">
                        <TextBlock Text="{Binding LibraryName}" MaxWidth="142" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                    </Button>
                    <Button Classes="rail" Content="{translation:Tr ShowPDFFolder}" Command="{Binding OpenPdfFolderCommand}" IsEnabled="{Binding HasLibrary}" />
                    <Button x:Name="IntakeFolderButton" Classes="rail" Command="{Binding ChooseIntakeFolderCommand}"
                            IsEnabled="{Binding CanWork}" ToolTip.Tip="{Binding IntakeFolderLabel}" AutomationProperties.Name="{translation:Tr ChooseIntakeFolder}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{translation:Tr IntakeFolder}" />
                            <TextBlock Text="{Binding IntakeFolderLabel}" IsVisible="{Binding HasCustomIntakeFolder}"
                                       Foreground="{DynamicResource SelectionOutline}" FontSize="12" MaxWidth="142" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <CheckBox x:Name="IncludeWatchedScansCheckBox" Content="{translation:Tr IncludeWatchedScans}" FontSize="13"
                              Foreground="{DynamicResource DropSurface}" Margin="12,0,0,0" IsVisible="{Binding HasCustomIntakeFolder}"
                              IsEnabled="{Binding CanWork}" IsChecked="{Binding IncludeWatchedScans, Mode=TwoWay}"
                              ToolTip.Tip="{translation:Tr FileScansFromTheWatchedFolderInThisIntakeFolder}" />
                    <Button x:Name="LibraryToolsButton" Classes="rail" Content="{translation:Tr LibraryTools}" IsEnabled="{Binding CanWork}">
                        <Button.Flyout>
                            <MenuFlyout Placement="RightEdgeAlignedTop">
                                <MenuItem Header="{translation:Tr TagRules2}" Command="{Binding ManageFilingRulesCommand}" />
                                <MenuItem Header="{translation:Tr CheckLibraryIntegrity}" Command="{Binding CheckIntegrityCommand}" />
                                <MenuItem Header="{translation:Tr ExportLibraryMetadataJSON}" Command="{Binding ExportMetadataCommand}" />
                                <MenuItem Header="{translation:Tr ExportSearchResultsCSV}" Command="{Binding ExportSearchCsvCommand}" />
                                <Separator />
                                <MenuItem Header="{translation:Tr RefreshIndex}" Command="{Binding RefreshIndexCommand}" />
                                <MenuItem Header="{translation:Tr ImportPasswordProtectedPDF2}" Command="{Binding ImportProtectedPdfCommand}" />
                                <MenuItem Header="{translation:Tr Appearance2}" Command="{Binding ShowAppearanceCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="BackUpLibraryButton" Classes="rail" Content="{translation:Tr BackUpLibrary}"
                            Command="{Binding BackUpLibraryCommand}" IsEnabled="{Binding CanWork}" />
                    <Button x:Name="StartFolderWatchButton" Classes="rail" Content="{translation:Tr WatchAFolder}"
                            Command="{Binding StartFolderWatchCommand}" IsVisible="{Binding !IsWatchingFolder}"
                            IsEnabled="{Binding CanStartFolderWatch}" />
                    <Button x:Name="ResumeFolderWatchButton" Classes="rail" Content="{translation:Tr ResumeFolderWatch}"
                            Command="{Binding ResumeFolderWatchCommand}" IsVisible="{Binding CanOfferResumeFolderWatch}"
                            IsEnabled="{Binding CanWork}" ToolTip.Tip="{Binding RememberedWatchFolder}" />
                    <TextBlock IsVisible="{Binding IsWatchingFolder}" Text="{Binding WatchedFolderName, StringFormat='Watching {0}'}"
                               ToolTip.Tip="{Binding WatchedFolderPath}" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SelectionOutline}" FontSize="12" Margin="12,7,0,0" />
                    <Button x:Name="ImportWatchFolderFilesButton" Classes="rail" Content="{Binding ImportWatchFilesLabel}"
                            Command="{Binding ImportWatchFolderFilesCommand}" IsVisible="{Binding CanOfferImportWatchFiles}"
                            IsEnabled="{Binding CanWork}" ToolTip.Tip="{Binding RememberedWatchFolder}" />
                    <Button x:Name="StopFolderWatchButton" Classes="rail" Content="{translation:Tr StopWatching}"
                            Command="{Binding StopFolderWatchCommand}" IsVisible="{Binding IsWatchingFolder}" />
                    <CheckBox x:Name="CatchUpOnOpenCheckBox" Content="{translation:Tr CatchUpOnOpen}" FontSize="13"
                              Foreground="{DynamicResource DropSurface}" Margin="12,0,0,0" IsVisible="{Binding CanOfferCatchUpOnOpen}"
                              IsEnabled="{Binding CanWork}" IsChecked="{Binding CatchUpOnOpen, Mode=TwoWay}"
                              ToolTip.Tip="{translation:Tr ResumeTheSavedWatchAndCheckScansWhenThisLibraryOpens}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
            <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource PanelOutline}" BorderThickness="0,0,0,1" Padding="25,16">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                    <TextBox x:Name="SearchBox" Text="{Binding Query, Mode=TwoWay}" MaxLength="256"
                             PlaceholderText="{translation:Tr SearchTextStatusTagDated}" AutomationProperties.Name="{translation:Tr SearchDocuments}"
                             ToolTip.Tip="Try (receipt OR invoice) -tag:archive. Use uppercase AND, OR, NOT, and quotes for phrases.&#10;Use status:inbox or status:reviewed for review status.&#10;Use text:missing or text:present for searchable text.&#10;dated:2024-02 matches the document date. added:2026-11 matches the date added.&#10;Use folder:&quot;Filed/Property&quot; for a folder branch."
                             VerticalContentAlignment="Center" CornerRadius="8" MinHeight="38">
                        <TextBox.InnerLeftContent>
                            <PathIcon Width="15" Height="15" Margin="11,0,1,0" Foreground="{DynamicResource FieldHintInk}"
                                      Data="M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 M10,4 A6,6 0 1 1 10,16 A6,6 0 1 1 10,4 M15,16 L21,22 L23,20 L17,14 Z" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <Button Grid.Column="1" x:Name="ChooseSearchFolderButton" Classes="secondary"
                            Command="{Binding ChooseSearchFolderCommand}" Content="{translation:Tr Folder}" IsEnabled="{Binding CanWork}"
                            AutomationProperties.Name="{translation:Tr ChooseALibraryFolderToSearch}" MinHeight="38" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="OCR" Classes="muted" VerticalAlignment="Center" />
                        <ComboBox x:Name="OcrLanguageBox" ItemsSource="{Binding RecognitionLanguages}"
                                  SelectedItem="{Binding RecognitionLanguage, Mode=TwoWay}" MinWidth="96" MinHeight="38"
                                  IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{translation:Tr OCRLanguage}" />
                    </StackPanel>
                    <Button Grid.Column="3" x:Name="ScanButton" Classes="secondary" Command="{Binding ScanCommand}"
                            Content="{translation:Tr Scan}" IsEnabled="{Binding CanWork}" MinHeight="38" ToolTip.Tip="{Binding IntakeFolderLabel}" />
                    <Button Grid.Column="4" x:Name="AddFilesButton" Classes="primary"
                            IsEnabled="{Binding CanWork}" Command="{Binding AddFilesCommand}" Content="{translation:Tr AddFiles}" MinHeight="38"
                            ToolTip.Tip="{Binding IntakeFolderLabel}" />
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="25,21,25,20" RowDefinitions="Auto,*" RowSpacing="16">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                    <TextBlock x:Name="InboxHeading" Text="{Binding Heading}" FontSize="31" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="1" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SaveSearchButton" Classes="secondary" Content="{translation:Tr SaveSearch2}" Command="{Binding SaveSearchCommand}"
                                IsVisible="{Binding ShowSaveSearch}" IsEnabled="{Binding CanWork}" />
                        <Button x:Name="EditSavedSearchButton" Classes="secondary" Content="{translation:Tr EditSearch}" Command="{Binding EditActiveSavedSearchCommand}"
                                IsVisible="{Binding HasActiveSavedSearch}" IsEnabled="{Binding CanWork}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Classes="muted" Text="{Binding ResultCount}" VerticalAlignment="Center"
                               MaxWidth="154" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ResultCount}" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{translation:Tr Sort}" Classes="muted" VerticalAlignment="Center" />
                        <ComboBox x:Name="DocumentSortBox" ItemsSource="{Binding SortChoices}"
                                  SelectedItem="{Binding SortOption, Mode=TwoWay}" MinWidth="140"
                                  IsEnabled="{Binding HasLibrary}" AutomationProperties.Name="{translation:Tr SortDocuments}" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="2*,3*" ColumnSpacing="15">
                    <Border CornerRadius="11" Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource PanelOutline}" BorderThickness="1" ClipToBounds="True">
                        <Grid RowDefinitions="*,Auto">
                            <TextBlock x:Name="EmptyResultsMessage" Text="{Binding EmptyMessage}" IsVisible="{Binding !HasDocuments}"
                                       Foreground="{DynamicResource SubtleInk}" MaxWidth="220" TextAlignment="Center" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"
                                       AutomationProperties.LiveSetting="Polite" />
                            <ListBox x:Name="DocumentList" ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                                     KeyUp="DocumentList_KeyUp"
                                     ToolTip.Tip="{translation:Tr ReviewShortcutsInThisListRReviewTTagXTrashJNextKPrevious}"
                                     IsVisible="{Binding HasDocuments}" Background="Transparent" Padding="4"
                                     SelectionMode="Multiple" SelectionChanged="Documents_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{translation:Tr Documents}">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="13,11" />
                                        <Setter Property="Margin" Value="1,2" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource SelectionSurface}" />
                                        <Setter Property="Foreground" Value="{DynamicResource WorkspaceInk}" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="core:DocumentSummary">
                                        <Grid ColumnDefinitions="34,*" ColumnSpacing="11">
                                            <Border Background="{DynamicResource HeaderSurface}" Height="39" CornerRadius="6" VerticalAlignment="Top">
                                                <TextBlock Text="PDF" Foreground="{DynamicResource AccentInk}" FontWeight="Bold" FontSize="9"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <WrapPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DocumentDate, StringFormat='Dated {0:dd MMM yyyy}'}" Classes="muted"
                                                               IsVisible="{Binding HasDocumentDate}" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding AddedAt.LocalDateTime, StringFormat={translation:Tr DocumentAddedDateFormat}}" Classes="muted" />
                                                </WrapPanel>
                                                <local:SearchExcerpt Document="{Binding}" Classes="muted" TextWrapping="Wrap"
                                                           MaxLines="2" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="1" Margin="8" Spacing="6" IsVisible="{Binding HasResultActions}">
                                <Button x:Name="RefreshWatchedResultsButton" Classes="secondary" Content="{translation:Tr RefreshResults}"
                                        Command="{Binding RefreshWatchedResultsCommand}" IsVisible="{Binding HasDeferredWatchResults}"
                                        IsEnabled="{Binding CanWork}" ToolTip.Tip="{translation:Tr RefreshAfterWatchedImports}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasBatchCandidates}">
                                    <Button x:Name="SelectShownButton" Classes="secondary" Content="{Binding SelectShownAction}"
                                            Click="SelectShown_Click" AutomationProperties.Name="{Binding SelectShownAction}" />
                                    <Button Grid.Column="1" Content="{translation:Tr LoadMore}" IsVisible="{Binding HasMore}" Command="{Binding LoadMoreCommand}" />
                                </Grid>
                                <Border IsVisible="{Binding HasBatchSelection}" Background="{DynamicResource TagSurface}" CornerRadius="8" Padding="8">
                                    <StackPanel Spacing="7">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <TextBlock Text="{Binding BatchCountLabel}" Classes="muted" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" x:Name="BatchReviewButton" Classes="secondary"
                                                    Content="{Binding BatchReviewAction}" Command="{Binding ReviewSelectedCommand}"
                                                    IsEnabled="{Binding CanWork}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsEnabled="{Binding CanWork}">
                                            <AutoCompleteBox x:Name="BatchTagBox" Classes="tag-entry" Text="{Binding BatchTagInput, Mode=TwoWay}"
                                                             PlaceholderText="{translation:Tr Tag}" AutomationProperties.Name="{translation:Tr TagForTheSelectedDocuments}"
                                                             Populating="TagBox_Populating" KeyDown="BatchTag_KeyDown" />
                                            <Button Grid.Column="1" x:Name="ApplyBatchTagButton" Classes="secondary"
                                                    Content="{translation:Tr TagSelected}" Click="ApplyBatchTag_Click" />
                                        </Grid>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="RemoveBatchTagButton" Classes="secondary" Content="{translation:Tr RemoveTag2}"
                                                    Click="RemoveBatchTag_Click" IsVisible="{Binding HasTaggedBatchSelection}"
                                                    IsEnabled="{Binding CanWork}" AutomationProperties.Name="{translation:Tr RemoveATagFromTheSelectedPDFs}"
                                                    Margin="6,0,0,4" Padding="10,7" />
                                            <Button x:Name="EditBatchDocumentDateButton" Classes="secondary" Content="{translation:Tr DocumentDate2}"
                                                    Click="EditBatchDocumentDate_Click" IsEnabled="{Binding CanWork}"
                                                    AutomationProperties.Name="{translation:Tr EditTheDocumentDateOfTheSelectedPDFs}" Margin="6,0,0,4" Padding="10,7" />
                                            <Button x:Name="SuggestSelectedFilingButton" Classes="secondary" Content="{translation:Tr FilingSuggestions2}"
                                                    Click="SuggestSelectedFiling_Click" IsEnabled="{Binding CanWork}"
                                                    AutomationProperties.Name="{translation:Tr FilingSuggestionsForSelectedPDFs}" Margin="6,0,0,4" Padding="10,7" />
                                            <Button x:Name="CreateSelectedOcrCopiesButton" Classes="secondary" Content="{translation:Tr CreateOCRCopies}"
                                                    Command="{Binding CreateSelectedOcrCopiesCommand}" IsEnabled="{Binding CanWork}"
                                                    AutomationProperties.Name="{translation:Tr CreateOCRCopiesOfTheSelectedPDFs}" Margin="6,0,0,4" Padding="10,7" />
                                            <Button x:Name="MoveSelectedPdfsButton" Classes="secondary" Content="{translation:Tr MovePDFs}"
                                                    Command="{Binding MoveSelectedPdfsCommand}" IsEnabled="{Binding CanWork}"
                                                    AutomationProperties.Name="{translation:Tr MoveSelectedPDFsToAFolder}" Margin="6,0,0,4" Padding="10,7" />
                                            <Button x:Name="CombinePdfsButton" Classes="secondary" Content="{translation:Tr CombinePDFs2}"
                                                    Command="{Binding CombinePdfsCommand}" IsEnabled="{Binding CanWork}"
                                                    Margin="6,0,0,4" Padding="10,7" />
                                            <Button x:Name="ExportSelectedPdfsButton" Classes="secondary"
                                                    Content="{translation:Tr ExportPDFs}" Command="{Binding ExportSelectedPdfsCommand}"
                                                    IsEnabled="{Binding CanWork}" AutomationProperties.Name="{translation:Tr ExportSelectedPDFs}"
                                                    Margin="6,0,0,4" Padding="10,7" />
                                            <Button x:Name="ExportHouseholdBinderButton" Classes="secondary" Content="{translation:Tr ExportBinder}"
                                                    Command="{Binding ExportHouseholdBinderCommand}" IsEnabled="{Binding CanWork}"
                                                    AutomationProperties.Name="{translation:Tr ExportTheSelectedPDFsAsAHouseholdBinder}"
                                                    Margin="6,0,0,4" Padding="10,7" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" CornerRadius="11" Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource PanelOutline}" BorderThickness="1" ClipToBounds="True">
                        <Panel>
                            <TextBlock Text="{translation:Tr SelectADocumentToPreviewIt}" IsVisible="{Binding !HasSelection}"
                                       Foreground="{DynamicResource SubtleInk}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Grid IsVisible="{Binding HasSelection}" RowDefinitions="Auto,*,Auto" RowSpacing="8" Margin="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding SelectedDocument.Title}" TextTrimming="CharacterEllipsis" FontSize="17" FontWeight="SemiBold" />
                                        <Button x:Name="PdfLocationButton" Classes="document-location" Command="{Binding OpenDocumentFolderCommand}"
                                                ToolTip.Tip="{translation:Tr OpenContainingFolder}" AutomationProperties.Name="{translation:Tr OpenPDFSContainingFolder}">
                                            <TextBlock Text="{Binding SelectedDocument.RelativePath}" Foreground="{DynamicResource LinkInk}" FontSize="12"
                                                       TextDecorations="Underline" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                        <Button x:Name="EditDocumentDateButton" Classes="document-location" Command="{Binding EditDocumentDateCommand}"
                                                IsEnabled="{Binding CanWork}" ToolTip.Tip="{translation:Tr EditDocumentDate}" AutomationProperties.Name="{translation:Tr EditDocumentDate}">
                                            <TextBlock Text="{Binding DocumentDateAction}" Foreground="{DynamicResource LinkInk}" FontSize="12"
                                                       TextDecorations="Underline" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Button x:Name="EditTitleButton" Classes="secondary" Content="{translation:Tr EditTitle}" Command="{Binding EditDocumentTitleCommand}"
                                                    IsEnabled="{Binding CanWork}" />
                                            <Button Classes="secondary" Content="{translation:Tr OpenPDF}" Command="{Binding OpenPdfCommand}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5"
                                                    IsVisible="{Binding HasPageMatchAction}">
                                            <Button x:Name="PreviousMatchButton" Classes="secondary" Content="{translation:Tr PreviousMatch}"
                                                    Padding="8,3" Command="{Binding PreviousMatchCommand}"
                                                    IsVisible="{Binding PageMatchNavigationActive}" IsEnabled="{Binding CanWork}"
                                                    ToolTip.Tip="{translation:Tr GoToThePreviousPageThatMatchesTheTextTerms}" />
                                            <Button x:Name="GoToMatchButton" Classes="secondary" Content="{Binding PageMatchActionLabel}"
                                                    Padding="8,3" Command="{Binding GoToMatchCommand}"
                                                    IsVisible="{Binding HasPageMatchAction}" IsEnabled="{Binding CanWork}"
                                                    ToolTip.Tip="{Binding PageMatchActionHelp}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Background="{DynamicResource PreviewSurface}" CornerRadius="8" Padding="8" ClipToBounds="True">
                                    <Grid RowDefinitions="*,Auto,Auto" RowSpacing="5">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                                          Width="68" Margin="0,0,7,0" IsVisible="{Binding HasVisiblePageThumbnails}">
                                                <ItemsControl x:Name="PageThumbnailList" ItemsSource="{Binding PageThumbnails}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="local:PdfPageThumbnail">
                                                            <Button Classes="secondary" Click="PageThumbnail_Click" Padding="4"
                                                                    AutomationProperties.Name="{Binding PageNumber, StringFormat='Page {0}'}">
                                                                <StackPanel Spacing="2">
                                                                    <Image Source="{Binding Image}" Width="42" Height="53" Stretch="Uniform" />
                                                                    <TextBlock Text="{Binding PageNumber}" HorizontalAlignment="Center" FontSize="11" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <ScrollViewer Grid.Column="1" x:Name="PreviewScroll" Classes="pdf-preview" Classes.fitWidth="{Binding FitPreviewWidth}"
                                                          Classes.zoomed="{Binding IsPreviewZoomed}"
                                                          Focusable="{Binding IsPreviewScrollable}" IsVisible="{Binding !IsPageTextView}"
                                                          AutomationProperties.Name="{translation:Tr PDFPagePreview}">
                                                <Grid Width="{Binding PreviewDisplayWidth}" Height="{Binding PreviewDisplayHeight}">
                                                    <Image x:Name="PreviewPage" Source="{Binding Preview}" Stretch="Uniform" />
                                                    <local:PdfPageHighlightLayer Source="{Binding Preview}" Highlights="{Binding PreviewHighlights}"
                                                                                  IsHitTestVisible="False" />
                                                </Grid>
                                            </ScrollViewer>
                                            <ScrollViewer Grid.Column="1" x:Name="PageTextScroll" IsVisible="{Binding HasPageText}"
                                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                <SelectableTextBlock x:Name="PageTextContent" Text="{Binding PageText}" TextWrapping="Wrap"
                                                                     Padding="12,8" FontSize="15" LineHeight="22" Focusable="True" />
                                            </ScrollViewer>
                                            <TextBlock Grid.Column="1" Text="{Binding PreviewMessage}" IsVisible="{Binding HasPreviewMessage}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                                       AutomationProperties.LiveSetting="Polite" />
                                        </Grid>
                                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                                            <Button x:Name="CopyDocumentTextButton" Classes="secondary" HorizontalAlignment="Left"
                                                    Content="{translation:Tr CopyText}" Command="{Binding CopyDocumentTextCommand}"
                                                    IsVisible="{Binding !HasNoSearchableText}" IsEnabled="{Binding CanWork}" Padding="8,3"
                                                    AutomationProperties.Name="{translation:Tr CopyDocumentText}" ToolTip.Tip="{translation:Tr CopyTheSearchableTextFromAllPages}" />
                                            <Grid Grid.Column="1" x:Name="PreviewPageNavigation" ColumnDefinitions="Auto,*,Auto"
                                                  HorizontalAlignment="Center" ColumnSpacing="4">
                                                <Button Content="‹" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoBack}"
                                                        AutomationProperties.Name="{translation:Tr PreviousPage}" Padding="9,3" />
                                                <TextBlock Grid.Column="1" Text="{Binding PageLabel}" Classes="muted" VerticalAlignment="Center"
                                                           TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PageLabel}" />
                                                <Button Grid.Column="2" Content="›" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoForward}"
                                                        AutomationProperties.Name="{translation:Tr NextPage}" Padding="9,3" />
                                            </Grid>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                                <Button x:Name="ReadPageTextButton" Classes="secondary" Content="{Binding PageTextAction}"
                                                        Command="{Binding TogglePageTextCommand}" IsVisible="{Binding !HasNoSearchableText}" Padding="8,3" />
                                                <Button x:Name="PreviewFitButton" Classes="secondary"
                                                        Content="{Binding PreviewFitAction}" Command="{Binding TogglePreviewFitCommand}"
                                                        IsEnabled="{Binding HasPreview}" IsVisible="{Binding !IsPageTextView}" Padding="8,3" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" IsVisible="{Binding !IsPageTextView}">
                                            <ToggleButton x:Name="PageThumbnailsButton" Classes="preview-thumbnails"
                                                          Content="{translation:Tr Thumbnails}" HorizontalAlignment="Left"
                                                          IsChecked="{Binding ShowPageThumbnails, Mode=OneWay}"
                                                          Command="{Binding TogglePageThumbnailsCommand}" IsEnabled="{Binding HasMultiplePages}"
                                                          Padding="8,3" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                                <Button x:Name="ZoomOutButton" Classes="secondary" Content="−" Command="{Binding ZoomOutCommand}"
                                                        IsEnabled="{Binding CanZoomOut}" AutomationProperties.Name="{translation:Tr ZoomOut}" Padding="10,3" />
                                                <TextBlock Text="{Binding PreviewZoomLabel}" VerticalAlignment="Center" FontSize="12" />
                                                <Button x:Name="ZoomInButton" Classes="secondary" Content="+" Command="{Binding ZoomInCommand}"
                                                        IsEnabled="{Binding CanZoomIn}" AutomationProperties.Name="{translation:Tr ZoomIn}" Padding="10,3" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="2" Spacing="6">
                                    <ScrollViewer x:Name="DocumentActionsScroll" MaxHeight="58" Focusable="True"
                                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                                  AllowAutoHide="False"
                                                  AutomationProperties.Name="{translation:Tr DocumentActions}">
                                        <StackPanel Spacing="4">
                                            <WrapPanel Orientation="Horizontal" Classes="document-actions">
                                                <Button x:Name="PdfToolsButton" Classes="secondary" Content="{translation:Tr PDFTools}"
                                                        IsEnabled="{Binding CanWork}">
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuItem x:Name="EditPdfPagesItem" Header="{translation:Tr EditPages}" Command="{Binding EditPdfPagesCommand}" />
                                                            <MenuItem x:Name="PdfVersionsItem" Header="{translation:Tr VersionHistory}" Command="{Binding ShowPdfVersionsCommand}" />
                                                            <Separator />
                                                            <MenuItem Header="{translation:Tr ExportBinder}" Command="{Binding ExportHouseholdBinderCommand}" />
                                                            <MenuItem Header="{translation:Tr ExportRedactedPDF}" Command="{Binding ExportRedactedPdfCommand}" />
                                                            <MenuItem Header="{translation:Tr ExportStampedPDF}" Command="{Binding ExportStampedPdfCommand}" />
                                                            <MenuItem Header="{translation:Tr ExportCompressedPDF}" Command="{Binding ExportCompressedPdfCommand}" />
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                                <Button x:Name="MovePdfButton" Classes="secondary" Content="{translation:Tr MoveToFolder}"
                                                        Command="{Binding MovePdfCommand}" IsEnabled="{Binding CanWork}" />
                                                <Button x:Name="ExportPdfButton" Classes="secondary" Content="{translation:Tr ExportPDF2}"
                                                        Command="{Binding ExportPdfCommand}" IsEnabled="{Binding CanWork}" />
                                                <Button x:Name="CreateSearchableCopyButton" Classes="secondary" Content="{Binding SearchableCopyAction}"
                                                        Command="{Binding CreateSearchableCopyCommand}" IsEnabled="{Binding CanWork}"
                                                        ToolTip.Tip="{translation:Tr CreateASeparatePDFUsingTheSelectedOCRLanguage}" />
                                                <Button x:Name="TrashDocumentButton" Classes="secondary" Content="{translation:Tr TrashNext}"
                                                        Command="{Binding TrashDocumentCommand}" IsEnabled="{Binding CanWork}"
                                                        ToolTip.Tip="{translation:Tr MoveTheOpenPDFToTrashXInTheResultsList}" />
                                                <Button x:Name="SuggestFilingButton" Classes="secondary" Content="{translation:Tr FilingSuggestions2}"
                                                        Command="{Binding SuggestFilingCommand}" IsEnabled="{Binding CanWork}" />
                                                <Button x:Name="ExtractPdfPagesButton" Classes="secondary" Content="{translation:Tr ExtractPages}"
                                                        Command="{Binding ExtractPdfPagesCommand}" IsEnabled="{Binding CanWork}"
                                                        IsVisible="{Binding HasMultiplePages}" />
                                                <Button x:Name="RotatePdfPagesButton" Classes="secondary" Content="{translation:Tr RotatePages2}"
                                                        Command="{Binding RotatePdfPagesCommand}" IsEnabled="{Binding CanWork}" />
                                            </WrapPanel>
                                            <TextBlock Text="{translation:Tr NoSearchableTextFound}" Foreground="{DynamicResource WarningInk}" FontSize="12"
                                                       TextWrapping="Wrap" IsVisible="{Binding HasNoSearchableText}" />
                                            <ItemsControl ItemsSource="{Binding SelectedDocument.Tags}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Button Click="RemoveTag_Click" Margin="0,0,5,3" Padding="8,4"
                                                                Background="{DynamicResource TagSurface}" MaxWidth="144"
                                                                AutomationProperties.Name="{Binding StringFormat='Remove tag {0}'}">
                                                            <TextBlock Text="{Binding StringFormat='{}{0}  ×'}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" IsEnabled="{Binding CanWork}">
                                        <AutoCompleteBox x:Name="TagBox" Classes="tag-entry" Text="{Binding TagInput, Mode=TwoWay}"
                                                         PlaceholderText="{translation:Tr Tag}" AutomationProperties.Name="{translation:Tr TagForThisDocument}" FontSize="12"
                                                         Populating="TagBox_Populating" KeyDown="TagBox_KeyDown" />
                                        <Button Grid.Column="1" x:Name="AddTagButton" Classes="secondary" Content="{translation:Tr Add}" Command="{Binding AddTagCommand}"
                                                AutomationProperties.Name="{translation:Tr AddTag}" />
                                        <Button Grid.Column="2" x:Name="ReviewButton" Classes="secondary" Content="{Binding ReviewAction}" Command="{Binding ToggleReviewCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Panel>
                    </Border>
                </Grid>
            </Grid>
            <Border Grid.Row="2" Padding="25,7" Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource PanelOutline}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" MinHeight="24">
                    <TextBlock Text="{Binding Status}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
                    <Button Grid.Column="1" x:Name="ImportErrorsButton" Classes="secondary" Content="{translation:Tr ImportErrors}"
                            Command="{Binding InspectImportErrorsCommand}" IsVisible="{Binding HasImportFailures}"
                            IsEnabled="{Binding CanWork}" Padding="8,3" />
                    <Button Grid.Column="2" x:Name="OpenBackupFolderButton" Classes="secondary" Content="{translation:Tr OpenBackup}"
                            Command="{Binding OpenBackupFolderCommand}" IsVisible="{Binding HasLatestBackup}"
                            IsEnabled="{Binding CanWork}" Padding="8,3" />
                    <Button Grid.Column="3" x:Name="OpenExportFolderButton" Classes="secondary" Content="{translation:Tr OpenExport}"
                            Command="{Binding OpenExportFolderCommand}" IsVisible="{Binding HasLatestExport}"
                            IsEnabled="{Binding CanWork}" Padding="8,3" />
                    <Button Grid.Column="4" x:Name="OcrCopyBatchResultsButton" Classes="secondary" Content="{translation:Tr OCRResults}"
                            Command="{Binding InspectOcrCopyBatchResultsCommand}" IsVisible="{Binding HasOcrCopyBatchResults}"
                            IsEnabled="{Binding CanWork}" Padding="8,3" />
                    <Button Grid.Column="5" x:Name="IndexReportButton" Classes="secondary" Content="{translation:Tr IndexReport}"
                            Command="{Binding ShowIndexReportCommand}" IsVisible="{Binding ShowIndexReport}" Padding="8,3" />
                    <ProgressBar Grid.Column="6" Width="74" IsIndeterminate="True" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
                    <Button Grid.Column="7" Content="{translation:Tr Cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" Padding="8,3" />
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Column="1" x:Name="DropTarget" IsVisible="False" IsHitTestVisible="False" Margin="19"
                Background="{DynamicResource CardActiveSurface}" BorderBrush="{DynamicResource DropOutline}" BorderThickness="2" CornerRadius="13">
            <TextBlock Text="{translation:Tr DropPDFsOrImagesToAddThem}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontWeight="SemiBold" FontSize="23" Foreground="{DynamicResource PanelInk}" />
        </Border>
    </Grid>
</Window>
