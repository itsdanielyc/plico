<Window xmlns="https://github.com/avaloniaui"
        xmlns:translation="using:Plico.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Plico.Desktop" x:Class="Plico.Desktop.BatchTagRemovalDialog"
        Title="{translation:Tr RemoveTag}" Width="440" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner"
        Classes="dialog">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
            <StackPanel Classes="dialog-actions">
                <Button x:Name="CancelTagRemovalButton" Classes="secondary" Content="{translation:Tr Cancel}" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="ConfirmTagRemovalButton" Classes="primary" Content="{translation:Tr RemoveTag}" IsEnabled="False" IsDefault="True"
                        Click="Remove_Click" />
            </StackPanel>
        </Border>
        <StackPanel Classes="dialog-body">
            <TextBlock Classes="heading" Text="{translation:Tr ChooseATagFromTheSelectedPDFs}" TextWrapping="Wrap" />
            <ListBox x:Name="BatchTagChoices" Classes="plain framed" MaxHeight="230"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{translation:Tr TagsOnTheSelectedPDFs}"
                     SelectionChanged="TagChoice_Changed">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:BatchTagOption">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
                            <TextBlock Grid.Column="1" Text="{Binding CountLabel}" Foreground="{DynamicResource Fg3}" FontFeatures="+tnum" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </DockPanel>
</Window>
