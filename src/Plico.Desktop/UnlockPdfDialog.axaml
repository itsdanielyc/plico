<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Plico.Desktop.UnlockPdfDialog" Title="Import password-protected PDF"
        Width="465" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource InterFont}" Background="#F4F5EF">
    <StackPanel Margin="24" Spacing="12">
        <TextBlock x:Name="FileLabel" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
        <TextBox x:Name="PasswordBox" PasswordChar="●" PlaceholderText="PDF password" AutomationProperties.Name="PDF password" />
        <TextBlock Text="Plico imports an unlocked PDF and keeps the encrypted original in version history." TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" />
            <Button Content="Unlock and import" IsDefault="True" Click="Unlock_Click"
                    Background="#254C37" Foreground="White" />
        </StackPanel>
    </StackPanel>
</Window>
