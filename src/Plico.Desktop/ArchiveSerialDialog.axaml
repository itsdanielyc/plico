<Window xmlns="https://github.com/avaloniaui" xmlns:translation="using:Plico.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Plico.Desktop.ArchiveSerialDialog" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False" Classes="dialog">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
            <StackPanel Classes="dialog-actions">
                <Button Classes="secondary" Content="{translation:Tr Cancel}" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="AcceptSerial" Classes="primary" Content="Continue" IsDefault="True" Click="Accept_Click" />
            </StackPanel>
        </Border>
        <StackPanel Classes="dialog-body">
            <TextBlock Classes="heading" Text="{Binding $parent[Window].Title}" TextWrapping="Wrap" />
            <TextBlock x:Name="ArchiveSerialPrompt" TextWrapping="Wrap" />
            <TextBox x:Name="SerialInput" PlaceholderText="{translation:Tr ArchiveSerialLabel}" MaxLength="19"
                     AutomationProperties.Name="{translation:Tr ArchiveSerialLabel}" />
            <StackPanel x:Name="LabelCountControls" Classes="field">
                <TextBlock Classes="form-label" Text="{translation:Tr LabelCount}" />
                <NumericUpDown x:Name="LabelCount" Value="30" Minimum="1" Maximum="10000" FormatString="0"
                               AutomationProperties.Name="{translation:Tr LabelCount}" />
            </StackPanel>
            <StackPanel x:Name="PaperControls" Classes="field">
                <TextBlock Classes="form-label" Text="{translation:Tr PaperSize}" />
                <ComboBox x:Name="PaperSize" HorizontalAlignment="Stretch" AutomationProperties.Name="{translation:Tr PaperSize}" />
            </StackPanel>
            <TextBlock x:Name="SerialError" Classes="validation"
                       IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
    </DockPanel>
</Window>
