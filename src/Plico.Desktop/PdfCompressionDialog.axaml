<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Plico.Desktop.PdfCompressionDialog" Title="Compress PDF" Width="450" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False" FontFamily="{StaticResource InterFont}" Background="#F4F5EF">
    <StackPanel Margin="24" Spacing="12">
        <RadioButton x:Name="LosslessOption" Content="Lossless" GroupName="Compression" IsChecked="True" />
        <RadioButton x:Name="SmallerScansOption" Content="Smaller scans" GroupName="Compression" />
        <TextBlock Text="The smaller scan setting reduces resolution and JPEG quality for supported color images. Both modes keep searchable text."
                   TextWrapping="Wrap" Foreground="#5C685D" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" />
            <Button x:Name="ConfirmCompression" Content="Choose destination…" IsDefault="True" Click="Confirm_Click"
                    Background="#254C37" Foreground="White" />
        </StackPanel>
    </StackPanel>
</Window>
