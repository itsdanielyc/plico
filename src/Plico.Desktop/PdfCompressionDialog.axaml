<Window xmlns="https://github.com/avaloniaui"
        xmlns:translation="using:Plico.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Plico.Desktop.PdfCompressionDialog" Title="{translation:Tr CompressPDF}" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False" Classes="dialog">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
            <StackPanel Classes="dialog-actions">
                <Button Classes="secondary" Content="{translation:Tr Cancel}" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="ConfirmCompression" Classes="primary" Content="{translation:Tr ChooseDestination}" IsDefault="True" Click="Confirm_Click" />
            </StackPanel>
        </Border>
        <StackPanel Classes="dialog-body">
            <TextBlock Classes="heading" Text="{translation:Tr CompressPDF}" />
            <StackPanel Spacing="4">
                <RadioButton x:Name="LosslessOption" Content="{translation:Tr Lossless}" GroupName="Compression" IsChecked="True" />
                <RadioButton x:Name="SmallerScansOption" Content="{translation:Tr SmallerScans}" GroupName="Compression" />
            </StackPanel>
            <TextBlock Classes="hint" Text="{translation:Tr TheSmallerScanSettingReducesResolutionAndJPEGQualityForSupport}" />
        </StackPanel>
    </DockPanel>
</Window>
