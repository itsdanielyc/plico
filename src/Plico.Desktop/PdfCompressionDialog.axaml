<Window xmlns="https://github.com/avaloniaui"
        xmlns:translation="using:Plico.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Plico.Desktop.PdfCompressionDialog" Title="{translation:Tr CompressPDF}" Width="450" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False" FontFamily="{StaticResource InterFont}" Background="{DynamicResource WorkspaceSurface}">
    <StackPanel Margin="24" Spacing="12">
        <RadioButton x:Name="LosslessOption" Content="{translation:Tr Lossless}" GroupName="Compression" IsChecked="True" />
        <RadioButton x:Name="SmallerScansOption" Content="{translation:Tr SmallerScans}" GroupName="Compression" />
        <TextBlock Text="{translation:Tr TheSmallerScanSettingReducesResolutionAndJPEGQualityForSupport}"
                   TextWrapping="Wrap" Foreground="{DynamicResource MutedInk}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{translation:Tr Cancel}" IsCancel="True" Click="Cancel_Click" />
            <Button x:Name="ConfirmCompression" Content="{translation:Tr ChooseDestination}" IsDefault="True" Click="Confirm_Click"
                    Background="{DynamicResource PrimarySurface}" Foreground="White" />
        </StackPanel>
    </StackPanel>
</Window>
