<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:translation="using:Plico.Desktop"
        xmlns:local="using:Plico.Desktop"
        x:Class="Plico.Desktop.SettingsWindow" x:DataType="local:InboxViewModel"
        Title="{translation:Tr SettingsTitle}" Width="760" Height="640" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="Border.group">
            <Setter Property="Background" Value="{DynamicResource RaisedSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Border.group > StackPanel > Grid">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Margin" Value="16,0" />
        </Style>
        <Style Selector="Border.group > StackPanel > Separator">
            <Setter Property="Background" Value="{DynamicResource LineBrush}" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="16,0" />
        </Style>
        <Style Selector="TextBlock.row-title">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.row-help">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource MutedInk}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.group-title">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,0,0,8" />
        </Style>
        <Style Selector="Grid > Button, Grid > ComboBox, Grid > ToggleSwitch">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="190,*">
        <Border Background="{DynamicResource SidebarSurface}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="10,16" Spacing="1">
                <TextBlock Classes="heading" Text="{translation:Tr SettingsTitle}" Margin="8,0,0,12" />
                <Button Classes="nav" Content="{translation:Tr SettingsGeneral}" Click="Jump_Click" Tag="GeneralGroup" />
                <Button Classes="nav" Content="{translation:Tr SettingsRecognition}" Click="Jump_Click" Tag="RecognitionGroup" />
                <Button Classes="nav" Content="{translation:Tr IntakeSection}" Click="Jump_Click" Tag="IntakeGroup" />
                <Button Classes="nav" Content="{translation:Tr Library}" Click="Jump_Click" Tag="LibraryGroup" />
                <Button Classes="nav" Content="{translation:Tr SettingsFiling}" Click="Jump_Click" Tag="FilingGroup" />
                <Button Classes="nav" Content="{translation:Tr LocalModelsWindow}" Click="Jump_Click" Tag="ModelsGroup" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" x:Name="SettingsScroll" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24,28,32" Spacing="26" MaxWidth="560">
                <StackPanel x:Name="GeneralGroup">
                    <TextBlock Classes="group-title" Text="{translation:Tr SettingsGeneral}" />
                    <Border Classes="group">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel VerticalAlignment="Center" Margin="0,8">
                                    <TextBlock Classes="row-title" Text="{translation:Tr AppearanceTitle}" />
                                    <TextBlock Classes="row-help" Text="{translation:Tr AppearanceHelp}" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="secondary" Content="{translation:Tr Appearance2}" Command="{Binding ShowAppearanceCommand}" />
                            </Grid>
                            <Separator />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="row-title" Text="{translation:Tr KeyboardShortcuts}" />
                                <Button Grid.Column="1" Classes="secondary" Content="{translation:Tr ShowAction}" Click="ShowShortcuts_Click" AutomationProperties.Name="{translation:Tr KeyboardShortcuts}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="RecognitionGroup">
                    <TextBlock Classes="group-title" Text="{translation:Tr SettingsRecognition}" />
                    <Border Classes="group">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center" Margin="0,8">
                                    <TextBlock Classes="row-title" Text="{translation:Tr OCRLanguage}" />
                                    <TextBlock Classes="row-help" Text="{translation:Tr TextLanguageHelp}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" x:Name="SettingsLanguageBox" ItemsSource="{Binding RecognitionLanguages}" MinWidth="160"
                                          SelectedItem="{Binding RecognitionLanguage, Mode=TwoWay}" IsEnabled="{Binding IsIdle}"
                                          AutomationProperties.Name="{translation:Tr OCRLanguage}" />
                            </Grid>
                            <Separator />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock Classes="row-title" Text="{translation:Tr UseRapidOcr}" TextWrapping="Wrap" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseRapidOcr, Mode=TwoWay}" IsEnabled="{Binding CanUseRapidOcr}"
                                              OnContent="" OffContent="" AutomationProperties.Name="{translation:Tr UseRapidOcr}" />
                            </Grid>
                            <Separator />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock Classes="row-title" Text="{translation:Tr AutoOrientPages}" TextWrapping="Wrap" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoOrientPages, Mode=TwoWay}" IsEnabled="{Binding IsIdle}"
                                              OnContent="" OffContent="" AutomationProperties.Name="{translation:Tr AutoOrientPages}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="IntakeGroup">
                    <TextBlock Classes="group-title" Text="{translation:Tr IntakeSection}" />
                    <Border Classes="group">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center" Margin="0,8">
                                    <TextBlock Classes="row-title" Text="{translation:Tr IntakeFolderTitle}" />
                                    <TextBlock Classes="row-help" Text="{Binding IntakeFolderLabel}" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="secondary" Content="{translation:Tr ChangeEllipsis}" Command="{Binding ChooseIntakeFolderCommand}" IsEnabled="{Binding CanWork}" AutomationProperties.Name="{translation:Tr ChooseIntakeFolder}" />
                            </Grid>
                            <Separator IsVisible="{Binding HasCustomIntakeFolder}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="{Binding HasCustomIntakeFolder}">
                                <TextBlock Classes="row-title" Text="{translation:Tr IncludeWatchedScans}" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IncludeWatchedScans, Mode=TwoWay}" IsEnabled="{Binding CanWork}" OnContent="" OffContent="" AutomationProperties.Name="{translation:Tr IncludeWatchedScans}" />
                            </Grid>
                            <Separator />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center" Margin="0,8">
                                    <TextBlock Classes="row-title" Text="{translation:Tr WatchedFolderTitle}" />
                                    <TextBlock Classes="row-help" Text="{translation:Tr WatchedFolderHelp}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="secondary" Content="{translation:Tr WatchAFolder}" Command="{Binding StartFolderWatchCommand}"
                                            IsVisible="{Binding !IsWatchingFolder}" IsEnabled="{Binding CanStartFolderWatch}" />
                                    <Button Classes="secondary" Content="{translation:Tr StopWatching}" Command="{Binding StopFolderWatchCommand}" IsVisible="{Binding IsWatchingFolder}" />
                                </StackPanel>
                            </Grid>
                            <Separator IsVisible="{Binding CanOfferCatchUpOnOpen}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="{Binding CanOfferCatchUpOnOpen}">
                                <TextBlock Classes="row-title" Text="{translation:Tr CatchUpOnOpen}" />
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CatchUpOnOpen, Mode=TwoWay}" IsEnabled="{Binding CanWork}" OnContent="" OffContent="" AutomationProperties.Name="{translation:Tr CatchUpOnOpen}" />
                            </Grid>
                            <Separator />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center" Margin="0,8">
                                    <TextBlock Classes="row-title" Text="{Binding PhoneInboxLabel}" />
                                    <TextBlock Classes="row-help" Text="{translation:Tr PhoneInboxHelp}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="secondary" Content="{translation:Tr ChoosePhoneFolder}" Command="{Binding ChoosePhoneInboxFolderCommand}"
                                            IsVisible="{Binding !IsWatchingPhoneInbox}" IsEnabled="{Binding CanWork}" />
                                    <Button Classes="secondary" Content="{translation:Tr StopPhoneInbox}" Command="{Binding StopPhoneInboxCommand}" IsVisible="{Binding IsWatchingPhoneInbox}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="LibraryGroup">
                    <TextBlock Classes="group-title" Text="{translation:Tr Library}" />
                    <Border Classes="group">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center" Margin="0,8">
                                    <TextBlock Classes="row-title" Text="{Binding LibraryName}" />
                                    <TextBlock Classes="row-help" Text="{Binding LibraryPath}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="secondary" Content="{translation:Tr ShowPDFFolder}" Command="{Binding OpenPdfFolderCommand}" IsEnabled="{Binding HasLibrary}" />
                                    <Button Classes="secondary" Content="{translation:Tr ChangeEllipsis}" Command="{Binding ChooseLibraryCommand}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{translation:Tr ChooseLibraryFolder}" />
                                </StackPanel>
                            </Grid>
                            <Separator />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock Classes="row-title" Text="{translation:Tr BackupTitle}" />
                                <Button Grid.Column="1" Classes="secondary" Content="{translation:Tr BackUpLibrary}" Command="{Binding BackUpLibraryCommand}" IsEnabled="{Binding CanWork}" />
                            </Grid>
                            <Separator />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock Classes="row-title" Text="{translation:Tr MaintenanceTitle}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="secondary" Content="{translation:Tr CheckLibraryIntegrity}" Command="{Binding CheckIntegrityCommand}" IsEnabled="{Binding CanWork}" />
                                    <Button Classes="secondary" Content="{translation:Tr RefreshIndex}" Command="{Binding RefreshIndexCommand}" IsEnabled="{Binding CanWork}" />
                                </StackPanel>
                            </Grid>
                            <Separator />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock Classes="row-title" Text="{translation:Tr ExportsTitle}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="secondary" Content="JSON…" Command="{Binding ExportMetadataCommand}" IsEnabled="{Binding CanWork}"
                                            ToolTip.Tip="{translation:Tr ExportLibraryMetadataJSON}" AutomationProperties.Name="{translation:Tr ExportLibraryMetadataJSON}" />
                                    <Button Classes="secondary" Content="CSV…" Command="{Binding ExportSearchCsvCommand}" IsEnabled="{Binding CanWork}"
                                            ToolTip.Tip="{translation:Tr ExportSearchResultsCSV}" AutomationProperties.Name="{translation:Tr ExportSearchResultsCSV}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="FilingGroup">
                    <TextBlock Classes="group-title" Text="{translation:Tr SettingsFiling}" />
                    <Border Classes="group">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center" Margin="0,8">
                                    <TextBlock Classes="row-title" Text="{translation:Tr TagRules2}" />
                                    <TextBlock Classes="row-help" Text="{translation:Tr TagRulesHelp}" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="secondary" Content="{translation:Tr EditAction}" Command="{Binding ManageFilingRulesCommand}" IsEnabled="{Binding CanWork}" AutomationProperties.Name="{translation:Tr TagRules2}" />
                            </Grid>
                            <Separator />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock Classes="row-title" Text="{translation:Tr MetadataDefinitions}" />
                                <Button Grid.Column="1" Classes="secondary" Content="{translation:Tr EditAction}" Command="{Binding ManageMetadataCommand}" IsEnabled="{Binding CanWork}" AutomationProperties.Name="{translation:Tr MetadataDefinitions}" />
                            </Grid>
                            <Separator />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock Classes="row-title" Text="{Binding ReminderMenuTitle}" />
                                <Button Grid.Column="1" Classes="secondary" Content="{translation:Tr ShowAction}" Command="{Binding RemindersCommand}" IsEnabled="{Binding CanWork}" AutomationProperties.Name="{Binding ReminderMenuTitle}" />
                            </Grid>
                            <Separator />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock Classes="row-title" Text="{translation:Tr ArchiveSerialMenu}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="secondary" Content="{translation:Tr ArchiveLabelSheets}" Command="{Binding PrintArchiveLabelsCommand}" IsEnabled="{Binding CanWork}" />
                                    <Button Classes="secondary" Content="{translation:Tr ArchiveSeparator}" Command="{Binding PrintSeparatorSheetCommand}" IsEnabled="{Binding CanWork}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="ModelsGroup">
                    <TextBlock Classes="group-title" Text="{translation:Tr LocalModelsWindow}" />
                    <Border Classes="group">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center" Margin="0,8">
                                    <TextBlock Classes="row-title" Text="{translation:Tr LocalModels}" />
                                    <TextBlock Classes="row-help" Text="{translation:Tr LocalModelsHelp}" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="secondary" Content="{translation:Tr EditAction}" Command="{Binding ConfigureLocalModelsCommand}" IsEnabled="{Binding CanWork}" AutomationProperties.Name="{translation:Tr LocalModels}" />
                            </Grid>
                            <Separator />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock Classes="row-title" Text="{translation:Tr ClearSemanticIndex}" TextWrapping="Wrap" />
                                <Button Grid.Column="1" Classes="secondary" Content="{translation:Tr ClearAction}" Command="{Binding RebuildSemanticIndexCommand}"
                                        IsEnabled="{Binding HasSemanticSearch}" AutomationProperties.Name="{translation:Tr ClearSemanticIndex}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
