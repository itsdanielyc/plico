<Window xmlns="https://github.com/avaloniaui"
        xmlns:translation="using:Plico.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Plico.Desktop.DocumentTitleDialog" Title="{translation:Tr EditTitle}" Width="460" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner" Classes="dialog">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
            <StackPanel Classes="dialog-actions">
                <Button Classes="secondary" Content="{translation:Tr Cancel}" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="SaveTitleButton" Classes="primary" Content="{translation:Tr SaveTitle}" IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </Border>
        <StackPanel Classes="dialog-body">
            <TextBlock Classes="heading" Text="{translation:Tr DocumentTitle}" />
            <TextBox x:Name="TitleBox" AutomationProperties.Name="{translation:Tr DocumentTitle}" />
            <TextBlock x:Name="ValidationMessage" Classes="validation" IsVisible="False" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </DockPanel>
</Window>
