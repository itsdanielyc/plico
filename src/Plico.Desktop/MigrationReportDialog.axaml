<Window xmlns="https://github.com/avaloniaui" xmlns:translation="using:Plico.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Plico.Desktop.MigrationReportDialog" Title="{translation:Tr MigrationReport}" Width="700" Height="500"
        MinWidth="540" MinHeight="380" WindowStartupLocation="CenterOwner" Classes="dialog">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock x:Name="MigrationSaveStatus" Classes="description" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Classes="dialog-actions">
                    <Button Classes="secondary" Content="{translation:Tr SaveMigrationJson}" Click="Save_Click" />
                    <Button Classes="primary" Content="{translation:Tr Close}" IsCancel="True" IsDefault="True" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Classes="dialog-body" RowDefinitions="Auto,*" RowSpacing="14">
            <StackPanel Spacing="4">
                <TextBlock Classes="heading" Text="{translation:Tr MigrationReport}" />
                <TextBlock x:Name="MigrationSummary" Classes="description" />
            </StackPanel>
            <TextBox x:Name="MigrationNotices" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="{translation:Tr MigrationDetails}" />
        </Grid>
    </DockPanel>
</Window>
