<Window xmlns="https://github.com/avaloniaui" xmlns:translation="using:Plico.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Plico.Desktop.MigrationReportDialog" Title="{translation:Tr MigrationReport}" Width="690" Height="455"
        MinWidth="540" MinHeight="360" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource InterFont}" Background="{DynamicResource WorkspaceSurface}">
    <Grid Margin="24" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <TextBlock x:Name="MigrationSummary" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBox x:Name="MigrationNotices" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="{translation:Tr MigrationDetails}" />
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <TextBlock x:Name="MigrationSaveStatus" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{translation:Tr SaveMigrationJson}" Click="Save_Click" />
            <Button Grid.Column="2" Content="{translation:Tr Close}" IsCancel="True" Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
