<Window xmlns="https://github.com/avaloniaui"
        xmlns:translation="using:Plico.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Plico.Desktop" x:Class="Plico.Desktop.IndexReportDialog"
        Title="{translation:Tr IndexReport}" Width="660" Height="470" MinWidth="440" MinHeight="340"
        WindowStartupLocation="CenterOwner" Classes="dialog">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
            <StackPanel Classes="dialog-actions">
                <Button Classes="secondary" Content="{translation:Tr Close}" IsCancel="True" Click="Close_Click" />
                <Button x:Name="RestoreFromFolderButton" Classes="secondary" Content="{translation:Tr RestoreFromFolder}" Click="RestoreFromFolder_Click" />
                <Button x:Name="RestorePdfButton" Classes="primary" Content="{translation:Tr RestorePDF}" IsEnabled="False" Click="Restore_Click"
                        ToolTip.Tip="{translation:Tr CopyAnExactMatchToTheOriginalLibraryPath}" />
            </StackPanel>
        </Border>
        <Grid Classes="dialog-body" RowDefinitions="Auto,*" RowSpacing="14">
            <TextBlock Classes="heading" Text="{translation:Tr IndexReport}" />
            <ListBox Grid.Row="1" x:Name="IndexReportList" Classes="plain framed"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{translation:Tr UnavailablePDFsAndRefreshNotices}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:IndexReportLine">
                        <Grid ColumnDefinitions="112,*" ColumnSpacing="12">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{Binding Detail}" Foreground="{DynamicResource Fg2}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
