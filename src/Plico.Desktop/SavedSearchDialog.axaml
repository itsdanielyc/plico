<Window xmlns="https://github.com/avaloniaui"
        xmlns:translation="using:Plico.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Plico.Desktop.SavedSearchDialog" Width="510" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource InterFont}" Background="{DynamicResource WorkspaceSurface}">
    <StackPanel Margin="24" Spacing="12">
        <StackPanel Spacing="5">
            <TextBlock Text="{translation:Tr Name}" FontWeight="SemiBold" />
            <TextBox x:Name="SavedNameBox" AutomationProperties.Name="{translation:Tr SavedSearchName}" />
        </StackPanel>
        <StackPanel Spacing="5">
            <TextBlock Text="{translation:Tr Search}" FontWeight="SemiBold" />
            <TextBox x:Name="SavedQueryBox" AutomationProperties.Name="{translation:Tr SavedSearchQuery}" />
            <TextBlock x:Name="SavedScope" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedInk}" />
        </StackPanel>
        <StackPanel Spacing="5">
            <TextBlock Text="{translation:Tr Sort}" FontWeight="SemiBold" />
            <ComboBox x:Name="SavedSortBox" HorizontalAlignment="Stretch" AutomationProperties.Name="{translation:Tr SavedSearchOrder}" />
        </StackPanel>
        <TextBlock x:Name="SavedSearchValidation" IsVisible="False" Foreground="{DynamicResource ValidationInk}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Button x:Name="RemoveSavedSearchButton" Content="{translation:Tr RemoveShortcut}" Click="Remove_Click" Padding="14,7" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="{translation:Tr Cancel}" IsCancel="True" Click="Cancel_Click" Padding="14,7" />
                <Button x:Name="ConfirmSavedSearchButton" Content="{translation:Tr SaveSearch}" IsDefault="True" Click="Save_Click"
                        Padding="14,7" Background="{DynamicResource PrimarySurface}" Foreground="White" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
