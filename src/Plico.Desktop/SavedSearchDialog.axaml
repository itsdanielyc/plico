<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Plico.Desktop.SavedSearchDialog" Width="510" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource InterFont}" Background="#F4F5EF">
    <StackPanel Margin="24" Spacing="12">
        <StackPanel Spacing="5">
            <TextBlock Text="Name" FontWeight="SemiBold" />
            <TextBox x:Name="SavedNameBox" AutomationProperties.Name="Saved search name" />
        </StackPanel>
        <StackPanel Spacing="5">
            <TextBlock Text="Search" FontWeight="SemiBold" />
            <TextBox x:Name="SavedQueryBox" AutomationProperties.Name="Saved search query" />
            <TextBlock x:Name="SavedScope" TextWrapping="Wrap" FontSize="12" Foreground="#5C685D" />
        </StackPanel>
        <StackPanel Spacing="5">
            <TextBlock Text="Sort" FontWeight="SemiBold" />
            <ComboBox x:Name="SavedSortBox" HorizontalAlignment="Stretch" AutomationProperties.Name="Saved search order" />
        </StackPanel>
        <TextBlock x:Name="SavedSearchValidation" IsVisible="False" Foreground="#8E4037" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Button x:Name="RemoveSavedSearchButton" Content="Remove shortcut" Click="Remove_Click" Padding="14,7" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Padding="14,7" />
                <Button x:Name="ConfirmSavedSearchButton" Content="Save search" IsDefault="True" Click="Save_Click"
                        Padding="14,7" Background="#254C37" Foreground="White" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
