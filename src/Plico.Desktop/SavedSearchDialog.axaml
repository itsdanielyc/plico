<Window xmlns="https://github.com/avaloniaui"
        xmlns:translation="using:Plico.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Plico.Desktop.SavedSearchDialog" Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Classes="dialog">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button x:Name="RemoveSavedSearchButton" Classes="secondary" Content="{translation:Tr RemoveShortcut}" Click="Remove_Click" />
                <StackPanel Grid.Column="2" Classes="dialog-actions">
                    <Button Classes="secondary" Content="{translation:Tr Cancel}" IsCancel="True" Click="Cancel_Click" />
                    <Button x:Name="ConfirmSavedSearchButton" Classes="primary" Content="{translation:Tr SaveSearch}" IsDefault="True" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Classes="dialog-body">
            <TextBlock Classes="heading" Text="{Binding $parent[Window].Title}" />
            <StackPanel Classes="field">
                <TextBlock Classes="form-label" Text="{translation:Tr Name}" />
                <TextBox x:Name="SavedNameBox" AutomationProperties.Name="{translation:Tr SavedSearchName}" />
            </StackPanel>
            <StackPanel Classes="field">
                <TextBlock Classes="form-label" Text="{translation:Tr Search}" />
                <TextBox x:Name="SavedQueryBox" AutomationProperties.Name="{translation:Tr SavedSearchQuery}" />
                <TextBlock x:Name="SavedScope" Classes="hint" />
            </StackPanel>
            <StackPanel Classes="field">
                <TextBlock Classes="form-label" Text="{translation:Tr Sort}" />
                <ComboBox x:Name="SavedSortBox" HorizontalAlignment="Stretch" AutomationProperties.Name="{translation:Tr SavedSearchOrder}" />
            </StackPanel>
            <TextBlock x:Name="SavedSearchValidation" Classes="validation" IsVisible="False" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </DockPanel>
</Window>
