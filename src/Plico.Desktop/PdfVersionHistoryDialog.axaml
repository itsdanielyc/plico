<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Plico.Desktop" x:Class="Plico.Desktop.PdfVersionHistoryDialog" Title="PDF versions"
        Width="590" Height="390" MinWidth="540" MinHeight="290" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource InterFont}" Background="#F4F5EF">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12" Margin="24">
        <TextBlock x:Name="DocumentTitle" FontWeight="SemiBold" FontSize="18" TextTrimming="CharacterEllipsis" />
        <Panel Grid.Row="1">
            <ListBox x:Name="Versions" AutomationProperties.Name="Previous PDF versions"
                     Background="#FCFDF8" BorderBrush="#DDE2D7" BorderThickness="1" CornerRadius="8">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:PdfVersionRow">
                        <StackPanel Spacing="2" Margin="4">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}" Foreground="#5C685D" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyHistory" Text="No previous versions." IsHitTestVisible="False"
                       VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Panel>
        <WrapPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="6">
            <Button Content="Close" IsCancel="True" Click="Close_Click" />
            <Button Content="Add revised PDF…" Click="Replace_Click" />
            <Button x:Name="ExportVersion" Content="Export copy…" Click="Export_Click" />
            <Button x:Name="RestoreVersion" Content="Make current" Click="Restore_Click"
                    Background="#254C37" Foreground="White" />
        </WrapPanel>
    </Grid>
</Window>
