<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Plico's tokens. A grey desk, a white sheet, black ink: the window and the sidebar are Base, the work sits
        on a Panel sheet, and ink (Fg) is the only accent. Colour appears only for status and for meaning Plico
        already owns: amber search hits, tag dots, a green live watch and an orange due date.
        The family values are the contract in docs/design/miille.md, mirrored from Onda's tokens.css.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- The miille family. The same names and values in every miille app. -->
            <SolidColorBrush x:Key="Base" Color="#F3F3F4" /> <!-- the desk: window, title bar, sidebar -->
            <SolidColorBrush x:Key="Panel" Color="#FFFFFF" /> <!-- the sheet, cards, row groups -->
            <SolidColorBrush x:Key="Raised" Color="#FFFFFF" /> <!-- dialogs, menus, the palette, popovers -->
            <SolidColorBrush x:Key="Sunken" Color="#F5F5F6" /> <!-- wells, icon tiles, chips, selected rows -->
            <SolidColorBrush x:Key="Hover" Color="#0D0F0F10" /> <!-- pointer over a quiet control -->
            <SolidColorBrush x:Key="Pressed" Color="#170F0F10" /> <!-- a pressed quiet control -->
            <SolidColorBrush x:Key="Selected" Color="#FFFFFF" /> <!-- the current nav pill, the chosen segment -->
            <SolidColorBrush x:Key="Line" Color="#E2E2E5" /> <!-- hairlines -->
            <SolidColorBrush x:Key="LineStrong" Color="#CDCDD2" /> <!-- control borders -->
            <SolidColorBrush x:Key="Fg" Color="#0F0F10" /> <!-- text and ink fills -->
            <SolidColorBrush x:Key="Fg2" Color="#45454B" /> <!-- secondary text -->
            <SolidColorBrush x:Key="Fg3" Color="#66666D" /> <!-- the faintest meaningful text -->
            <SolidColorBrush x:Key="FgDisabled" Color="#9A9AA1" /> <!-- disabled text only -->
            <SolidColorBrush x:Key="OnFg" Color="#FFFFFF" /> <!-- text on ink -->
            <SolidColorBrush x:Key="Ok" Color="#16794A" />
            <SolidColorBrush x:Key="OkBg" Color="#E8F4ED" />
            <SolidColorBrush x:Key="Warn" Color="#8A5300" />
            <SolidColorBrush x:Key="WarnBg" Color="#FDF3E1" />
            <SolidColorBrush x:Key="Err" Color="#B42318" />
            <SolidColorBrush x:Key="ErrBg" Color="#FDECEB" />
            <SolidColorBrush x:Key="Scrim" Color="#520F0F10" /> <!-- behind dialogs and the palette -->
            <!-- The graphite tile, top to bottom. Brand moments only: never chrome, never a button. -->
            <LinearGradientBrush x:Key="Tile" StartPoint="50%,0%" EndPoint="50%,100%">
                <GradientStop Color="#262628" Offset="0" />
                <GradientStop Color="#0F0F10" Offset="0.55" />
                <GradientStop Color="#040404" Offset="1" />
            </LinearGradientBrush>
            <!-- Mixes resolved for Avalonia, which has no color-mix. -->
            <SolidColorBrush x:Key="PrimaryHover" Color="#313131" /> <!-- Fg mixed 86 % with Panel -->
            <SolidColorBrush x:Key="PrimaryPressed" Color="#444445" /> <!-- Fg mixed 78 % with Panel -->
            <SolidColorBrush x:Key="SecondaryHover" Color="#F6F6F6" /> <!-- Panel tinted 4 % towards Fg -->
            <SolidColorBrush x:Key="ControlBorderHover" Color="#949498" /> <!-- LineStrong mixed 30 % towards Fg -->
            <BoxShadows x:Key="ShadowPop">0 16 40 0 #290F0F10, 0 2 8 0 #140F0F10, 0 0 0 1 #140F0F10</BoxShadows>
            <BoxShadows x:Key="ShadowFieldFocus">0 0 0 1 #0F0F10</BoxShadows> <!-- the 1 px ring round a focused field -->
            <!-- A link is underlined in LineStrong, 3 px below the text. -->
            <TextDecorationCollection x:Key="LinkUnderline">
                <TextDecoration Location="Underline" Stroke="{StaticResource LineStrong}" StrokeThickness="1" StrokeThicknessUnit="Pixel"
                                StrokeOffset="3" StrokeOffsetUnit="Pixel" />
            </TextDecorationCollection>

            <!-- Plico's own surfaces. -->
            <SolidColorBrush x:Key="Desk" Color="#ECECEE" /> <!-- the page canvas, darker than Panel in both themes -->
            <SolidColorBrush x:Key="Paper" Color="#FFFFFF" /> <!-- the page itself, dimmed in the dark -->
            <SolidColorBrush x:Key="PrimaryKeySurface" Color="#26FFFFFF" /> <!-- a keycap inside a primary button -->
            <SolidColorBrush x:Key="TextSelection" Color="#2E0F0F10" /> <!-- selected text: ink at 18 % -->
            <!-- The rendered page is opaque, so dark mode dims it over the desk to about #E6E6E6, as Paper is. -->
            <x:Double x:Key="PageOpacity">1</x:Double>
            <!-- Meaning Plico already owns. These keep their values. -->
            <SolidColorBrush x:Key="HighlightSurface" Color="#FBE3A0" /> <!-- search hits -->
            <SolidColorBrush x:Key="HighlightInk" Color="#3D2C00" />
            <SolidColorBrush x:Key="PageHighlight" Color="#6BFFBE00" /> <!-- hits drawn on the page -->
            <SolidColorBrush x:Key="LiveInk" Color="#1E7F4F" /> <!-- a live watch -->
            <SolidColorBrush x:Key="WarningInk" Color="#9A5800" /> <!-- a reminder that is due -->
            <SolidColorBrush x:Key="RailTagMarker" Color="#8E8E96" /> <!-- the ring under a tag colour dot -->

            <!-- Earlier names, pointed at the family so existing windows follow it. New code uses the family names. -->
            <StaticResource x:Key="WorkspaceSurface" ResourceKey="Panel" />
            <StaticResource x:Key="SidebarSurface" ResourceKey="Base" />
            <StaticResource x:Key="DeskSurface" ResourceKey="Desk" />
            <StaticResource x:Key="RaisedSurface" ResourceKey="Panel" />
            <StaticResource x:Key="PopupSurface" ResourceKey="Raised" />
            <StaticResource x:Key="PaperSurface" ResourceKey="Paper" />
            <StaticResource x:Key="ScrimSurface" ResourceKey="Scrim" />
            <StaticResource x:Key="WorkspaceInk" ResourceKey="Fg" />
            <StaticResource x:Key="SecondaryInk" ResourceKey="Fg2" />
            <StaticResource x:Key="MutedInk" ResourceKey="Fg3" />
            <StaticResource x:Key="FaintInk" ResourceKey="FgDisabled" />
            <StaticResource x:Key="LineBrush" ResourceKey="Line" />
            <StaticResource x:Key="StrongLineBrush" ResourceKey="LineStrong" />
            <StaticResource x:Key="HoverFill" ResourceKey="Hover" />
            <StaticResource x:Key="SelectionSurface" ResourceKey="Sunken" />
            <StaticResource x:Key="PrimarySurface" ResourceKey="Fg" />
            <StaticResource x:Key="PrimaryInk" ResourceKey="OnFg" />
            <StaticResource x:Key="ErrorInk" ResourceKey="Err" />

            <!-- Fluent: ink replaces the system accent, and no Fluent grey or blue shows anywhere. -->
            <Color x:Key="SystemAccentColor">#0F0F10</Color>
            <Color x:Key="SystemAccentColorDark1">#313131</Color>
            <Color x:Key="SystemAccentColorDark2">#444445</Color>
            <Color x:Key="SystemAccentColorDark3">#575758</Color>
            <Color x:Key="SystemAccentColorLight1">#313131</Color>
            <Color x:Key="SystemAccentColorLight2">#444445</Color>
            <Color x:Key="SystemAccentColorLight3">#575758</Color>
            <Color x:Key="SystemErrorTextColor">#B42318</Color>
            <Color x:Key="ScrollBarThumbBackgroundColor">#CDCDD2</Color>
            <Color x:Key="ScrollBarPanningThumbBackgroundColor">#CDCDD2</Color>
            <Color x:Key="HyperlinkVisitedColor">#0F0F10</Color>
            <!-- Accent and system brushes. -->
            <StaticResource x:Key="SystemControlHighlightAccentBrush" ResourceKey="Fg" />
            <StaticResource x:Key="SystemControlBackgroundAccentBrush" ResourceKey="Fg" />
            <StaticResource x:Key="SystemControlForegroundAccentBrush" ResourceKey="Fg" />
            <StaticResource x:Key="SystemControlHighlightAltAccentBrush" ResourceKey="Fg" />
            <StaticResource x:Key="SystemControlDisabledAccentBrush" ResourceKey="FgDisabled" />
            <StaticResource x:Key="SystemControlHyperlinkTextBrush" ResourceKey="Fg" />
            <StaticResource x:Key="SystemControlHighlightListAccentLowBrush" ResourceKey="Sunken" />
            <StaticResource x:Key="SystemControlHighlightListAccentMediumBrush" ResourceKey="Sunken" />
            <StaticResource x:Key="SystemControlHighlightListAccentHighBrush" ResourceKey="Sunken" />
            <StaticResource x:Key="SystemControlHighlightAltListAccentLowBrush" ResourceKey="Sunken" />
            <StaticResource x:Key="SystemControlHighlightAltListAccentMediumBrush" ResourceKey="Sunken" />
            <StaticResource x:Key="SystemControlHighlightAltListAccentHighBrush" ResourceKey="Sunken" />
            <StaticResource x:Key="SystemControlHighlightListLowBrush" ResourceKey="Hover" />
            <StaticResource x:Key="SystemControlHighlightListMediumBrush" ResourceKey="Pressed" />
            <StaticResource x:Key="SystemControlBackgroundChromeMediumLowBrush" ResourceKey="Sunken" />
            <StaticResource x:Key="SystemControlTransientBackgroundBrush" ResourceKey="Raised" />
            <StaticResource x:Key="SystemControlTransientBorderBrush" ResourceKey="Line" />
            <StaticResource x:Key="SystemControlErrorTextForegroundBrush" ResourceKey="Err" />
            <StaticResource x:Key="SystemControlFocusVisualPrimaryBrush" ResourceKey="Fg" />
            <StaticResource x:Key="SystemControlFocusVisualSecondaryBrush" ResourceKey="Panel" />
            <StaticResource x:Key="TextControlSelectionHighlightColor" ResourceKey="TextSelection" />
            <!-- The neutral ramp Fluent draws text, borders and fills with. -->
            <StaticResource x:Key="SystemControlForegroundBaseHighBrush" ResourceKey="Fg" />
            <StaticResource x:Key="SystemControlHighlightBaseHighBrush" ResourceKey="Fg" />
            <StaticResource x:Key="SystemControlHighlightAltBaseHighBrush" ResourceKey="Fg" />
            <StaticResource x:Key="SystemControlPageTextBaseHighBrush" ResourceKey="Fg" />
            <StaticResource x:Key="SystemControlForegroundBaseMediumHighBrush" ResourceKey="Fg2" />
            <StaticResource x:Key="SystemControlForegroundBaseMediumBrush" ResourceKey="Fg3" />
            <StaticResource x:Key="SystemControlPageTextBaseMediumBrush" ResourceKey="Fg3" />
            <StaticResource x:Key="SystemControlDescriptionTextForegroundBrush" ResourceKey="Fg3" />
            <StaticResource x:Key="SystemControlDisabledBaseMediumLowBrush" ResourceKey="FgDisabled" />
            <StaticResource x:Key="SystemControlForegroundChromeDisabledLowBrush" ResourceKey="FgDisabled" />
            <StaticResource x:Key="SystemControlForegroundBaseLowBrush" ResourceKey="Line" />
            <StaticResource x:Key="SystemControlBackgroundBaseLowBrush" ResourceKey="Line" />
            <StaticResource x:Key="SystemControlBackgroundChromeMediumBrush" ResourceKey="Sunken" />
            <StaticResource x:Key="SystemControlBackgroundAltHighBrush" ResourceKey="Panel" />
            <StaticResource x:Key="SystemControlPageBackgroundAltHighBrush" ResourceKey="Panel" />
            <StaticResource x:Key="SystemControlBackgroundListLowBrush" ResourceKey="Hover" />
            <StaticResource x:Key="SystemControlBackgroundListMediumBrush" ResourceKey="Pressed" />
            <StaticResource x:Key="SystemRegionBrush" ResourceKey="Base" />
            <!-- Buttons without a class look like the secondary button. Disabled, they keep no fill or border, so the quiet buttons that clear their own background (rows, fields, the page bar) stay quiet while Plico is busy. -->
            <StaticResource x:Key="ButtonBackground" ResourceKey="Panel" />
            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SecondaryHover" />
            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="Sunken" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
            <StaticResource x:Key="ButtonForeground" ResourceKey="Fg" />
            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="Fg" />
            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="Fg" />
            <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="FgDisabled" />
            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="LineStrong" />
            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="ControlBorderHover" />
            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ControlBorderHover" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
            <StaticResource x:Key="RepeatButtonBackground" ResourceKey="Panel" />
            <StaticResource x:Key="RepeatButtonBackgroundPointerOver" ResourceKey="SecondaryHover" />
            <StaticResource x:Key="RepeatButtonBackgroundPressed" ResourceKey="Sunken" />
            <SolidColorBrush x:Key="RepeatButtonBackgroundDisabled" Color="Transparent" />
            <StaticResource x:Key="RepeatButtonForeground" ResourceKey="Fg2" />
            <StaticResource x:Key="RepeatButtonForegroundPointerOver" ResourceKey="Fg" />
            <StaticResource x:Key="RepeatButtonForegroundPressed" ResourceKey="Fg" />
            <StaticResource x:Key="RepeatButtonForegroundDisabled" ResourceKey="FgDisabled" />
            <StaticResource x:Key="RepeatButtonBorderBrush" ResourceKey="LineStrong" />
            <StaticResource x:Key="RepeatButtonBorderBrushPointerOver" ResourceKey="LineStrong" />
            <StaticResource x:Key="RepeatButtonBorderBrushPressed" ResourceKey="LineStrong" />
            <StaticResource x:Key="RepeatButtonBorderBrushDisabled" ResourceKey="Line" />
            <StaticResource x:Key="SplitButtonBackground" ResourceKey="Panel" />
            <StaticResource x:Key="SplitButtonBackgroundPointerOver" ResourceKey="SecondaryHover" />
            <StaticResource x:Key="SplitButtonBackgroundPressed" ResourceKey="Sunken" />
            <StaticResource x:Key="SplitButtonBackgroundDisabled" ResourceKey="Panel" />
            <StaticResource x:Key="SplitButtonBackgroundChecked" ResourceKey="Fg" />
            <StaticResource x:Key="SplitButtonBackgroundCheckedPointerOver" ResourceKey="PrimaryHover" />
            <StaticResource x:Key="SplitButtonBackgroundCheckedPressed" ResourceKey="PrimaryPressed" />
            <StaticResource x:Key="SplitButtonBackgroundCheckedDisabled" ResourceKey="Sunken" />
            <StaticResource x:Key="SplitButtonForeground" ResourceKey="Fg" />
            <StaticResource x:Key="SplitButtonForegroundPointerOver" ResourceKey="Fg" />
            <StaticResource x:Key="SplitButtonForegroundPressed" ResourceKey="Fg" />
            <StaticResource x:Key="SplitButtonForegroundDisabled" ResourceKey="FgDisabled" />
            <StaticResource x:Key="SplitButtonForegroundChecked" ResourceKey="OnFg" />
            <StaticResource x:Key="SplitButtonForegroundCheckedPointerOver" ResourceKey="OnFg" />
            <StaticResource x:Key="SplitButtonForegroundCheckedPressed" ResourceKey="OnFg" />
            <StaticResource x:Key="SplitButtonForegroundCheckedDisabled" ResourceKey="FgDisabled" />
            <StaticResource x:Key="SplitButtonBorderBrush" ResourceKey="LineStrong" />
            <StaticResource x:Key="SplitButtonBorderBrushPointerOver" ResourceKey="ControlBorderHover" />
            <StaticResource x:Key="SplitButtonBorderBrushPressed" ResourceKey="ControlBorderHover" />
            <StaticResource x:Key="SplitButtonBorderBrushDisabled" ResourceKey="Line" />
            <StaticResource x:Key="SplitButtonBorderBrushChecked" ResourceKey="Fg" />
            <StaticResource x:Key="SplitButtonBorderBrushCheckedPointerOver" ResourceKey="PrimaryHover" />
            <StaticResource x:Key="SplitButtonBorderBrushCheckedPressed" ResourceKey="PrimaryPressed" />
            <StaticResource x:Key="SplitButtonBorderBrushCheckedDisabled" ResourceKey="Line" />
            <!-- Accent buttons are primary buttons. -->
            <StaticResource x:Key="AccentButtonBackground" ResourceKey="Fg" />
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="PrimaryHover" />
            <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="PrimaryPressed" />
            <StaticResource x:Key="AccentButtonBackgroundDisabled" ResourceKey="Sunken" />
            <StaticResource x:Key="AccentButtonForeground" ResourceKey="OnFg" />
            <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="OnFg" />
            <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="OnFg" />
            <StaticResource x:Key="AccentButtonForegroundDisabled" ResourceKey="FgDisabled" />
            <StaticResource x:Key="AccentButtonBorderBrush" ResourceKey="Fg" />
            <StaticResource x:Key="AccentButtonBorderBrushPointerOver" ResourceKey="PrimaryHover" />
            <StaticResource x:Key="AccentButtonBorderBrushPressed" ResourceKey="PrimaryPressed" />
            <StaticResource x:Key="AccentButtonBorderBrushDisabled" ResourceKey="Line" />
            <!-- Toggle buttons: a checked toggle sits in the sunken well. -->
            <StaticResource x:Key="ToggleButtonBackground" ResourceKey="Panel" />
            <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SecondaryHover" />
            <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="Sunken" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
            <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="Sunken" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="Sunken" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="Sunken" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedDisabled" ResourceKey="Sunken" />
            <StaticResource x:Key="ToggleButtonBackgroundIndeterminate" ResourceKey="Sunken" />
            <StaticResource x:Key="ToggleButtonBackgroundIndeterminatePointerOver" ResourceKey="Sunken" />
            <StaticResource x:Key="ToggleButtonBackgroundIndeterminatePressed" ResourceKey="Sunken" />
            <StaticResource x:Key="ToggleButtonBackgroundIndeterminateDisabled" ResourceKey="Sunken" />
            <StaticResource x:Key="ToggleButtonForeground" ResourceKey="Fg" />
            <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="Fg" />
            <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="Fg" />
            <StaticResource x:Key="ToggleButtonForegroundDisabled" ResourceKey="FgDisabled" />
            <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="Fg" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="Fg" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="Fg" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedDisabled" ResourceKey="FgDisabled" />
            <StaticResource x:Key="ToggleButtonForegroundIndeterminate" ResourceKey="Fg" />
            <StaticResource x:Key="ToggleButtonForegroundIndeterminatePointerOver" ResourceKey="Fg" />
            <StaticResource x:Key="ToggleButtonForegroundIndeterminatePressed" ResourceKey="Fg" />
            <StaticResource x:Key="ToggleButtonForegroundIndeterminateDisabled" ResourceKey="FgDisabled" />
            <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="LineStrong" />
            <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="ControlBorderHover" />
            <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="ControlBorderHover" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="Transparent" />
            <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="LineStrong" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="ControlBorderHover" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="ControlBorderHover" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedDisabled" ResourceKey="Line" />
            <StaticResource x:Key="ToggleButtonBorderBrushIndeterminate" ResourceKey="LineStrong" />
            <StaticResource x:Key="ToggleButtonBorderBrushIndeterminatePointerOver" ResourceKey="ControlBorderHover" />
            <StaticResource x:Key="ToggleButtonBorderBrushIndeterminatePressed" ResourceKey="ControlBorderHover" />
            <StaticResource x:Key="ToggleButtonBorderBrushIndeterminateDisabled" ResourceKey="Line" />
            <!-- Check boxes: ink when checked, a strong outline when not. -->
            <StaticResource x:Key="CheckBoxForegroundUnchecked" ResourceKey="Fg" />
            <StaticResource x:Key="CheckBoxForegroundUncheckedPointerOver" ResourceKey="Fg" />
            <StaticResource x:Key="CheckBoxForegroundUncheckedPressed" ResourceKey="Fg" />
            <StaticResource x:Key="CheckBoxForegroundUncheckedDisabled" ResourceKey="FgDisabled" />
            <StaticResource x:Key="CheckBoxForegroundChecked" ResourceKey="Fg" />
            <StaticResource x:Key="CheckBoxForegroundCheckedPointerOver" ResourceKey="Fg" />
            <StaticResource x:Key="CheckBoxForegroundCheckedPressed" ResourceKey="Fg" />
            <StaticResource x:Key="CheckBoxForegroundCheckedDisabled" ResourceKey="FgDisabled" />
            <StaticResource x:Key="CheckBoxForegroundIndeterminate" ResourceKey="Fg" />
            <StaticResource x:Key="CheckBoxForegroundIndeterminatePointerOver" ResourceKey="Fg" />
            <StaticResource x:Key="CheckBoxForegroundIndeterminatePressed" ResourceKey="Fg" />
            <StaticResource x:Key="CheckBoxForegroundIndeterminateDisabled" ResourceKey="FgDisabled" />
            <SolidColorBrush x:Key="CheckBoxBackgroundUnchecked" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBackgroundUncheckedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBackgroundUncheckedPressed" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBackgroundUncheckedDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBackgroundChecked" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBackgroundCheckedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBackgroundCheckedPressed" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBackgroundCheckedDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBackgroundIndeterminate" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBackgroundIndeterminatePointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBackgroundIndeterminatePressed" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBackgroundIndeterminateDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBorderBrushUnchecked" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBorderBrushUncheckedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBorderBrushUncheckedPressed" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBorderBrushUncheckedDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBorderBrushChecked" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBorderBrushCheckedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBorderBrushCheckedPressed" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBorderBrushCheckedDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBorderBrushIndeterminate" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBorderBrushIndeterminatePointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBorderBrushIndeterminatePressed" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxBorderBrushIndeterminateDisabled" Color="Transparent" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillUnchecked" ResourceKey="Panel" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" ResourceKey="Panel" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" ResourceKey="Sunken" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillUncheckedDisabled" ResourceKey="Sunken" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUnchecked" ResourceKey="LineStrong" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" ResourceKey="ControlBorderHover" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" ResourceKey="ControlBorderHover" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedDisabled" ResourceKey="Line" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="Fg" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="PrimaryHover" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="PrimaryPressed" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedDisabled" ResourceKey="Sunken" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeChecked" ResourceKey="Fg" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" ResourceKey="PrimaryHover" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" ResourceKey="PrimaryPressed" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedDisabled" ResourceKey="Line" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="OnFg" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" ResourceKey="OnFg" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" ResourceKey="OnFg" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedDisabled" ResourceKey="FgDisabled" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillIndeterminate" ResourceKey="Fg" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillIndeterminatePointerOver" ResourceKey="PrimaryHover" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillIndeterminatePressed" ResourceKey="PrimaryPressed" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillIndeterminateDisabled" ResourceKey="Sunken" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeIndeterminate" ResourceKey="Fg" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePointerOver" ResourceKey="PrimaryHover" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePressed" ResourceKey="PrimaryPressed" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeIndeterminateDisabled" ResourceKey="Line" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminate" ResourceKey="OnFg" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminatePointerOver" ResourceKey="OnFg" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminatePressed" ResourceKey="OnFg" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminateDisabled" ResourceKey="FgDisabled" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundUnchecked" ResourceKey="OnFg" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundUncheckedPointerOver" ResourceKey="OnFg" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundUncheckedPressed" ResourceKey="OnFg" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundUncheckedDisabled" ResourceKey="FgDisabled" />
            <!-- Radio buttons follow the check boxes. -->
            <StaticResource x:Key="RadioButtonForeground" ResourceKey="Fg" />
            <StaticResource x:Key="RadioButtonForegroundPointerOver" ResourceKey="Fg" />
            <StaticResource x:Key="RadioButtonForegroundPressed" ResourceKey="Fg" />
            <StaticResource x:Key="RadioButtonForegroundDisabled" ResourceKey="FgDisabled" />
            <SolidColorBrush x:Key="RadioButtonBackground" Color="Transparent" />
            <SolidColorBrush x:Key="RadioButtonBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="RadioButtonBackgroundPressed" Color="Transparent" />
            <SolidColorBrush x:Key="RadioButtonBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="RadioButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="RadioButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="RadioButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="RadioButtonBorderBrushDisabled" Color="Transparent" />
            <StaticResource x:Key="RadioButtonOuterEllipseStroke" ResourceKey="LineStrong" />
            <StaticResource x:Key="RadioButtonOuterEllipseStrokePointerOver" ResourceKey="ControlBorderHover" />
            <StaticResource x:Key="RadioButtonOuterEllipseStrokePressed" ResourceKey="ControlBorderHover" />
            <StaticResource x:Key="RadioButtonOuterEllipseStrokeDisabled" ResourceKey="Line" />
            <StaticResource x:Key="RadioButtonOuterEllipseFill" ResourceKey="Panel" />
            <StaticResource x:Key="RadioButtonOuterEllipseFillPointerOver" ResourceKey="Panel" />
            <StaticResource x:Key="RadioButtonOuterEllipseFillPressed" ResourceKey="Sunken" />
            <StaticResource x:Key="RadioButtonOuterEllipseFillDisabled" ResourceKey="Sunken" />
