    </ResourceDictionary.ThemeDictionaries>

    <!-- Text on the graphite tile, the same in both themes. -->
    <SolidColorBrush x:Key="TileFg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TileFg2" Color="#CACAD0" />
    <SolidColorBrush x:Key="TileFg3" Color="#A3A3AA" />
    <SolidColorBrush x:Key="TileLine" Color="#24FFFFFF" />
    <LinearGradientBrush x:Key="LightTile" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F2F2F3" Offset="0.55" />
        <GradientStop Color="#DADADC" Offset="1" />
    </LinearGradientBrush>

    <!-- Shadows belong to things that float, and to paper. -->
    <BoxShadows x:Key="ShadowPaper">0 1 2 0 #1A000000, 0 8 22 0 #17000000</BoxShadows>
    <BoxShadows x:Key="ShadowSelected">0 1 2 0 #0D000000</BoxShadows>

    <!-- On hover the underline turns solid in the text colour. -->
    <TextDecorationCollection x:Key="LinkUnderlineHover">
        <TextDecoration Location="Underline" StrokeThickness="1" StrokeThicknessUnit="Pixel" StrokeOffset="3" StrokeOffsetUnit="Pixel" />
    </TextDecorationCollection>

    <!-- Geometry. -->
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusControl">10</CornerRadius>
    <CornerRadius x:Key="RadiusPopover">12</CornerRadius>
    <CornerRadius x:Key="RadiusToast">14</CornerRadius>
    <CornerRadius x:Key="RadiusCard">16</CornerRadius>
    <CornerRadius x:Key="RadiusDialog">18</CornerRadius>
    <CornerRadius x:Key="RadiusHero">22</CornerRadius>
    <CornerRadius x:Key="RadiusPaper">1.5</CornerRadius>

    <!-- Type. Inter is bundled through Avalonia.Fonts.Inter (static Regular, Medium, SemiBold and Bold faces). -->
    <FontFamily x:Key="InterFont">fonts:Inter#Inter, $Default</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, SF Mono, Menlo, DejaVu Sans Mono, Consolas, monospace</FontFamily>

    <!-- Fluent keys that are not colours. -->
    <FontFamily x:Key="ContentControlThemeFontFamily">fonts:Inter#Inter, $Default</FontFamily>
    <x:Double x:Key="ControlContentThemeFontSize">14</x:Double>
    <x:Double x:Key="ToolTipContentThemeFontSize">13</x:Double>
    <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
    <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
    <Thickness x:Key="MenuFlyoutPresenterThemePadding">4</Thickness>
    <!-- Focus is an ink ring with a 2 px gap: 2 px of Panel, then 2 px of Fg (FocusRing draws it with rounded corners). -->
    <Thickness x:Key="SystemControlFocusVisualPrimaryThickness">2</Thickness>
    <Thickness x:Key="SystemControlFocusVisualSecondaryThickness">2</Thickness>
    <Thickness x:Key="SystemControlFocusVisualMargin">-4</Thickness>
</ResourceDictionary>
