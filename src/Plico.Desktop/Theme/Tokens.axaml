        <ResourceDictionary x:Key="Dark">
            <!-- The miille family. The same names and values in every miille app. -->
            <SolidColorBrush x:Key="Base" Color="#0B0B0C" /> <!-- the desk: window, title bar, sidebar -->
            <SolidColorBrush x:Key="Panel" Color="#161618" /> <!-- the sheet, cards, row groups -->
            <SolidColorBrush x:Key="Raised" Color="#1C1C1F" /> <!-- dialogs, menus, the palette, popovers -->
            <SolidColorBrush x:Key="Sunken" Color="#1D1D20" /> <!-- wells, icon tiles, chips, selected rows -->
            <SolidColorBrush x:Key="Hover" Color="#0FFFFFFF" /> <!-- pointer over a quiet control -->
            <SolidColorBrush x:Key="Pressed" Color="#1AFFFFFF" /> <!-- a pressed quiet control -->
            <SolidColorBrush x:Key="Selected" Color="#1F1F22" /> <!-- the current nav pill, the chosen segment -->
            <SolidColorBrush x:Key="Line" Color="#2A2A2E" /> <!-- hairlines -->
            <SolidColorBrush x:Key="LineStrong" Color="#3B3B41" /> <!-- control borders -->
            <SolidColorBrush x:Key="Fg" Color="#F4F4F5" /> <!-- text and ink fills -->
            <SolidColorBrush x:Key="Fg2" Color="#C4C4CA" /> <!-- secondary text -->
            <SolidColorBrush x:Key="Fg3" Color="#9D9DA5" /> <!-- the faintest meaningful text -->
            <SolidColorBrush x:Key="FgDisabled" Color="#6A6A72" /> <!-- disabled text only -->
            <SolidColorBrush x:Key="OnFg" Color="#0F0F10" /> <!-- text on ink -->
            <SolidColorBrush x:Key="Ok" Color="#4CC98B" />
            <SolidColorBrush x:Key="OkBg" Color="#1F4CC98B" />
            <SolidColorBrush x:Key="Warn" Color="#F0B45A" />
            <SolidColorBrush x:Key="WarnBg" Color="#1FF0B45A" />
            <SolidColorBrush x:Key="Err" Color="#FF7B6E" />
            <SolidColorBrush x:Key="ErrBg" Color="#1FFF7B6E" />
            <SolidColorBrush x:Key="Scrim" Color="#8C000000" /> <!-- behind dialogs and the palette -->
            <!-- The graphite tile, top to bottom. Brand moments only: never chrome, never a button. -->
            <LinearGradientBrush x:Key="Tile" StartPoint="50%,0%" EndPoint="50%,100%">
                <GradientStop Color="#2C2C2F" Offset="0" />
                <GradientStop Color="#1A1A1C" Offset="0.6" />
                <GradientStop Color="#121214" Offset="1" />
            </LinearGradientBrush>
            <!-- Mixes resolved for Avalonia, which has no color-mix. -->
            <SolidColorBrush x:Key="PrimaryHover" Color="#D5D5D6" /> <!-- Fg mixed 86 % with Panel -->
            <SolidColorBrush x:Key="PrimaryPressed" Color="#C3C3C4" /> <!-- Fg mixed 78 % with Panel -->
            <SolidColorBrush x:Key="SecondaryHover" Color="#1F1F21" /> <!-- Panel tinted 4 % towards Fg -->
            <SolidColorBrush x:Key="ControlBorderHover" Color="#737377" /> <!-- LineStrong mixed 30 % towards Fg -->
            <BoxShadows x:Key="ShadowPop">0 18 44 0 #80000000, 0 0 0 1 #3B3B41</BoxShadows>
            <BoxShadows x:Key="ShadowFieldFocus">0 0 0 1 #F4F4F5</BoxShadows> <!-- the 1 px ring round a focused field -->
            <!-- A link is underlined in LineStrong, 3 px below the text. -->
            <TextDecorationCollection x:Key="LinkUnderline">
                <TextDecoration Location="Underline" Stroke="{StaticResource LineStrong}" StrokeThickness="1" StrokeThicknessUnit="Pixel"
                                StrokeOffset="3" StrokeOffsetUnit="Pixel" />
            </TextDecorationCollection>

            <!-- Plico's own surfaces. -->
            <SolidColorBrush x:Key="Desk" Color="#0F0F11" /> <!-- the page canvas, darker than Panel in both themes -->
            <SolidColorBrush x:Key="Paper" Color="#E6E6E6" /> <!-- the page itself, dimmed in the dark -->
            <SolidColorBrush x:Key="PrimaryKeySurface" Color="#1A000000" /> <!-- a keycap inside a primary button -->
            <SolidColorBrush x:Key="TextSelection" Color="#2EF4F4F5" /> <!-- selected text: ink at 18 % -->
            <!-- The rendered page is opaque, so dark mode dims it over the desk to about #E6E6E6, as Paper is. -->
            <x:Double x:Key="PageOpacity">0.895</x:Double>
            <!-- Meaning Plico already owns. These keep their values. -->
            <SolidColorBrush x:Key="HighlightSurface" Color="#5A4510" /> <!-- search hits -->
            <SolidColorBrush x:Key="HighlightInk" Color="#FFE9AE" />
            <SolidColorBrush x:Key="PageHighlight" Color="#80FFBE00" /> <!-- hits drawn on the page -->
            <SolidColorBrush x:Key="LiveInk" Color="#4CC38A" /> <!-- a live watch -->
            <SolidColorBrush x:Key="WarningInk" Color="#E2A24A" /> <!-- a reminder that is due -->
            <SolidColorBrush x:Key="RailTagMarker" Color="#75757D" /> <!-- the ring under a tag colour dot -->

            <!-- Earlier names, pointed at the family so existing windows follow it. New code uses the family names. -->
            <StaticResource x:Key="WorkspaceSurface" ResourceKey="Panel" />
            <StaticResource x:Key="SidebarSurface" ResourceKey="Base" />
            <StaticResource x:Key="DeskSurface" ResourceKey="Desk" />
            <StaticResource x:Key="RaisedSurface" ResourceKey="Panel" />
            <StaticResource x:Key="PopupSurface" ResourceKey="Raised" />
            <StaticResource x:Key="PaperSurface" ResourceKey="Paper" />
            <StaticResource x:Key="ScrimSurface" ResourceKey="Scrim" />
            <StaticResource x:Key="WorkspaceInk" ResourceKey="Fg" />
            <StaticResource x:Key="SecondaryInk" ResourceKey="Fg2" />
            <StaticResource x:Key="MutedInk" ResourceKey="Fg3" />
            <StaticResource x:Key="FaintInk" ResourceKey="FgDisabled" />
            <StaticResource x:Key="LineBrush" ResourceKey="Line" />
            <StaticResource x:Key="StrongLineBrush" ResourceKey="LineStrong" />
            <StaticResource x:Key="HoverFill" ResourceKey="Hover" />
            <StaticResource x:Key="SelectionSurface" ResourceKey="Sunken" />
            <StaticResource x:Key="PrimarySurface" ResourceKey="Fg" />
            <StaticResource x:Key="PrimaryInk" ResourceKey="OnFg" />
            <StaticResource x:Key="ErrorInk" ResourceKey="Err" />

            <!-- Fluent: ink replaces the system accent, and no Fluent grey or blue shows anywhere. -->
            <Color x:Key="SystemAccentColor">#F4F4F5</Color>
            <Color x:Key="SystemAccentColorDark1">#D5D5D6</Color>
            <Color x:Key="SystemAccentColorDark2">#C3C3C4</Color>
            <Color x:Key="SystemAccentColorDark3">#B1B1B2</Color>
            <Color x:Key="SystemAccentColorLight1">#D5D5D6</Color>
            <Color x:Key="SystemAccentColorLight2">#C3C3C4</Color>
            <Color x:Key="SystemAccentColorLight3">#B1B1B2</Color>
            <Color x:Key="SystemErrorTextColor">#FF7B6E</Color>
            <Color x:Key="ScrollBarThumbBackgroundColor">#3B3B41</Color>
            <Color x:Key="ScrollBarPanningThumbBackgroundColor">#3B3B41</Color>
            <Color x:Key="HyperlinkVisitedColor">#F4F4F5</Color>
            <!-- Accent and system brushes. -->
            <StaticResource x:Key="SystemControlHighlightAccentBrush" ResourceKey="Fg" />
            <StaticResource x:Key="SystemControlBackgroundAccentBrush" ResourceKey="Fg" />
            <StaticResource x:Key="SystemControlForegroundAccentBrush" ResourceKey="Fg" />
