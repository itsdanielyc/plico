<Window xmlns="https://github.com/avaloniaui"
        xmlns:translation="using:Plico.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Plico.Desktop.AppearanceDialog" Title="{translation:Tr Appearance}" Width="420" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner" FontFamily="{StaticResource InterFont}" Background="{DynamicResource WorkspaceSurface}">
    <StackPanel Margin="24" Spacing="10">
        <TextBlock Text="{translation:Tr Theme}" FontWeight="SemiBold" />
        <ComboBox x:Name="ThemeBox" HorizontalAlignment="Stretch" AutomationProperties.Name="{translation:Tr Theme}">
            <ComboBoxItem Content="{translation:Tr FollowSystem}" />
            <ComboBoxItem Content="{translation:Tr Light}" />
            <ComboBoxItem Content="{translation:Tr Dark}" />
        </ComboBox>
        <TextBlock Text="{translation:Tr InterfaceLanguage}" FontWeight="SemiBold" />
        <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch" AutomationProperties.Name="{translation:Tr InterfaceLanguage}">
            <ComboBoxItem Content="{translation:Tr FollowSystem}" />
            <ComboBoxItem Content="English" />
            <ComboBoxItem Content="Français" />
        </ComboBox>
        <TextBlock Text="{translation:Tr LanguageChangesTakeEffectWhenYouReopenPlico}" TextWrapping="Wrap" Foreground="{DynamicResource MutedInk}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{translation:Tr Cancel}" IsCancel="True" Click="Cancel_Click" />
            <Button x:Name="SaveAppearance" Content="{translation:Tr Save}" IsDefault="True" Click="Save_Click" Background="{DynamicResource PrimarySurface}" Foreground="White" />
        </StackPanel>
    </StackPanel>
</Window>
