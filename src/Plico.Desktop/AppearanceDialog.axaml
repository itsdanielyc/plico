<Window xmlns="https://github.com/avaloniaui"
        xmlns:translation="using:Plico.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Plico.Desktop.AppearanceDialog" Title="{translation:Tr Appearance}" Width="440" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner" Classes="dialog">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
            <StackPanel Classes="dialog-actions">
                <Button Classes="secondary" Content="{translation:Tr Cancel}" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="SaveAppearance" Classes="primary" Content="{translation:Tr Save}" IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </Border>
        <StackPanel Classes="dialog-body">
            <TextBlock Classes="heading" Text="{translation:Tr Appearance}" />
            <StackPanel Classes="field">
                <TextBlock Classes="form-label" Text="{translation:Tr Theme}" />
                <ComboBox x:Name="ThemeBox" HorizontalAlignment="Stretch" AutomationProperties.Name="{translation:Tr Theme}">
                    <ComboBoxItem Content="{translation:Tr FollowSystem}" />
                    <ComboBoxItem Content="{translation:Tr Light}" />
                    <ComboBoxItem Content="{translation:Tr Dark}" />
                </ComboBox>
            </StackPanel>
            <StackPanel Classes="field">
                <TextBlock Classes="form-label" Text="{translation:Tr InterfaceLanguage}" />
                <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch" AutomationProperties.Name="{translation:Tr InterfaceLanguage}">
                    <ComboBoxItem Content="{translation:Tr FollowSystem}" />
                    <ComboBoxItem Content="English" />
                    <ComboBoxItem Content="Français" />
                </ComboBox>
                <TextBlock Classes="hint" Text="{translation:Tr LanguageChangesTakeEffectWhenYouReopenPlico}" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
