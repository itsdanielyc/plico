<Window xmlns="https://github.com/avaloniaui"
        xmlns:translation="using:Plico.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Plico.Desktop" x:Class="Plico.Desktop.ImportErrorsDialog"
        Title="{translation:Tr ImportErrors}" Width="620" Height="384" MinWidth="420" MinHeight="290"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource InterFont}" Background="{DynamicResource WorkspaceSurface}">
    <Grid Margin="23" RowDefinitions="*,Auto" RowSpacing="14">
        <ListBox x:Name="FailuresList" Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource PanelOutline}" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{translation:Tr FilesWithImportErrors}">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="12" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:ImportFailure">
                    <StackPanel Spacing="5" ToolTip.Tip="{Binding SourcePath}">
                        <TextBlock Text="{Binding Filename}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Reason}" Foreground="{DynamicResource MutedInk}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Button Content="{translation:Tr ClearList}" Click="Clear_Click" Padding="13,7" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="{translation:Tr Close}" IsCancel="True" Click="Close_Click" Padding="13,7" />
                <Button Content="{translation:Tr RetryFiles}" Click="Retry_Click" Padding="13,7" Background="{DynamicResource PrimarySurface}" Foreground="White" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
