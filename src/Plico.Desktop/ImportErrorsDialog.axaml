<Window xmlns="https://github.com/avaloniaui"
        xmlns:translation="using:Plico.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Plico.Desktop" x:Class="Plico.Desktop.ImportErrorsDialog"
        Title="{translation:Tr ImportErrors}" Width="640" Height="460" MinWidth="440" MinHeight="340"
        WindowStartupLocation="CenterOwner" Classes="dialog">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button Classes="secondary" Content="{translation:Tr ClearList}" Click="Clear_Click" />
                <StackPanel Grid.Column="2" Classes="dialog-actions">
                    <Button Classes="secondary" Content="{translation:Tr Close}" IsCancel="True" Click="Close_Click" />
                    <Button Classes="primary" Content="{translation:Tr RetryFiles}" Click="Retry_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Classes="dialog-body" RowDefinitions="Auto,*" RowSpacing="14">
            <TextBlock Classes="heading" Text="{translation:Tr ImportErrors}" />
            <ListBox Grid.Row="1" x:Name="FailuresList" Classes="plain framed"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{translation:Tr FilesWithImportErrors}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:ImportFailure">
                        <StackPanel Spacing="3" ToolTip.Tip="{Binding SourcePath}">
                            <TextBlock Text="{Binding Filename}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{Binding Reason}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
