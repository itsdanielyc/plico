<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Plico.Desktop" x:Class="Plico.Desktop.ImportErrorsDialog"
        Title="Import errors" Width="620" Height="384" MinWidth="420" MinHeight="290"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource InterFont}" Background="#F4F5EF">
    <Grid Margin="23" RowDefinitions="*,Auto" RowSpacing="14">
        <ListBox x:Name="FailuresList" Background="#FCFDF8" BorderBrush="#DDE2D7" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Files with import errors">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="12" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:ImportFailure">
                    <StackPanel Spacing="5" ToolTip.Tip="{Binding SourcePath}">
                        <TextBlock Text="{Binding Filename}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Reason}" Foreground="#5C685D" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Button Content="Clear list" Click="Clear_Click" Padding="13,7" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Close" IsCancel="True" Click="Close_Click" Padding="13,7" />
                <Button Content="Retry files" Click="Retry_Click" Padding="13,7" Background="#254C37" Foreground="White" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
