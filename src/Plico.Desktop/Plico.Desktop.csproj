<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Plico</AssemblyName>
    <Product>Plico</Product>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon>Assets/plico.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/DesktopText.tsv" LogicalName="Plico.Desktop.InterfaceText" />
    <!-- The app icon from the Plico brand kit (icons/windows/plico.ico, 16 to 256 px). -->
    <AvaloniaResource Include="Assets/plico.ico" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="NAPS2.Pdfium.Binaries" />
    <PackageReference Include="NAPS2.Tesseract.Binaries" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <ProjectReference Include="../Plico.Core/Plico.Core.csproj" />
    <InternalsVisibleTo Include="Plico.Tests" />
  </ItemGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <MacScannerHelper>plico-mac-scanner</MacScannerHelper>
    <MacScannerArchitecture Condition="'$(RuntimeIdentifier)' == 'osx-x64'">x86_64</MacScannerArchitecture>
    <MacScannerArchitecture Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">arm64</MacScannerArchitecture>
    <MacScannerTarget Condition="'$(MacScannerArchitecture)' != ''">-target $(MacScannerArchitecture)-apple-macos12</MacScannerTarget>
  </PropertyGroup>
  <Target Name="BuildMacScannerHelper" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX'))"
          Inputs="$(MSBuildProjectDirectory)/Native/MacScanner.swift;$(MSBuildProjectFullPath)"
          Outputs="$(TargetDir)$(MacScannerHelper)">
    <Exec Command="xcrun swiftc -O $(MacScannerTarget) -framework ImageCaptureCore &quot;$(MSBuildProjectDirectory)/Native/MacScanner.swift&quot; -o &quot;$(TargetDir)$(MacScannerHelper)&quot;"
          EnvironmentVariables="MACOSX_DEPLOYMENT_TARGET=12.0" />
  </Target>
  <Target Name="PublishMacScannerHelper" AfterTargets="Publish" DependsOnTargets="BuildMacScannerHelper"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) and $(RuntimeIdentifier.StartsWith('osx-'))">
    <Copy SourceFiles="$(TargetDir)$(MacScannerHelper)" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
