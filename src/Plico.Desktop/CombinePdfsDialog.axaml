<Window xmlns="https://github.com/avaloniaui"
        xmlns:translation="using:Plico.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Plico.Core" x:Class="Plico.Desktop.CombinePdfsDialog" Title="{translation:Tr CombinePDFs}"
        Width="560" Height="540" MinWidth="460" MinHeight="420" WindowStartupLocation="CenterOwner" Classes="dialog">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
            <StackPanel Classes="dialog-actions">
                <Button Classes="secondary" Content="{translation:Tr Cancel}" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="ConfirmCombineButton" Classes="primary" Content="{translation:Tr CombinePDFs}" IsDefault="True" Click="Combine_Click" />
            </StackPanel>
        </Border>
        <Grid Classes="dialog-body" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
            <TextBlock Classes="heading" Text="{Binding $parent[Window].Title}" />
            <StackPanel Grid.Row="1" Classes="field">
                <TextBlock Classes="form-label" Text="{translation:Tr DocumentTitle}" />
                <TextBox x:Name="TitleBox" AutomationProperties.Name="{translation:Tr CombinedDocumentTitle}" />
            </StackPanel>
            <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="6">
                <TextBlock Classes="form-label" Text="{translation:Tr DocumentOrder}" />
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <ListBox x:Name="SourceList" Classes="plain framed" AutomationProperties.Name="{translation:Tr DocumentsInOutputOrder}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="core:DocumentSummary">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="caption" Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <Button x:Name="MoveUpButton" Classes="secondary" Content="{translation:Tr MoveUp}" Click="MoveUp_Click" HorizontalAlignment="Stretch" />
                        <Button x:Name="MoveDownButton" Classes="secondary" Content="{translation:Tr MoveDown}" Click="MoveDown_Click" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </Grid>
            <TextBlock Grid.Row="3" x:Name="ValidationMessage" Classes="validation" IsVisible="False"
                       AutomationProperties.LiveSetting="Polite" />
        </Grid>
    </DockPanel>
</Window>
