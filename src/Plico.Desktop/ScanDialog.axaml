<Window xmlns="https://github.com/avaloniaui"
        xmlns:translation="using:Plico.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Plico.Core" x:Class="Plico.Desktop.ScanDialog"
        Title="{translation:Tr ScanPaperwork}" Width="510" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource InterFont}" Background="{DynamicResource WorkspaceSurface}">
    <StackPanel Margin="24" Spacing="14">
        <TextBlock Text="{translation:Tr ScanPaperwork}" FontSize="24" FontWeight="SemiBold" AutomationProperties.HeadingLevel="1" />
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <ComboBox x:Name="DeviceBox" PlaceholderText="{translation:Tr ChooseAScanner}" HorizontalAlignment="Stretch"
                      SelectionChanged="Device_Changed" AutomationProperties.Name="{translation:Tr Scanner}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="core:ScannerDevice"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" x:Name="RefreshButton" Content="{translation:Tr Refresh}" Click="Refresh_Click" />
            <Button Grid.Column="2" x:Name="ForgetButton" Content="{translation:Tr Forget}" Click="Forget_Click" IsVisible="False"
                    AutomationProperties.Name="{translation:Tr ForgetSavedScannerAddress}" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="AddressBox" PlaceholderText="{translation:Tr ScannerAddressOptional}" MaxLength="512"
                     AutomationProperties.Name="{translation:Tr ScannerAddress}" KeyDown="Address_KeyDown" />
            <Button Grid.Column="1" x:Name="ConnectButton" Content="{translation:Tr Connect}" Click="Connect_Click" />
        </Grid>
        <Grid ColumnDefinitions="1.4*,*,*" ColumnSpacing="12">
            <StackPanel Spacing="5">
                <TextBlock Text="{translation:Tr PaperSource}" FontSize="12" />
                <ComboBox x:Name="SourceBox" HorizontalAlignment="Stretch" AutomationProperties.Name="{translation:Tr PaperSource}"
                          SelectionChanged="CaptureOptions_Changed" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="{translation:Tr PaperSize}" FontSize="12" />
                <ComboBox x:Name="PaperBox" HorizontalAlignment="Stretch" AutomationProperties.Name="{translation:Tr PaperSize}"
                          SelectionChanged="CaptureOptions_Changed" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="5">
                <TextBlock Text="{translation:Tr Resolution}" FontSize="12" />
                <ComboBox x:Name="ResolutionBox" HorizontalAlignment="Stretch" AutomationProperties.Name="{translation:Tr ScanResolution}"
                          SelectionChanged="CaptureOptions_Changed" />
            </StackPanel>
        </Grid>
        <Expander x:Name="ScanCleanupExpander" Header="{translation:Tr CleanupAndProfiles}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{translation:Tr ColourMode}" FontSize="12" />
                        <ComboBox x:Name="ScanColourBox" HorizontalAlignment="Stretch" AutomationProperties.Name="{translation:Tr ColourMode}"
                                  SelectionChanged="CaptureOptions_Changed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{translation:Tr Brightness}" FontSize="12" />
                        <NumericUpDown x:Name="ScanBrightness" Value="0" Minimum="-100" Maximum="100" Increment="5" FormatString="0"
                                       AutomationProperties.Name="{translation:Tr BrightnessAdjustment}" ValueChanged="CaptureOptions_Changed" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{translation:Tr Contrast}" FontSize="12" />
                        <NumericUpDown x:Name="ScanContrast" Value="0" Minimum="-100" Maximum="100" Increment="5" FormatString="0"
                                       AutomationProperties.Name="{translation:Tr ContrastAdjustment}" ValueChanged="CaptureOptions_Changed" />
                    </StackPanel>
                </Grid>
                <UniformGrid Columns="2">
                    <CheckBox x:Name="SkipBlankPages" Content="{translation:Tr SkipBlankPages}" IsCheckedChanged="CaptureOptions_Changed" />
                    <CheckBox x:Name="DeskewScan" Content="{translation:Tr StraightenPages}" IsCheckedChanged="CaptureOptions_Changed" />
                    <CheckBox x:Name="CropScan" Content="{translation:Tr CropToPageEdges}" IsCheckedChanged="CaptureOptions_Changed" />
                    <CheckBox x:Name="FlipScanBacks" Content="{translation:Tr FlipDuplexBacks}" IsCheckedChanged="CaptureOptions_Changed" />
                </UniformGrid>
                <StackPanel x:Name="ProfileControls" Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <ComboBox x:Name="ScanProfileBox" PlaceholderText="{translation:Tr ChooseASavedProfile}" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="{translation:Tr ScanProfile}" SelectionChanged="ScanProfile_Changed" />
                        <Button Grid.Column="1" x:Name="RemoveScanProfile" Content="{translation:Tr Remove}" Click="RemoveProfile_Click" IsEnabled="False" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="ScanProfileName" PlaceholderText="{translation:Tr ProfileName}" MaxLength="48" AutomationProperties.Name="{translation:Tr ProfileName}" />
                        <Button Grid.Column="1" x:Name="SaveScanProfile" Content="{translation:Tr SaveProfile}" Click="SaveProfile_Click" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Expander>
        <Expander Header="Batch separators" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="6">
                <CheckBox x:Name="SplitScanBatch" Content="Split at PATCH-T separator sheets" />
                <CheckBox x:Name="ReadArchiveSerials" Content="Read archive serial number labels" />
                <TextBox x:Name="CustomSeparatorBarcode" PlaceholderText="Additional separator barcode value (optional)"
                         AutomationProperties.Name="Additional separator barcode value" />
            </StackPanel>
        </Expander>
        <TextBlock x:Name="ScannerStatus" TextWrapping="Wrap" Foreground="{DynamicResource FaintInk}" FontSize="12"
                   AutomationProperties.LiveSetting="Polite" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{translation:Tr Cancel}" Click="Cancel_Click" IsCancel="True" Padding="14,7" />
            <Button x:Name="StartButton" Content="{translation:Tr ScanToInbox}" Click="Start_Click" IsDefault="True" IsEnabled="False"
                    Background="{DynamicResource PrimarySurface}" Foreground="White" Padding="14,7" />
        </StackPanel>
    </StackPanel>
</Window>
