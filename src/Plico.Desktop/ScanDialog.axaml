<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Plico.Core" x:Class="Plico.Desktop.ScanDialog"
        Title="Scan paperwork" Width="510" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource InterFont}" Background="#F4F5EF">
    <StackPanel Margin="24" Spacing="14">
        <TextBlock Text="Scan paperwork" FontSize="24" FontWeight="SemiBold" AutomationProperties.HeadingLevel="1" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ComboBox x:Name="DeviceBox" PlaceholderText="Choose a scanner" HorizontalAlignment="Stretch"
                      SelectionChanged="Device_Changed" AutomationProperties.Name="Scanner">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="core:ScannerDevice"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" />
        </Grid>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel Spacing="5">
                <TextBlock Text="Paper source" FontSize="12" />
                <ComboBox x:Name="SourceBox" HorizontalAlignment="Stretch" AutomationProperties.Name="Paper source" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="Paper size" FontSize="12" />
                <ComboBox x:Name="PaperBox" HorizontalAlignment="Stretch" AutomationProperties.Name="Paper size" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="ScannerStatus" TextWrapping="Wrap" Foreground="#526358" FontSize="12"
                   AutomationProperties.LiveSetting="Polite" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Click="Cancel_Click" IsCancel="True" Padding="14,7" />
            <Button x:Name="StartButton" Content="Scan to inbox" Click="Start_Click" IsDefault="True" IsEnabled="False"
                    Background="#254C37" Foreground="White" Padding="14,7" />
        </StackPanel>
    </StackPanel>
</Window>
