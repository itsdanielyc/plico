<Window xmlns="https://github.com/avaloniaui"
        xmlns:translation="using:Plico.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Plico.Core" x:Class="Plico.Desktop.ScanDialog"
        Title="{translation:Tr ScanPaperwork}" Width="540" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Classes="dialog">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
            <StackPanel Classes="dialog-actions">
                <Button Classes="secondary" Content="{translation:Tr Cancel}" Click="Cancel_Click" IsCancel="True" />
                <Button x:Name="StartButton" Classes="primary" Content="{translation:Tr ScanToInbox}" Click="Start_Click" IsDefault="True" IsEnabled="False" />
            </StackPanel>
        </Border>
        <StackPanel Classes="dialog-body">
            <TextBlock Classes="heading" Text="{translation:Tr ScanPaperwork}" AutomationProperties.HeadingLevel="1" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <ComboBox x:Name="DeviceBox" PlaceholderText="{translation:Tr ChooseAScanner}" HorizontalAlignment="Stretch"
                          SelectionChanged="Device_Changed" AutomationProperties.Name="{translation:Tr Scanner}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="core:ScannerDevice"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" x:Name="RefreshButton" Classes="secondary large" Content="{translation:Tr Refresh}" Click="Refresh_Click" />
                <Button Grid.Column="2" x:Name="ForgetButton" Classes="secondary large" Content="{translation:Tr Forget}" Click="Forget_Click" IsVisible="False"
                        AutomationProperties.Name="{translation:Tr ForgetSavedScannerAddress}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="AddressBox" PlaceholderText="{translation:Tr ScannerAddressOptional}" MaxLength="512"
                         AutomationProperties.Name="{translation:Tr ScannerAddress}" KeyDown="Address_KeyDown" />
                <Button Grid.Column="1" x:Name="ConnectButton" Classes="secondary large" Content="{translation:Tr Connect}" Click="Connect_Click" />
            </Grid>
            <Grid ColumnDefinitions="1.4*,*,*" ColumnSpacing="12">
                <StackPanel Classes="field">
                    <TextBlock Classes="form-label" Text="{translation:Tr PaperSource}" />
                    <ComboBox x:Name="SourceBox" HorizontalAlignment="Stretch" AutomationProperties.Name="{translation:Tr PaperSource}"
                              SelectionChanged="CaptureOptions_Changed" />
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="field">
                    <TextBlock Classes="form-label" Text="{translation:Tr PaperSize}" />
                    <ComboBox x:Name="PaperBox" HorizontalAlignment="Stretch" AutomationProperties.Name="{translation:Tr PaperSize}"
                              SelectionChanged="CaptureOptions_Changed" />
                </StackPanel>
                <StackPanel Grid.Column="2" Classes="field">
                    <TextBlock Classes="form-label" Text="{translation:Tr Resolution}" />
                    <ComboBox x:Name="ResolutionBox" HorizontalAlignment="Stretch" AutomationProperties.Name="{translation:Tr ScanResolution}"
                              SelectionChanged="CaptureOptions_Changed" />
                </StackPanel>
            </Grid>
            <Expander x:Name="ScanCleanupExpander" Header="{translation:Tr CleanupAndProfiles}" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <StackPanel Classes="field">
                            <TextBlock Classes="form-label" Text="{translation:Tr ColourMode}" />
                            <ComboBox x:Name="ScanColourBox" HorizontalAlignment="Stretch" AutomationProperties.Name="{translation:Tr ColourMode}"
                                      SelectionChanged="CaptureOptions_Changed" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Classes="field">
                            <TextBlock Classes="form-label" Text="{translation:Tr Brightness}" />
                            <NumericUpDown x:Name="ScanBrightness" Value="0" Minimum="-100" Maximum="100" Increment="5" FormatString="0"
                                           AutomationProperties.Name="{translation:Tr BrightnessAdjustment}" ValueChanged="CaptureOptions_Changed" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Classes="field">
                            <TextBlock Classes="form-label" Text="{translation:Tr Contrast}" />
                            <NumericUpDown x:Name="ScanContrast" Value="0" Minimum="-100" Maximum="100" Increment="5" FormatString="0"
                                           AutomationProperties.Name="{translation:Tr ContrastAdjustment}" ValueChanged="CaptureOptions_Changed" />
                        </StackPanel>
                    </Grid>
                    <UniformGrid Columns="2">
                        <CheckBox x:Name="SkipBlankPages" Content="{translation:Tr SkipBlankPages}" IsCheckedChanged="CaptureOptions_Changed" />
                        <CheckBox x:Name="DeskewScan" Content="{translation:Tr StraightenPages}" IsCheckedChanged="CaptureOptions_Changed" />
                        <CheckBox x:Name="CropScan" Content="{translation:Tr CropToPageEdges}" IsCheckedChanged="CaptureOptions_Changed" />
                        <CheckBox x:Name="FlipScanBacks" Content="{translation:Tr FlipDuplexBacks}" IsCheckedChanged="CaptureOptions_Changed" />
                    </UniformGrid>
                    <StackPanel x:Name="ProfileControls" Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <ComboBox x:Name="ScanProfileBox" PlaceholderText="{translation:Tr ChooseASavedProfile}" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="{translation:Tr ScanProfile}" SelectionChanged="ScanProfile_Changed" />
                            <Button Grid.Column="1" x:Name="RemoveScanProfile" Classes="secondary large" Content="{translation:Tr Remove}" Click="RemoveProfile_Click" IsEnabled="False" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="ScanProfileName" PlaceholderText="{translation:Tr ProfileName}" MaxLength="48" AutomationProperties.Name="{translation:Tr ProfileName}" />
                            <Button Grid.Column="1" x:Name="SaveScanProfile" Classes="secondary large" Content="{translation:Tr SaveProfile}" Click="SaveProfile_Click" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Expander>
            <Expander Header="{translation:Tr ScanBatchSeparators}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <CheckBox x:Name="SplitScanBatch" Content="{translation:Tr ScanPatchTSeparators}" />
                    <CheckBox x:Name="ReadArchiveSerials" Content="{translation:Tr ScanReadArchiveLabels}" />
                    <TextBox x:Name="CustomSeparatorBarcode" PlaceholderText="{translation:Tr ScanOptionalSeparator}"
                             AutomationProperties.Name="{translation:Tr ScanSeparatorBarcode}" />
                </StackPanel>
            </Expander>
            <TextBlock x:Name="ScannerStatus" Classes="hint" AutomationProperties.LiveSetting="Polite"
                       IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
    </DockPanel>
</Window>
