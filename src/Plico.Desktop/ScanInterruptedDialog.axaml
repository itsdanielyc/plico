<Window xmlns="https://github.com/avaloniaui"
        xmlns:translation="using:Plico.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Plico.Desktop.ScanInterruptedDialog" Title="{translation:Tr ScanInterrupted}" Width="500"
        SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner" Classes="dialog">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
            <StackPanel Classes="dialog-actions">
                <Button x:Name="DiscardPagesButton" Classes="secondary" Content="{translation:Tr Discard}" IsCancel="True" Click="Discard_Click" />
                <Button x:Name="SavePagesButton" Classes="primary" Content="{translation:Tr SavePartialPDF}" Click="Save_Click" />
            </StackPanel>
        </Border>
        <StackPanel Classes="dialog-body">
            <StackPanel Spacing="4">
                <TextBlock x:Name="CapturedPageMessage" Classes="heading" TextWrapping="Wrap" />
                <TextBlock x:Name="ScannerError" Classes="description" MaxLines="4" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Text="{translation:Tr SaveTheCapturedPagesToTheInbox}" TextWrapping="Wrap" />
        </StackPanel>
    </DockPanel>
</Window>
