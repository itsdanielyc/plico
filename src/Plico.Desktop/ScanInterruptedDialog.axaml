<Window xmlns="https://github.com/avaloniaui"
        xmlns:translation="using:Plico.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Plico.Desktop.ScanInterruptedDialog" Title="{translation:Tr ScanInterrupted}" Width="480"
        SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource InterFont}" Background="{DynamicResource WorkspaceSurface}">
    <StackPanel Margin="24" Spacing="13">
        <TextBlock x:Name="CapturedPageMessage" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="ScannerError" Foreground="{DynamicResource MutedInk}" TextWrapping="Wrap" MaxLines="4"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{translation:Tr SaveTheCapturedPagesToTheInbox}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="DiscardPagesButton" Content="{translation:Tr Discard}" IsCancel="True" Click="Discard_Click" Padding="14,7" />
            <Button x:Name="SavePagesButton" Content="{translation:Tr SavePartialPDF}" Click="Save_Click" Padding="14,7"
                    Background="{DynamicResource PrimarySurface}" Foreground="White" />
        </StackPanel>
    </StackPanel>
</Window>
