<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Plico.Desktop.ScanInterruptedDialog" Title="Scan interrupted" Width="480"
        SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource InterFont}" Background="#F4F5EF">
    <StackPanel Margin="24" Spacing="13">
        <TextBlock x:Name="CapturedPageMessage" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="ScannerError" Foreground="#5C685D" TextWrapping="Wrap" MaxLines="4"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="Save the captured pages to the inbox?" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="DiscardPagesButton" Content="Discard" IsCancel="True" Click="Discard_Click" Padding="14,7" />
            <Button x:Name="SavePagesButton" Content="Save partial PDF" Click="Save_Click" Padding="14,7"
                    Background="#254C37" Foreground="White" />
        </StackPanel>
    </StackPanel>
</Window>
