<Window xmlns="https://github.com/avaloniaui"
        xmlns:translation="using:Plico.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Plico.Desktop" x:Class="Plico.Desktop.PdfRedactionDialog" Title="{translation:Tr RedactPDF}"
        Width="700" Height="760" MinWidth="500" MinHeight="480" WindowStartupLocation="CenterOwner" Classes="dialog">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
            <StackPanel Classes="dialog-actions">
                <Button Classes="secondary" Content="{translation:Tr Cancel}" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="ConfirmRedactions" Classes="primary" Content="{translation:Tr ChooseDestination}" Click="Confirm_Click" IsEnabled="False" />
            </StackPanel>
        </Border>
        <Grid Classes="dialog-body" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
            <TextBlock Classes="heading" Text="{translation:Tr RedactPDF}" />
            <TextBlock Grid.Row="1" Classes="description" Text="{translation:Tr DrawABoxOverEachAreaToRemoveFromTheExportedPDF}" />
            <Border Grid.Row="2" Background="{DynamicResource Desk}" CornerRadius="{DynamicResource RadiusPopover}" ClipToBounds="True">
                <Panel Margin="8">
                    <local:PdfRedactionCanvas x:Name="PageCanvas" AutomationProperties.Name="{translation:Tr PDFPageForMarkingRedactions}" />
                    <TextBlock x:Name="PreviewNotice" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
            </Border>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6">
                <Button x:Name="PreviousPage" Classes="secondary" Content="‹" Click="Previous_Click" AutomationProperties.Name="{translation:Tr PreviousPage}" />
                <TextBlock x:Name="PageLabel" VerticalAlignment="Center" FontFeatures="+tnum" MinWidth="44" TextAlignment="Center" />
                <Button x:Name="NextPage" Classes="secondary" Content="›" Click="Next_Click" AutomationProperties.Name="{translation:Tr NextPage}" />
                <Button x:Name="UndoRegion" Classes="secondary" Content="{translation:Tr UndoBox}" Click="Undo_Click" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
