<Window xmlns="https://github.com/avaloniaui"
        xmlns:translation="using:Plico.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Plico.Desktop.PdfExportDialog" Title="{translation:Tr ExportPDF}" Width="460" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner" FontFamily="{StaticResource InterFont}" Background="{DynamicResource WorkspaceSurface}">
    <StackPanel Margin="24" Spacing="10">
        <TextBlock Text="{translation:Tr ExportPDF}" FontSize="19" FontWeight="SemiBold" />
        <ComboBox x:Name="PdfExportFormatBox" HorizontalAlignment="Stretch" AutomationProperties.Name="{translation:Tr PDFExportFormat}"
                  SelectionChanged="Format_Changed" />
        <TextBlock x:Name="PdfExportHint" TextWrapping="Wrap" />
        <StackPanel x:Name="PdfPasswordFields" Spacing="6" IsVisible="False">
            <TextBox x:Name="PdfPassword" PlaceholderText="{translation:Tr Password}" PasswordChar="●" MaxLength="127"
                     TextChanged="Password_Changed" AutomationProperties.Name="{translation:Tr PDFPassword}" />
            <TextBox x:Name="ConfirmPdfPassword" PlaceholderText="{translation:Tr RepeatPassword}" PasswordChar="●" MaxLength="127"
                     TextChanged="Password_Changed" AutomationProperties.Name="{translation:Tr RepeatPDFPassword}" />
        </StackPanel>
        <TextBlock x:Name="PdfExportError" TextWrapping="Wrap" Foreground="{DynamicResource ErrorInk}" AutomationProperties.LiveSetting="Polite" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{translation:Tr Cancel}" IsCancel="True" Click="Cancel_Click" />
            <Button x:Name="ConfirmPdfExportButton" Content="{translation:Tr ChooseFolder}" IsDefault="True" Click="Export_Click" />
        </StackPanel>
    </StackPanel>
</Window>
