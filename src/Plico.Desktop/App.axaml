<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Plico.Desktop.App"
             RequestedThemeVariant="Light">
    <!--
        A grey desk, a white sheet, black ink. The window and the sidebar are the desk, the work sits on a white
        sheet, and ink is the only accent. Paper stays the brightest object and the only in-flow thing with a
        shadow. Tokens live in Theme/Tokens.axaml, control styles in Theme/Controls.axaml. See DESIGN.md and
        docs/design/miille.md.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Theme/Tokens.axaml" />
                <ResourceInclude Source="/Theme/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Theme/Controls.axaml" />
    </Application.Styles>
</Application>
