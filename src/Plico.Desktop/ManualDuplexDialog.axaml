<Window xmlns="https://github.com/avaloniaui" xmlns:translation="using:Plico.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Plico.Desktop.ManualDuplexDialog" Title="{translation:Tr ManualDuplexWindow}" Width="540"
        SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner" Classes="dialog">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button x:Name="DiscardFrontsButton" Classes="secondary" Content="{translation:Tr DiscardFronts}" Click="Discard_Click" />
                <StackPanel Grid.Column="2" Classes="dialog-actions">
                    <Button x:Name="LaterButton" Classes="secondary" Content="{translation:Tr FinishLater}" IsCancel="True" Click="Later_Click" />
                    <Button x:Name="ScanBacksButton" Classes="primary" Content="{translation:Tr ScanBackSides}" IsDefault="True" Click="ScanBacks_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Classes="dialog-body">
            <StackPanel Spacing="4">
                <TextBlock Classes="heading" Text="{translation:Tr ScanBackSidesHeading}" TextWrapping="Wrap" />
                <TextBlock x:Name="FrontSidesMessage" Classes="description" />
            </StackPanel>
            <TextBlock Text="{translation:Tr ManualDuplexInstructions}" TextWrapping="Wrap" />
        </StackPanel>
    </DockPanel>
</Window>
