<Window xmlns="https://github.com/avaloniaui"
        xmlns:translation="using:Plico.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Plico.Desktop.PdfPageCopyDialog" Width="480" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner" Classes="dialog">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
            <StackPanel Classes="dialog-actions">
                <Button Classes="secondary" Content="{translation:Tr Cancel}" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="ConfirmPageCopyButton" Classes="primary" IsDefault="True" Click="Confirm_Click" />
            </StackPanel>
        </Border>
        <StackPanel Classes="dialog-body">
            <TextBlock Classes="heading" Text="{Binding $parent[Window].Title}" />
            <StackPanel Classes="field">
                <TextBlock Classes="form-label" Text="{translation:Tr Pages}" />
                <TextBox x:Name="PagesBox" AutomationProperties.Name="{translation:Tr SelectedPDFPages}" />
                <TextBlock x:Name="PageHint" Classes="hint" />
            </StackPanel>
            <StackPanel x:Name="RotationField" Classes="field" IsVisible="False">
                <TextBlock Classes="form-label" Text="{translation:Tr Rotation}" />
                <ComboBox x:Name="RotationBox" HorizontalAlignment="Stretch" AutomationProperties.Name="{translation:Tr PageRotation}" />
            </StackPanel>
            <StackPanel Classes="field">
                <TextBlock Classes="form-label" Text="{translation:Tr NewDocumentTitle}" />
                <TextBox x:Name="TitleBox" AutomationProperties.Name="{translation:Tr NewDocumentTitle}" />
            </StackPanel>
            <TextBlock x:Name="ValidationMessage" Classes="validation" IsVisible="False" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </DockPanel>
</Window>
